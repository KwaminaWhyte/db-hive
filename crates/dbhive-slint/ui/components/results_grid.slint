import { ListView } from "std-widgets.slint";
import { Theme, Icon, Icons, CheckBox } from "../kit/kit.slint";

// Virtualised results grid.
//
// ListView only instantiates the rows on screen, and the Rust side supplies
// rows through a lazy Model, so a 50,000 row result never materialises
// 50,000 row objects. Header and body share one horizontal Flickable so
// they scroll sideways together; the ListView owns vertical scrolling.

export struct GridColumn {
    title: string,
    // Left edge and width, precomputed in Rust so cells do not each sum the
    // widths of the columns before them.
    x: length,
    width: length,
}

export struct GridCell {
    text: string,
    is-null: bool,
    // The cell holds a pending, uncommitted edit.
    modified: bool,
    // A new row's column the user has not filled in: shown dim, as a hint,
    // because the database default will be used.
    placeholder: bool,
}

export struct GridRow {
    cells: [GridCell],
    // Marked for deletion, not yet committed.
    deleted: bool,
    // A new row, not yet inserted.
    added: bool,
    // Ticked in the checkbox column.
    checked: bool,
}

export component ResultsGrid inherits Rectangle {
    in property <[GridColumn]> columns;
    in property <[GridRow]> rows;
    // Sum of column widths. Named total-width to stay clear of Flickable's
    // own content-width.
    in property <length> total-width;
    in-out property <int> selected-row: -1;
    in property <length> row-height: 28px;
    in property <length> header-height: 32px;

    // The caller owns the selection (a table tab keeps it in Rust): clicks
    // are reported but `selected-row` is not assigned here, so a binding to
    // it survives. `selected-col` outlines one cell; -1 outlines none.
    in property <bool> controlled: false;
    in property <int> selected-col: -1;
    // Header arrow for a sorted column; -1 for none.
    in property <int> sort-column: -1;
    in property <bool> sort-desc: false;

    // Editing: the caller says which cell has a text box (-1 for none) and what
    // it starts with. Enter or leaving the box reports the text; Escape
    // cancels. The caller owns the state, as with the selection.
    in property <int> editing-row: -1;
    in property <int> editing-col: -1;
    in property <string> edit-initial;

    // A checkbox column at the left, for picking rows to act on together.
    // The caller owns which rows are ticked, as with the selection.
    in property <bool> selectable: false;
    in property <bool> all-checked: false;
    callback row-toggled(int);
    callback all-toggled;
    property <length> gutter: root.selectable ? 36px : 0px;

    callback row-clicked(int);
    callback cell-clicked(int, int);
    callback cell-double-clicked(int, int);
    callback edit-accepted(string);
    callback edit-cancelled;
    callback header-clicked(int);

    // Exposed so tests and snapshots can scroll without a pointer.
    in-out property <length> scroll-y <=> list.viewport-y;

    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    Flickable {
        content-width: max(self.width, root.total-width + root.gutter);
        content-height: self.height;

        VerticalLayout {
            width: max(parent.width, root.total-width + root.gutter);
            spacing: 0;

            // Header.
            Rectangle {
                height: root.header-height;
                background: Theme.sidebar;
                if root.selectable: Rectangle {
                    x: 0px;
                    width: root.gutter;
                    CheckBox {
                        x: 10px;
                        y: (parent.height - self.height) / 2;
                        checked: root.all-checked;
                        toggled => { root.all-toggled(); }
                        accessible-label: "Select all rows";
                    }
                }
                for col[index] in root.columns: TouchArea {
                    x: root.gutter + col.x;
                    width: col.width;
                    clicked => { root.header-clicked(index); }
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 4px;
                        alignment: start;
                        Text {
                            text: col.title;
                            color: index == root.sort-column ? Theme.foreground : Theme.muted-foreground;
                            font-size: Theme.size-small;
                            font-weight: 600;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        if index == root.sort-column: VerticalLayout {
                            alignment: center;
                            Icon {
                                source: root.sort-desc ? Icons.arrow-down : Icons.arrow-up;
                                tint: Theme.primary;
                                width: 12px;
                                height: 12px;
                            }
                        }
                    }
                }
                Rectangle {
                    y: parent.height - 1px;
                    height: 1px;
                    background: Theme.border;
                }
            }

            list := ListView {
                for row[r] in root.rows: Rectangle {
                    height: root.row-height;
                    // A deleted row keeps its red even while selected, so the
                    // pending delete is never mistaken for plain selection.
                    background: row.deleted ? Theme.destructive-soft
                        : r == root.selected-row ? Theme.primary-soft
                        : row.added ? Theme.success-soft
                        : row.checked ? Theme.primary-soft.transparentize(0.5)
                        : (mod(r, 2) == 0 ? transparent : Theme.hover.transparentize(0.5));
                    if root.selectable: Rectangle {
                        x: 0px;
                        width: root.gutter;
                        CheckBox {
                            x: 10px;
                            y: (parent.height - self.height) / 2;
                            checked: row.checked;
                            toggled => { root.row-toggled(r); }
                            accessible-label: "Select row";
                        }
                    }
                    for cell[c] in row.cells: TouchArea {
                        x: root.gutter + root.columns[c].x;
                        width: root.columns[c].width;
                        clicked => {
                            if (!root.controlled) {
                                root.selected-row = r;
                            }
                            root.row-clicked(r);
                            root.cell-clicked(r, c);
                        }
                        double-clicked => { root.cell-double-clicked(r, c); }
                        // A pending edit is tinted so it cannot be missed.
                        Rectangle {
                            background: cell.modified ? Theme.warning-soft : transparent;
                        }
                        // The selected cell, outlined within its selected row.
                        Rectangle {
                            border-width: r == root.selected-row && c == root.selected-col ? 1px : 0px;
                            border-color: Theme.primary;
                        }
                        if !(r == root.editing-row && c == root.editing-col): Text {
                            x: 12px;
                            width: parent.width - 20px;
                            text: cell.is-null ? "NULL" : cell.text;
                            color: cell.is-null || cell.placeholder || row.deleted ? Theme.dim-foreground : Theme.foreground;
                            font-italic: cell.is-null || cell.placeholder;
                            font-size: Theme.size-body;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        // The cell being edited: a text box over it. Enter or
                        // leaving the box commits the text to the pending
                        // changes; Escape drops it.
                        if r == root.editing-row && c == root.editing-col: edit-scope := FocusScope {
                            property <bool> finished: false;
                            capture-key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    self.finished = true;
                                    root.edit-cancelled();
                                    return accept;
                                }
                                return reject;
                            }
                            Rectangle {
                                background: Theme.card;
                                border-width: 2px;
                                border-color: Theme.primary;
                                edit-input := TextInput {
                                    x: 10px;
                                    width: parent.width - 20px;
                                    text: root.edit-initial;
                                    font-size: Theme.size-body;
                                    color: Theme.foreground;
                                    vertical-alignment: center;
                                    single-line: true;
                                    selection-background-color: Theme.primary.transparentize(0.65);
                                    selection-foreground-color: Theme.foreground;
                                    accessible-label: "Cell value";
                                    init => {
                                        self.focus();
                                        self.select-all();
                                    }
                                    accepted => {
                                        edit-scope.finished = true;
                                        root.edit-accepted(self.text);
                                    }
                                    changed has-focus => {
                                        if (!self.has-focus && !edit-scope.finished) {
                                            edit-scope.finished = true;
                                            root.edit-accepted(self.text);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
