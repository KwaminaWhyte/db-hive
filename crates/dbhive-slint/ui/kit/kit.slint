// DB Hive component kit.
//
// Every screen builds from these, so a button is a button everywhere and a
// change here restyles the app. Colours and sizes come only from the
// generated Theme global, never from literals, so light and dark both work.

import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { ScrollView, ListView } from "std-widgets.slint";

export { Theme, Icons }

export enum Tone { neutral, accent, success, warning, danger }

export enum ButtonVariant { primary, secondary, ghost, danger }

// A tinted icon. Lucide icons are single-colour line art, so colorize gives
// them any palette colour.
export component Icon inherits Image {
    in property <color> tint: Theme.muted-foreground;
    colorize: root.tint;
    width: 16px;
    height: 16px;
    image-fit: contain;
}

export component Button inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <ButtonVariant> variant: ButtonVariant.secondary;
    in property <bool> enabled: true;
    callback clicked;

    property <color> fg: root.variant == ButtonVariant.primary ? Theme.primary-foreground
        : root.variant == ButtonVariant.danger ? Theme.destructive
        : Theme.foreground;
    property <bool> hovered: touch.has-hover && root.enabled;
    property <bool> pressed: touch.pressed && root.enabled;

    min-height: 30px;
    // Buttons keep their natural size. Without this a layout with spare
    // room stretches them, and a header button became a slab.
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: Theme.radius-control;
    opacity: root.enabled ? 1 : 0.45;
    background: root.variant == ButtonVariant.primary
            ? (root.pressed ? Theme.primary.darker(0.12) : root.hovered ? Theme.primary.brighter(0.08) : Theme.primary)
        : root.variant == ButtonVariant.danger
            ? (root.hovered ? Theme.destructive-soft.brighter(0.2) : Theme.destructive-soft)
        : root.variant == ButtonVariant.ghost
            ? (root.pressed ? Theme.pressed : root.hovered ? Theme.hover : transparent)
        : (root.pressed ? Theme.pressed : root.hovered ? Theme.hover : Theme.secondary);
    border-width: root.variant == ButtonVariant.secondary || root.variant == ButtonVariant.danger ? 1px : 0;
    border-color: root.variant == ButtonVariant.danger ? Theme.destructive.transparentize(0.6)
        : root.hovered ? Theme.border-strong : Theme.border;
    animate background { duration: 90ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.enabled) {
            root.clicked();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: root.text == "" ? 8px : 12px;
        padding-right: root.text == "" ? 8px : 12px;
        padding-top: 5px;
        padding-bottom: 5px;
        spacing: 6px;
        alignment: center;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.fg;
                width: 15px;
                height: 15px;
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.size-label;
            font-weight: root.variant == ButtonVariant.primary ? 600 : 500;
            vertical-alignment: center;
        }
    }
}

export component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
}

// A card the whole of which can be clicked. The touch area sits beneath the
// content, so buttons inside the card still receive their own clicks.
export component ClickableCard inherits Rectangle {
    in property <bool> selected: false;
    callback clicked;

    border-radius: Theme.radius-card;
    border-width: root.selected ? 1.5px : 1px;
    background: root.selected ? Theme.primary-soft : touch.has-hover ? Theme.elevated : Theme.card;
    border-color: root.selected ? Theme.primary : touch.has-hover ? Theme.border-strong : Theme.border;
    animate background, border-color { duration: 110ms; }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    @children
}

// A flat list row: hover and selected fills, no border. Icon, label and the
// optional trailing detail share one vertical centre.
export component ListRow inherits Rectangle {
    in property <string> text;
    in property <string> detail;
    in property <image> icon;
    in property <bool> has-icon: true;
    in property <bool> selected: false;
    callback clicked;

    min-height: 30px;
    border-radius: Theme.radius-control;
    background: root.selected ? Theme.primary-soft : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: root.selected ? Theme.primary : Theme.muted-foreground;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.text;
            color: Theme.foreground;
            font-size: Theme.size-label;
            font-weight: root.selected ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.detail != "": Text {
            text: root.detail;
            color: Theme.dim-foreground;
            font-size: Theme.size-small;
            vertical-alignment: center;
        }
    }
}

export struct TabInfo {
    title: string,
    // A query tab shows the code icon, a table tab the table icon.
    query: bool,
    // The tab has a query in flight.
    busy: bool,
}

component TabChip inherits Rectangle {
    in property <TabInfo> info;
    in property <bool> active;
    callback selected;
    callback closed;

    width: 168px;
    background: root.active ? Theme.background : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }

    accessible-role: tab;
    accessible-label: root.info.title;
    accessible-action-default => { root.selected(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.selected(); }
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.info.query ? Icons.code : Icons.table;
                tint: root.active ? Theme.primary : Theme.muted-foreground;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.info.title;
            color: root.active ? Theme.foreground : Theme.muted-foreground;
            font-size: Theme.size-label;
            font-weight: root.active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.info.busy: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: Theme.primary;
            }
        }
        VerticalLayout {
            alignment: center;
            close := TouchArea {
                width: 20px;
                height: 20px;
                mouse-cursor: pointer;
                clicked => { root.closed(); }
                accessible-role: button;
                accessible-label: "Close " + root.info.title;
                Rectangle {
                    background: close.has-hover ? Theme.pressed : transparent;
                    border-radius: Theme.radius-control;
                    Icon {
                        source: Icons.x;
                        tint: Theme.dim-foreground;
                        width: 12px;
                        height: 12px;
                    }
                }
            }
        }
    }
    // The active tab is marked with the accent along its top edge.
    Rectangle {
        y: 0;
        height: 2px;
        background: root.active ? Theme.primary : transparent;
    }
}

// The row of open tabs, with a "+" at the end for a new one.
export component TabBar inherits Rectangle {
    in property <[TabInfo]> tabs;
    in property <int> active: -1;
    callback selected(int);
    callback closed(int);
    callback add;

    height: 38px;
    background: Theme.sidebar;

    HorizontalLayout {
        alignment: start;
        spacing: 0;
        for t[i] in root.tabs: TabChip {
            info: t;
            active: i == root.active;
            selected => { root.selected(i); }
            closed => { root.closed(i); }
        }
        VerticalLayout {
            alignment: center;
            padding-left: 6px;
            Button {
                has-icon: true;
                icon: Icons.plus;
                variant: ButtonVariant.ghost;
                accessible-label: "New query";
                clicked => { root.add(); }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// A row of colour swatches, one of which can be selected. The colours are
// user data (a profile's colour tag), not theme tokens, so the caller supplies
// them. `picked` sends the swatch index; picking the selected one again sends
// -1, which callers read as "no colour".
export component SwatchPicker inherits Rectangle {
    in property <[color]> options;
    in property <int> selected: -1;
    callback picked(int);

    height: 26px;
    horizontal-stretch: 1;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for c[i] in root.options: Rectangle {
            width: 24px;
            height: 24px;
            y: 1px;
            border-radius: 12px;
            background: c;
            border-width: touch.has-hover ? 2px : 0;
            border-color: Theme.foreground;
            accessible-role: button;
            accessible-label: "Colour " + (i + 1);
            accessible-action-default => { root.picked(i == root.selected ? -1 : i); }

            touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i == root.selected ? -1 : i); }
            }
            if i == root.selected: Icon {
                source: Icons.check;
                tint: Theme.primary-foreground;
                width: 14px;
                height: 14px;
            }
        }
    }
}

// The DB Hive brand block: app icon, wordmark with the "Hive" pill, tagline.
// The icon is a PNG with rounded, transparent corners baked in, so it reads
// the same on any background and under either renderer.
export component BrandMark inherits VerticalLayout {
    in property <length> icon-size: 120px;
    in property <string> tagline;
    alignment: center;
    spacing: 18px;

    HorizontalLayout {
        alignment: center;
        Image {
            source: @image-url("../assets/hive-mark.png");
            width: root.icon-size;
            height: root.icon-size;
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 8px;
        Text {
            text: "DB";
            color: Theme.foreground;
            font-size: Theme.size-display * 1.5;
            font-weight: 700;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Rectangle {
                background: Theme.foreground;
                border-radius: Theme.radius-control;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    Text {
                        text: "Hive";
                        color: Theme.background;
                        font-size: Theme.size-display * 1.2;
                        font-weight: 700;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    if root.tagline != "": Text {
        text: root.tagline;
        color: Theme.muted-foreground;
        font-size: Theme.size-body;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

// One key as printed on a keycap: "Ctrl", "Shift", "N", "Esc". Used for
// shortcut hints in the palette and the shortcuts help.
export component KeyCap inherits Rectangle {
    in property <string> text;

    height: 22px;
    min-width: 22px;
    horizontal-stretch: 0;
    background: Theme.secondary;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.border-strong;

    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            color: Theme.muted-foreground;
            font-size: Theme.size-small;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// A chord as a row of keycaps, packed to the right edge of its space.
export component KeyCaps inherits HorizontalLayout {
    in property <[string]> keys;
    spacing: 4px;
    alignment: end;
    for k in root.keys: VerticalLayout {
        alignment: center;
        KeyCap { text: k; }
    }
}

// The surface of a floating panel (command palette, shortcuts help): popover
// fill, strong border and a soft shadow. The shadow colour is derived from the
// theme background so it is dark in both themes without a literal.
export component Popover inherits Rectangle {
    background: Theme.popover;
    border-radius: Theme.radius-window;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: Theme.background.darker(8).transparentize(0.3);
    @children
}

export component Badge inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <bool> dot: false;
    // A badge that acts like a link (a foreign key that opens its table).
    in property <bool> clickable: false;
    callback clicked;

    property <color> fg: root.tone == Tone.accent ? Theme.primary
        : root.tone == Tone.success ? Theme.success
        : root.tone == Tone.warning ? Theme.warning
        : root.tone == Tone.danger ? Theme.destructive
        : Theme.muted-foreground;

    background: root.tone == Tone.accent ? Theme.primary-soft
        : root.tone == Tone.success ? Theme.success-soft
        : root.tone == Tone.warning ? Theme.warning-soft
        : root.tone == Tone.danger ? Theme.destructive-soft
        : Theme.secondary;
    border-radius: self.height / 2;
    horizontal-stretch: 0;
    border-width: root.clickable && badge-touch.has-hover ? 1px : 0px;
    border-color: root.fg;

    accessible-role: AccessibleRole.text;
    accessible-label: root.text;
    accessible-action-default => {
        if (root.clickable) {
            root.clicked();
        }
    }

    badge-touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 2px;
        padding-bottom: 2px;
        spacing: 5px;
        if root.dot: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.fg;
            }
        }
        Text {
            text: root.text;
            color: root.fg;
            font-size: Theme.size-small;
            vertical-alignment: center;
        }
    }
}

export component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <image> icon;
    in property <bool> has-icon: false;
    in property <bool> password: false;
    in property <bool> enabled: true;
    // A second, optional icon at the trailing edge that reacts to clicks,
    // for a password's show/hide eye without a second component.
    in property <image> trailing-icon;
    in property <bool> has-trailing-icon: false;
    callback edited(string);
    callback accepted(string);
    callback trailing-clicked;

    min-height: 32px;
    background: Theme.card;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: input.has-focus ? Theme.primary : Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    animate border-color { duration: 110ms; }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        if root.has-icon: VerticalLayout {
            alignment: center;
            Icon {
                source: root.icon;
                tint: Theme.dim-foreground;
                width: 14px;
                height: 14px;
            }
        }
        Rectangle {
            input := TextInput {
                // Slint centres an element with no explicit position inside
                // a plain Rectangle; pin it to the left edge.
                width: 100%;
                text <=> root.text;
                enabled: root.enabled;
                color: Theme.foreground;
                font-size: Theme.size-body;
                vertical-alignment: center;
                single-line: true;
                input-type: root.password ? InputType.password : InputType.text;
                selection-background-color: Theme.primary.transparentize(0.65);
                selection-foreground-color: Theme.foreground;
                edited => { root.edited(self.text); }
                accepted => { root.accepted(self.text); }
            }
            Text {
                width: 100%;
                horizontal-alignment: left;
                visible: root.text == "";
                text: root.placeholder;
                color: Theme.dim-foreground;
                font-size: Theme.size-body;
                vertical-alignment: center;
            }
        }
        if root.has-trailing-icon: TouchArea {
            width: 16px;
            mouse-cursor: pointer;
            clicked => { root.trailing-clicked(); }
            Icon {
                source: root.trailing-icon;
                tint: Theme.dim-foreground;
                width: 14px;
                height: 14px;
            }
        }
    }

    public function focus-input() {
        input.focus();
    }
}

// A field-styled picker. Options are just labels; the caller maps the
// selected index back to whatever type it means (a driver, an enum, ...),
// which keeps this component free of any domain type.
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <string> value;
    in property <bool> enabled: true;
    callback selected(int);

    min-height: 32px;
    background: Theme.card;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: area.has-hover && root.enabled ? Theme.border-strong : Theme.border;
    opacity: root.enabled ? 1 : 0.5;

    menu := ContextMenuArea {
        Menu {
            for opt[i] in root.options: MenuItem {
                title: opt;
                activated => { root.selected(i); }
            }
        }
    }

    area := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { menu.show({x: 0, y: root.height}); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.value;
            color: Theme.foreground;
            font-size: Theme.size-body;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        VerticalLayout {
            alignment: center;
            Icon { source: Icons.chevron-down; tint: Theme.dim-foreground; width: 13px; height: 13px; }
        }
    }
}

// A labelled on/off switch, used for form flags like "favourite".
export component Toggle inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;

    height: 20px;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.5;

    HorizontalLayout {
        spacing: 8px;
        TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.toggled(); }
            width: 34px;
            track := Rectangle {
                height: 20px;
                width: 34px;
                border-radius: 10px;
                background: root.checked ? Theme.primary : Theme.secondary;
                border-width: root.checked ? 0 : 1px;
                border-color: Theme.border-strong;
                animate background { duration: 110ms; }
                knob := Rectangle {
                    width: 16px;
                    height: 16px;
                    border-radius: 8px;
                    // Off, the knob is the muted foreground so it stays
                    // visible against the track in both themes.
                    background: root.checked ? Theme.primary-foreground : Theme.dim-foreground;
                    x: root.checked ? parent.width - self.width - 2px : 2px;
                    y: 2px;
                    animate x { duration: 110ms; }
                }
            }
        }
        if root.text != "": TouchArea {
            enabled: root.enabled;
            mouse-cursor: root.enabled ? pointer : default;
            clicked => { root.toggled(); }
            // A child of a TouchArea (not a layout) is centred at its implicit
            // size unless told otherwise; fill the area and left-align.
            Text {
                width: 100%;
                text: root.text;
                color: Theme.foreground;
                font-size: Theme.size-label;
                horizontal-alignment: left;
                vertical-alignment: center;
            }
        }
    }
}

export component Divider inherits Rectangle {
    height: 1px;
    background: Theme.border;
}

// A screen or dialog title, supporting text, and trailing actions.
export component ScreenHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    spacing: 12px;
    vertical-stretch: 0;
    HorizontalLayout {
        spacing: 12px;
        vertical-stretch: 0;
        VerticalLayout {
            spacing: 2px;
            alignment: center;
            Text {
                text: root.title;
                color: Theme.foreground;
                font-size: Theme.size-heading;
                font-weight: 700;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.muted-foreground;
                font-size: Theme.size-small;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                @children
            }
        }
    }
    Divider { }
}

export component SectionLabel inherits Text {
    // Space above, so a label reads as starting a new group rather than
    // captioning the row it sits under.
    vertical-alignment: bottom;
    min-height: 28px;
    color: Theme.muted-foreground;
    font-size: Theme.size-small;
    font-weight: 600;
    letter-spacing: 0.6px;
}

export component Banner inherits Rectangle {
    in property <string> message;
    in property <Tone> tone: Tone.danger;
    in property <bool> dismissible: true;
    callback dismissed;

    property <color> fg: root.tone == Tone.success ? Theme.success
        : root.tone == Tone.warning ? Theme.warning
        : root.tone == Tone.accent ? Theme.primary
        : root.tone == Tone.neutral ? Theme.muted-foreground
        : Theme.destructive;

    background: root.tone == Tone.success ? Theme.success-soft
        : root.tone == Tone.warning ? Theme.warning-soft
        : root.tone == Tone.accent ? Theme.primary-soft
        : root.tone == Tone.neutral ? Theme.secondary
        : Theme.destructive-soft;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.fg.transparentize(0.6);

    HorizontalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.tone == Tone.success ? Icons.circle-check
                    : root.tone == Tone.danger || root.tone == Tone.warning ? Icons.triangle-alert
                    : Icons.info;
                tint: root.fg;
            }
        }
        Text {
            text: root.message;
            color: root.fg;
            font-size: Theme.size-label;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if root.dismissible: TouchArea {
            width: 18px;
            mouse-cursor: pointer;
            clicked => { root.dismissed(); }
            Icon {
                source: Icons.x;
                tint: root.fg;
                width: 14px;
                height: 14px;
            }
        }
    }
}

// The centred "nothing here yet" state, with room for a call to action.
export component EmptyState inherits VerticalLayout {
    in property <image> icon;
    in property <string> title;
    in property <string> message;
    alignment: center;
    spacing: 6px;
    HorizontalLayout {
        alignment: center;
        Rectangle {
            width: 56px;
            height: 56px;
            border-radius: 28px;
            background: Theme.primary-soft;
            Icon {
                source: root.icon;
                tint: Theme.primary;
                width: 24px;
                height: 24px;
            }
        }
    }
    Rectangle { height: 8px; }
    Text {
        text: root.title;
        color: Theme.foreground;
        font-size: Theme.size-subheading;
        font-weight: 600;
        horizontal-alignment: center;
    }
    Text {
        text: root.message;
        color: Theme.muted-foreground;
        font-size: Theme.size-small;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Rectangle { height: 8px; }
    HorizontalLayout {
        alignment: center;
        @children
    }
}

// -- History / snippets / templates panel additions ---------------------------

// A flat two-line list row for records that need more than a label: a title,
// a dimmer line of facts under it, an optional error note, optional tag
// badges, an optional status dot, and trailing actions as children. Hover and
// selected fills, no border, like ListRow. A touch area sits beneath the
// content, so buttons placed as children still get their own clicks.
export component DetailRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    // Shown under the subtitle in the danger colour (an error message).
    in property <string> note;
    in property <[string]> tags;
    // A leading status dot: set `has-status`, then `status-tone`.
    in property <bool> has-status: false;
    in property <Tone> status-tone: Tone.success;
    // Titles that are code (a SQL statement) use the monospace face.
    in property <bool> mono-title: false;
    in property <bool> selected: false;
    callback clicked;
    callback double-clicked;

    min-height: 46px;
    border-radius: Theme.radius-control;
    background: root.selected ? Theme.primary-soft : touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }

    accessible-role: button;
    accessible-label: root.title;
    accessible-description: root.subtitle;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 10px;
        if root.has-status: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.status-tone == Tone.danger ? Theme.destructive
                    : root.status-tone == Tone.warning ? Theme.warning
                    : root.status-tone == Tone.accent ? Theme.primary
                    : root.status-tone == Tone.neutral ? Theme.dim-foreground
                    : Theme.success;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.title;
                    color: Theme.foreground;
                    font-size: root.mono-title ? Theme.size-mono : Theme.size-label;
                    font-family: root.mono-title ? "Menlo" : "";
                    font-weight: root.selected ? 600 : 400;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
                for tag in root.tags: VerticalLayout {
                    alignment: center;
                    Badge { text: tag; }
                }
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                color: Theme.muted-foreground;
                font-size: Theme.size-small;
                overflow: elide;
            }
            // An error message can be long: wrap to two lines, then elide.
            if root.note != "": Text {
                text: root.note;
                color: Theme.destructive;
                font-size: Theme.size-small;
                wrap: word-wrap;
                overflow: elide;
                max-height: 2 * Theme.size-small * 1.3;
            }
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                spacing: 4px;
                @children
            }
        }
    }
}

// Underlined text tabs, for switching between the panes of one panel. Unlike
// TabBar (document tabs with a close button) these are plain labels.
export component UnderlineTabs inherits Rectangle {
    in property <[string]> labels;
    in property <int> active: 0;
    callback selected(int);

    height: 36px;

    HorizontalLayout {
        alignment: start;
        spacing: 4px;
        for label[i] in root.labels: Rectangle {
            property <bool> on: i == root.active;
            width: tab-text.preferred-width + 24px;
            background: tab-touch.has-hover && !self.on ? Theme.hover : transparent;
            border-radius: Theme.radius-control;
            animate background { duration: 90ms; }

            accessible-role: tab;
            accessible-label: label;
            accessible-action-default => { root.selected(i); }

            tab-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.selected(i); }
            }
            tab-text := Text {
                text: label;
                color: parent.on ? Theme.foreground : Theme.muted-foreground;
                font-size: Theme.size-label;
                font-weight: parent.on ? 600 : 400;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            Rectangle {
                x: 12px;
                y: parent.height - 2px;
                width: parent.width - 24px;
                height: 2px;
                background: parent.on ? Theme.primary : transparent;
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }
}

// A small selectable pill, for filtering a list by tag or category.
export component FilterChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;

    height: 24px;
    width: label.preferred-width + 20px;
    horizontal-stretch: 0;
    border-radius: 12px;
    background: root.selected ? Theme.primary-soft : touch.has-hover ? Theme.hover : Theme.secondary;
    border-width: 1px;
    border-color: root.selected ? Theme.primary.transparentize(0.5) : Theme.border;
    animate background { duration: 90ms; }

    accessible-role: button;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.selected;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    label := Text {
        text: root.text;
        color: root.selected ? Theme.primary : Theme.muted-foreground;
        font-size: Theme.size-small;
        font-weight: root.selected ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// A small row of mutually exclusive choices ("Data | Structure"). The
// selected segment carries the soft accent fill, like a selected list row.
export component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> selected: 0;
    callback picked(int);

    height: 30px;
    horizontal-stretch: 0;
    background: Theme.secondary;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.border;

    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for opt[i] in root.options: Rectangle {
            border-radius: Theme.radius-control;
            background: i == root.selected ? Theme.primary-soft : seg.has-hover ? Theme.hover : transparent;
            animate background { duration: 90ms; }
            accessible-role: tab;
            accessible-label: opt;
            accessible-action-default => { root.picked(i); }

            seg := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.picked(i); }
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: opt;
                    color: i == root.selected ? Theme.foreground : Theme.muted-foreground;
                    font-size: Theme.size-label;
                    font-weight: i == root.selected ? 600 : 500;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// A flat table row for lists of records: optional hover and selected fills,
// no border. Put one HorizontalLayout inside it for the cells.
export component DataRow inherits Rectangle {
    in property <bool> clickable: false;
    in property <bool> selected: false;
    callback clicked;

    min-height: 32px;
    background: root.selected ? Theme.primary-soft
        : root.clickable && touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }

    touch := TouchArea {
        enabled: root.clickable;
        mouse-cursor: root.clickable ? pointer : default;
        clicked => { root.clicked(); }
    }
    @children
}

// A panel docked to the side of a view: a title with a close button over
// scrolling content, with a hairline on its leading edge.
export component SidePanel inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    callback close;

    background: Theme.card;

    VerticalLayout {
        spacing: 0;
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 8px;
            padding-top: 8px;
            padding-bottom: 8px;
            spacing: 8px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.title;
                    color: Theme.foreground;
                    font-size: Theme.size-label;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.subtitle != "": Text {
                    text: root.subtitle;
                    color: Theme.muted-foreground;
                    font-size: Theme.size-small;
                    overflow: elide;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    has-icon: true;
                    icon: Icons.x;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Close panel";
                    clicked => { root.close(); }
                }
            }
        }
        Divider { }
        VerticalLayout {
            vertical-stretch: 1;
            @children
        }
    }
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }
}

// Puts text on the system clipboard. Slint has no clipboard call for app
// code, but a TextInput copies its selection through the platform's own
// clipboard, so this keeps one that is never drawn, fills it and copies.
export component ClipboardSink inherits Rectangle {
    width: 0px;
    height: 0px;

    public function copy-text(text: string) {
        holder.text = text;
        holder.select-all();
        holder.copy();
    }

    holder := TextInput {
        single-line: false;
        visible: false;
        width: 0px;
        height: 0px;
    }
}

export component VDivider inherits Rectangle {
    width: 1px;
    background: Theme.border;
}

// One setting in a form: its name and help text on the left, the control on
// the right (the children). The error line sits under the text and turns the
// row's help red, so a bad value is next to the box that holds it. Rows stack
// inside a Card; `last` drops the divider under the final one.
export component SettingRow inherits VerticalLayout {
    in property <string> title;
    in property <string> description;
    in property <string> error;
    in property <bool> last: false;
    in property <length> min-control-width: 0px;
    spacing: 0;
    vertical-stretch: 0;

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                color: Theme.foreground;
                font-size: Theme.size-label;
                font-weight: 600;
                wrap: word-wrap;
            }
            if root.description != "": Text {
                text: root.description;
                color: Theme.muted-foreground;
                font-size: Theme.size-small;
                wrap: word-wrap;
            }
            if root.error != "": Text {
                text: root.error;
                color: Theme.destructive;
                font-size: Theme.size-small;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            min-width: root.min-control-width;
            alignment: center;
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                @children
            }
        }
    }
    if !root.last: Divider { }
}

// -- Import / export and backup additions ---------------------------------

// The numbered steps of a wizard. Steps before the current one show a check;
// steps up to `reachable` can be jumped to (backwards, or to a step whose
// input already exists). `locked` freezes the bar while work is running.
export component StepBar inherits Rectangle {
    in property <[string]> labels;
    in property <int> current: 0;
    in property <int> reachable: 0;
    in property <bool> locked: false;
    callback picked(int);

    height: 34px;

    HorizontalLayout {
        alignment: start;
        spacing: 2px;
        for label[i] in root.labels: Rectangle {
            property <bool> on: i == root.current;
            property <bool> done: i < root.current;
            property <bool> can: !root.locked && i <= root.reachable && i != root.current;
            width: step-row.preferred-width;
            border-radius: Theme.radius-control;
            background: self.on ? Theme.primary-soft : step-touch.has-hover && self.can ? Theme.hover : transparent;
            animate background { duration: 90ms; }

            accessible-role: tab;
            accessible-label: "Step " + (i + 1) + ", " + label;
            accessible-action-default => {
                if (self.can) {
                    root.picked(i);
                }
            }

            step-touch := TouchArea {
                enabled: parent.can;
                mouse-cursor: parent.can ? pointer : default;
                clicked => { root.picked(i); }
            }
            step-row := HorizontalLayout {
                padding-left: 8px;
                padding-right: 10px;
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 9px;
                        background: i == root.current ? Theme.primary : transparent;
                        border-width: i == root.current ? 0px : 1px;
                        border-color: i < root.current ? Theme.primary : Theme.border-strong;
                        if i < root.current: Icon {
                            source: Icons.check;
                            tint: Theme.primary;
                            width: 12px;
                            height: 12px;
                        }
                        if i >= root.current: Text {
                            text: i + 1;
                            color: i == root.current ? Theme.primary-foreground : Theme.dim-foreground;
                            font-size: Theme.size-small;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                Text {
                    text: label;
                    color: i == root.current ? Theme.foreground : i < root.current ? Theme.muted-foreground : Theme.dim-foreground;
                    font-size: Theme.size-label;
                    font-weight: i == root.current ? 600 : 400;
                    vertical-alignment: center;
                }
            }
        }
    }
}

// A horizontal progress bar. With `indeterminate` a short segment sweeps
// across, for work that reports no fraction.
export component ProgressBar inherits Rectangle {
    in property <float> value: 0;
    in property <bool> indeterminate: false;
    in property <Tone> tone: Tone.accent;

    height: 6px;
    border-radius: 3px;
    background: Theme.secondary;
    clip: true;

    accessible-role: progress-indicator;
    accessible-value: root.indeterminate ? "Working" : round(root.value * 100) + "%";

    Rectangle {
        height: parent.height;
        border-radius: 3px;
        background: root.tone == Tone.danger ? Theme.destructive
            : root.tone == Tone.success ? Theme.success
            : root.tone == Tone.warning ? Theme.warning
            : Theme.primary;
        width: root.indeterminate ? parent.width * 0.3 : parent.width * clamp(root.value, 0, 1);
        x: root.indeterminate ? (parent.width + self.width) * mod(animation-tick() / 1.4s, 1) - self.width : 0px;
        animate width { duration: 180ms; easing: ease-out; }
    }
}

// A statement or path shown verbatim in the monospace face, in a framed box.
// Long text wraps, then is cut after `max-lines`.
export component CodeBlock inherits Rectangle {
    in property <string> text;
    in property <Tone> tone: Tone.neutral;
    in property <int> max-lines: 4;

    background: root.tone == Tone.danger ? Theme.destructive-soft : Theme.card;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.tone == Tone.danger ? Theme.destructive.transparentize(0.6) : Theme.border;

    VerticalLayout {
        padding: 8px;
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: root.text;
            color: root.tone == Tone.danger ? Theme.destructive : Theme.foreground;
            font-size: Theme.size-mono;
            font-family: "Menlo";
            wrap: word-wrap;
            overflow: elide;
            height: min(self.preferred-height, root.max-lines * Theme.size-mono * 1.45);
        }
    }
}

// A form field: a bold label, the control (the children), then a hint and,
// in the danger colour, the error that belongs to this field.
export component FormField inherits VerticalLayout {
    in property <string> label;
    in property <string> hint;
    in property <string> error;
    spacing: 4px;
    vertical-stretch: 0;

    if root.label != "": Text {
        text: root.label;
        color: Theme.foreground;
        font-size: Theme.size-label;
        font-weight: 600;
    }
    @children
    if root.hint != "": Text {
        text: root.hint;
        color: Theme.muted-foreground;
        font-size: Theme.size-small;
        wrap: word-wrap;
    }
    if root.error != "": Text {
        text: root.error;
        color: Theme.destructive;
        font-size: Theme.size-small;
        wrap: word-wrap;
    }
}

// One fact in a summary: a dim label on the left at a fixed width, the value
// beside it. Long values wrap.
export component FactRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> mono: false;
    in property <length> label-width: 96px;
    spacing: 12px;
    vertical-stretch: 0;

    Text {
        width: root.label-width;
        text: root.label;
        color: Theme.muted-foreground;
        font-size: Theme.size-small;
        vertical-alignment: top;
    }
    Text {
        horizontal-stretch: 1;
        text: root.value;
        color: Theme.foreground;
        font-size: root.mono ? Theme.size-mono : Theme.size-label;
        font-family: root.mono ? "Menlo" : "";
        wrap: word-wrap;
    }
}

// -- Activity monitor and migrations additions ---------------------------------

// One series of a LineChart. `commands` and `area` are SVG path data written
// by Rust in a 1000 by 1000 space (see dbhive_ui_model::activity_panel), so
// the chart does not care how big it is drawn.
export struct ChartLine {
    name: string,
    commands: string,
    area: string,
    // Newest value, for the legend.
    last: string,
    tone: Tone,
}

// A line chart: a legend, three gridlines, one path per series and the two
// ends of the time axis. Data and labels come from Rust; this only draws.
// Each Path is sized to its own box and its viewbox pinned to the 1000 unit
// space, or Slint scales the path to the bounding box of its points.
export component LineChart inherits Rectangle {
    in property <[ChartLine]> lines;
    in property <string> y-top;
    in property <string> y-mid;
    in property <string> x-start;
    in property <string> x-end;
    // Shown instead of the plot when there is nothing to draw.
    in property <string> empty-message: "Collecting samples…";
    in property <length> plot-height: 120px;

    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;

    pure function tone-color(t: Tone) -> color {
        return t == Tone.accent ? Theme.primary
            : t == Tone.success ? Theme.success
            : t == Tone.warning ? Theme.warning
            : t == Tone.danger ? Theme.destructive
            : Theme.muted-foreground;
    }

    accessible-role: AccessibleRole.text;
    accessible-label: root.lines.length == 0 ? root.empty-message : "Chart";

    VerticalLayout {
        padding: 12px;
        padding-bottom: 8px;
        spacing: 8px;

        // Legend.
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            for line in root.lines: HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: root.tone-color(line.tone);
                    }
                }
                Text {
                    text: line.name;
                    color: Theme.muted-foreground;
                    font-size: Theme.size-small;
                    vertical-alignment: center;
                }
                Text {
                    text: line.last;
                    color: Theme.foreground;
                    font-size: Theme.size-small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }

        if root.lines.length == 0: Text {
            vertical-stretch: 1;
            min-height: root.plot-height;
            text: root.empty-message;
            color: Theme.dim-foreground;
            font-size: Theme.size-label;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.lines.length > 0: HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            // Y axis labels, top and middle gridline.
            Rectangle {
                width: 32px;
                min-height: root.plot-height;
                Text {
                    y: 0;
                    width: parent.width;
                    text: root.y-top;
                    color: Theme.dim-foreground;
                    font-size: Theme.size-small;
                    horizontal-alignment: right;
                }
                Text {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    text: root.y-mid;
                    color: Theme.dim-foreground;
                    font-size: Theme.size-small;
                    horizontal-alignment: right;
                }
                Text {
                    y: parent.height - self.height;
                    width: parent.width;
                    text: "0";
                    color: Theme.dim-foreground;
                    font-size: Theme.size-small;
                    horizontal-alignment: right;
                }
            }

            plot := Rectangle {
                horizontal-stretch: 1;
                min-height: root.plot-height;
                clip: true;

                Rectangle { y: 0; height: 1px; background: Theme.border; }
                Rectangle { y: (parent.height - 1px) / 2; height: 1px; background: Theme.border; }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-strong; }

                for line in root.lines: Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    fit: fill;
                    commands: line.area;
                    fill: root.tone-color(line.tone).transparentize(0.88);
                    stroke: transparent;
                    stroke-width: 0px;
                }
                for line in root.lines: Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    fit: fill;
                    commands: line.commands;
                    stroke: root.tone-color(line.tone);
                    stroke-width: 2px;
                    stroke-line-join: round;
                    stroke-line-cap: round;
                }
            }
        }

        if root.lines.length > 0: HorizontalLayout {
            padding-left: 40px;
            Text {
                text: root.x-start;
                color: Theme.dim-foreground;
                font-size: Theme.size-small;
                horizontal-stretch: 1;
            }
            Text {
                text: root.x-end;
                color: Theme.dim-foreground;
                font-size: Theme.size-small;
                horizontal-alignment: right;
                horizontal-stretch: 1;
            }
        }
    }
}

// A number with a caption, for the row of figures over a table or chart.
export component StatTile inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <Tone> tone: Tone.neutral;

    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    min-width: 96px;

    accessible-role: AccessibleRole.text;
    accessible-label: root.label + ": " + root.value;

    VerticalLayout {
        padding: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 2px;
        alignment: center;
        Text {
            text: root.label;
            color: Theme.muted-foreground;
            font-size: Theme.size-small;
            overflow: elide;
        }
        Text {
            text: root.value;
            color: root.tone == Tone.accent ? Theme.primary
                : root.tone == Tone.success ? Theme.success
                : root.tone == Tone.warning ? Theme.warning
                : root.tone == Tone.danger ? Theme.destructive
                : Theme.foreground;
            font-size: Theme.size-heading;
            font-weight: 600;
            overflow: elide;
        }
    }
}

// One row of a breakdown: a name, a bar showing its share, and a figure.
export component MeterRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    // 0 to 1.
    in property <float> fraction: 0;
    in property <Tone> tone: Tone.accent;

    height: 22px;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label + ": " + root.value;

    HorizontalLayout {
        spacing: 10px;
        Text {
            width: 84px;
            text: root.label;
            color: Theme.foreground;
            font-size: Theme.size-label;
            vertical-alignment: center;
            overflow: elide;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            track := Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.secondary;
                Rectangle {
                    x: 0;
                    width: max(0.0, min(1.0, root.fraction)) * track.width;
                    border-radius: 3px;
                    background: root.tone == Tone.success ? Theme.success
                        : root.tone == Tone.warning ? Theme.warning
                        : root.tone == Tone.danger ? Theme.destructive
                        : root.tone == Tone.neutral ? Theme.dim-foreground
                        : Theme.primary;
                }
            }
        }
        Text {
            width: 76px;
            text: root.value;
            color: Theme.muted-foreground;
            font-size: Theme.size-small;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// A numbered progress strip for a short wizard: finished steps show a check,
// the current one is accented, later ones are dim.
export component Stepper inherits Rectangle {
    in property <[string]> labels;
    in property <int> current: 0;

    height: 28px;

    HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for label[i] in root.labels: HorizontalLayout {
            spacing: 8px;
            if i > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 28px;
                    height: 1px;
                    background: i <= root.current ? Theme.primary : Theme.border-strong;
                }
            }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 20px;
                    height: 20px;
                    border-radius: 10px;
                    background: i < root.current ? Theme.success-soft
                        : i == root.current ? Theme.primary
                        : Theme.secondary;
                    if i < root.current: Icon {
                        source: Icons.check;
                        tint: Theme.success;
                        width: 12px;
                        height: 12px;
                    }
                    if i >= root.current: Text {
                        text: i + 1;
                        color: i == root.current ? Theme.primary-foreground : Theme.dim-foreground;
                        font-size: Theme.size-small;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
            Text {
                text: label;
                color: i == root.current ? Theme.foreground : Theme.muted-foreground;
                font-size: Theme.size-label;
                font-weight: i == root.current ? 600 : 400;
                vertical-alignment: center;
            }
        }
    }
}

// -- Visual query builder and table dialogs additions -------------------------

// The header of a collapsible form section: a chevron, the title and a count
// badge. The whole row is the click target, so there is no tiny arrow to hit.
export component CollapseHeader inherits Rectangle {
    in property <string> title;
    // Items in the section; 0 hides the badge.
    in property <int> count: 0;
    in property <bool> open: true;
    callback clicked;

    height: 34px;
    border-radius: Theme.radius-control;
    background: touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }

    accessible-role: button;
    accessible-label: root.title;
    accessible-expandable: true;
    accessible-expanded: root.open;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 8px;
        spacing: 6px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.open ? Icons.chevron-down : Icons.chevron-right;
                tint: Theme.muted-foreground;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.title;
            color: Theme.foreground;
            font-size: Theme.size-label;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
        if root.count > 0: VerticalLayout {
            alignment: center;
            Badge { text: root.count; tone: Tone.accent; }
        }
        Rectangle { horizontal-stretch: 1; }
    }
}

// -- Results: JSON and Text views, query error, export dialog ------------------

// One coloured run on a line of the JSON or Text view. `kind` is
// dbhive_ui_model::result_export::JsonKind: 0 plain, 1 key, 2 string,
// 3 number, 4 bool, 5 null, 6 punctuation. `col` is the character column the
// run starts at, so runs are placed by the monospace advance.
export struct ResultViewRun {
    text: string,
    kind: int,
    col: int,
}

export struct ResultViewLine {
    runs: [ResultViewRun],
}

// A read-only, scrollable, virtualised block of monospace lines, coloured by
// run. Rust supplies the lines through a lazy model, so a 2,000 row JSON view
// only builds the lines on screen. Header and body scroll sideways together.
export component ResultViewText inherits Rectangle {
    in property <[ResultViewLine]> lines;
    // Longest line in characters, for the sideways scroll.
    in property <int> max-columns;
    in property <string> mono-family: "Menlo";
    in property <length> mono-size: Theme.size-mono;
    in property <string> label: "Results as text";

    property <length> pad: 12px;
    property <length> line-height: root.mono-size * 1.5;
    property <length> advance: measure.preferred-width / 10;

    pure function kind-color(kind: int) -> color {
        return kind == 1 ? Theme.foreground
            : kind == 2 ? Theme.success
            : kind == 3 || kind == 4 ? Theme.warning
            : kind == 5 ? Theme.dim-foreground
            : kind == 6 ? Theme.muted-foreground
            : Theme.foreground;
    }

    min-width: 0px;
    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label;

    // Measures the monospace advance. Never visible.
    measure := Text {
        visible: false;
        text: "0000000000";
        font-family: root.mono-family;
        font-size: root.mono-size;
    }

    Flickable {
        content-width: max(self.width, root.max-columns * root.advance + 2 * root.pad);
        content-height: self.height;

        VerticalLayout {
            width: max(parent.width, root.max-columns * root.advance + 2 * root.pad);
            spacing: 0;
            ListView {
                padding-top: 6px;
                padding-bottom: 6px;
                for line in root.lines: Rectangle {
                    height: root.line-height;
                    for run in line.runs: Text {
                        x: root.pad + run.col * root.advance;
                        height: root.line-height;
                        text: run.text;
                        color: root.kind-color(run.kind);
                        font-family: root.mono-family;
                        font-size: root.mono-size;
                        font-weight: run.kind == 1 ? 600 : 400;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// A failed query: a headline, the driver's own message, an optional code, and
// the query that failed behind a disclosure. Copy puts all of it on the
// clipboard; Retry runs the query again.
export component ResultViewError inherits Rectangle {
    in property <string> headline;
    in property <string> detail;
    in property <string> code;
    in property <string> query;
    in property <bool> query-open: false;
    in property <bool> can-retry: true;
    callback retry;
    callback copy;
    callback toggle-query;

    background: Theme.destructive-soft;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.destructive.transparentize(0.6);

    VerticalLayout {
        padding: 14px;
        spacing: 10px;
        alignment: start;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Icon { source: Icons.triangle-alert; tint: Theme.destructive; }
            }
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.headline;
                    color: Theme.foreground;
                    font-size: Theme.size-subheading;
                    font-weight: 700;
                    overflow: elide;
                }
            }
            if root.code != "": VerticalLayout {
                alignment: center;
                Badge { text: "Code " + root.code; }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Copy";
                    has-icon: true;
                    icon: Icons.copy;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Copy the error and the query";
                    clicked => { root.copy(); }
                }
            }
            if root.can-retry: VerticalLayout {
                alignment: center;
                Button {
                    text: "Retry";
                    has-icon: true;
                    icon: Icons.refresh-cw;
                    clicked => { root.retry(); }
                }
            }
        }

        Text {
            text: root.detail;
            color: Theme.foreground;
            font-family: "Menlo";
            font-size: Theme.size-mono;
            wrap: word-wrap;
        }

        if root.query != "": VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                CollapseHeader {
                    horizontal-stretch: 0;
                    title: "Query";
                    open: root.query-open;
                    clicked => { root.toggle-query(); }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.query-open: CodeBlock {
                text: root.query;
                max-lines: 10;
            }
        }
    }
}

// The export dialog's card: what is being exported, the format, the path, and
// afterwards where the file went. All state is passed in; the screen that
// hosts it owns the logic.
export component ExportDialog inherits Popover {
    in property <string> title: "Export results";
    in property <string> scope-note;
    in property <[string]> formats;
    in property <int> format;
    in-out property <string> path;
    in property <string> path-error;
    // A file is already at the path: the first Export click only warns.
    in property <bool> replaces;
    in property <string> hint;
    in property <bool> running;
    in property <bool> done;
    in property <string> done-message;
    callback format-picked(int);
    callback path-edited(string);
    callback use-suggested;
    callback export;
    callback cancel;
    callback reveal;

    width: 540px;

    // Keeps a click on the card from reaching the backdrop behind it.
    TouchArea { }

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 32px;
                    height: 32px;
                    border-radius: 16px;
                    background: Theme.primary-soft;
                    Icon {
                        source: Icons.download;
                        tint: Theme.primary;
                        width: 16px;
                        height: 16px;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 1;
                Text {
                    text: root.title;
                    color: Theme.foreground;
                    font-size: Theme.size-subheading;
                    font-weight: 700;
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    has-icon: true;
                    icon: Icons.x;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Close";
                    enabled: !root.running;
                    clicked => { root.cancel(); }
                }
            }
        }

        if root.done: Banner {
            message: root.done-message;
            tone: Tone.success;
            dismissible: false;
        }

        if !root.done: Banner {
            message: root.scope-note;
            tone: Tone.neutral;
            dismissible: false;
        }

        if !root.done: FormField {
            label: "Format";
            HorizontalLayout {
                alignment: start;
                Segmented {
                    options: root.formats;
                    selected: root.format;
                    picked(i) => {
                        if (!root.running) {
                            root.format-picked(i);
                        }
                    }
                }
            }
        }

        if !root.done: FormField {
            label: "Save to";
            hint: root.hint;
            error: root.path-error;
            TextField {
                text <=> root.path;
                placeholder: "/Users/you/Downloads/results.csv";
                has-trailing-icon: true;
                trailing-icon: Icons.refresh-cw;
                enabled: !root.running;
                edited(t) => { root.path-edited(t); }
                accepted(t) => { root.export(); }
                trailing-clicked => { root.use-suggested(); }
            }
        }

        if !root.done && root.replaces && root.path-error == "": Banner {
            message: "A file with this name already exists. Exporting will replace it.";
            tone: Tone.warning;
            dismissible: false;
        }

        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if root.done: Button {
                text: "Reveal in folder";
                has-icon: true;
                icon: Icons.folder;
                clicked => { root.reveal(); }
            }
            if !root.done: Button {
                text: "Cancel";
                enabled: !root.running;
                clicked => { root.cancel(); }
            }
            if root.done: Button {
                text: "Done";
                variant: ButtonVariant.primary;
                clicked => { root.cancel(); }
            }
            if !root.done: Button {
                text: root.running ? "Exporting…" : root.replaces ? "Replace file" : "Export";
                variant: ButtonVariant.primary;
                has-icon: true;
                icon: Icons.download;
                enabled: !root.running;
                clicked => { root.export(); }
            }
        }
    }
}

// One bar or line series over a 1000 by 1000 path space written by Rust
// (dbhive_ui_model::result_chart), so the plot does not care how big it is
// drawn. Three gridlines, three y labels, the first and last x labels. Like
// LineChart, each Path is sized to the plot and its viewbox pinned, or Slint
// scales the path to the bounding box of its points.
export component ChartPlot inherits Rectangle {
    // 0 bars (filled), 1 line (stroked, with a soft area beneath).
    in property <int> kind;
    in property <string> commands;
    in property <string> area;
    in property <string> y-top;
    in property <string> y-mid;
    in property <string> y-bottom;
    in property <string> x-start;
    in property <string> x-end;
    in property <length> plot-height: 120px;
    in property <string> label: "Chart";

    background: Theme.card;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;
    accessible-role: AccessibleRole.text;
    accessible-label: root.label;

    VerticalLayout {
        padding: 12px;
        padding-bottom: 8px;
        spacing: 8px;

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 8px;

            Rectangle {
                width: 44px;
                min-height: root.plot-height;
                Text {
                    y: 0;
                    width: parent.width;
                    text: root.y-top;
                    color: Theme.dim-foreground;
                    font-size: Theme.size-small;
                    horizontal-alignment: right;
                }
                Text {
                    y: (parent.height - self.height) / 2;
                    width: parent.width;
                    text: root.y-mid;
                    color: Theme.dim-foreground;
                    font-size: Theme.size-small;
                    horizontal-alignment: right;
                }
                Text {
                    y: parent.height - self.height;
                    width: parent.width;
                    text: root.y-bottom;
                    color: Theme.dim-foreground;
                    font-size: Theme.size-small;
                    horizontal-alignment: right;
                }
            }

            plot := Rectangle {
                horizontal-stretch: 1;
                min-height: root.plot-height;
                clip: true;

                Rectangle { y: 0; height: 1px; background: Theme.border; }
                Rectangle { y: (parent.height - 1px) / 2; height: 1px; background: Theme.border; }
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-strong; }

                if root.kind == 1: Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    fit: fill;
                    commands: root.area;
                    fill: Theme.primary.transparentize(0.88);
                    stroke: transparent;
                    stroke-width: 0px;
                }
                Path {
                    width: plot.width;
                    height: plot.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 1000;
                    viewbox-height: 1000;
                    fit: fill;
                    commands: root.commands;
                    fill: root.kind == 0 ? Theme.primary : transparent;
                    stroke: root.kind == 0 ? transparent : Theme.primary;
                    stroke-width: root.kind == 0 ? 0px : 2px;
                    stroke-line-join: round;
                    stroke-line-cap: round;
                }
            }
        }

        HorizontalLayout {
            padding-left: 52px;
            Text {
                text: root.x-start;
                color: Theme.dim-foreground;
                font-size: Theme.size-small;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.x-end;
                color: Theme.dim-foreground;
                font-size: Theme.size-small;
                horizontal-alignment: right;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
    }
}

// A small labelled checkbox, for the dense rows of a column editor where a
// full switch would dwarf the field beside it.
export component CheckBox inherits Rectangle {
    in property <string> text;
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;

    height: 24px;
    horizontal-stretch: 0;
    opacity: root.enabled ? 1 : 0.4;

    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if (root.enabled) {
            root.toggled();
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: root.enabled ? pointer : default;
        clicked => { root.toggled(); }
    }
    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 16px;
                height: 16px;
                border-radius: 4px;
                background: root.checked ? Theme.primary : Theme.card;
                border-width: 1px;
                border-color: root.checked ? Theme.primary : Theme.border-strong;
                animate background { duration: 90ms; }
                if root.checked: Icon {
                    source: Icons.check;
                    tint: Theme.primary-foreground;
                    width: 12px;
                    height: 12px;
                }
            }
        }
        if root.text != "": Text {
            text: root.text;
            color: Theme.foreground;
            font-size: Theme.size-label;
            vertical-alignment: center;
        }
    }
}

// The numbered steps of a wizard. A step already passed shows a tick; the
// current one is filled. Every step is a button, and the caller decides
// whether a click may go there.
export component StepTabs inherits Rectangle {
    in property <[string]> labels;
    in property <int> active: 0;
    callback picked(int);

    height: 36px;

    HorizontalLayout {
        alignment: start;
        spacing: 8px;
        for label[i] in root.labels: HorizontalLayout {
            spacing: 8px;
            if i > 0: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 24px;
                    height: 1px;
                    background: i <= root.active ? Theme.primary : Theme.border-strong;
                }
            }
            Rectangle {
                width: step-row.preferred-width + 12px;
                border-radius: Theme.radius-control;
                background: step-touch.has-hover ? Theme.hover : transparent;
                animate background { duration: 90ms; }

                accessible-role: tab;
                accessible-label: "Step " + (i + 1) + ", " + label;
                accessible-action-default => { root.picked(i); }

                step-touch := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.picked(i); }
                }
                step-row := HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: i == root.active ? Theme.primary : i < root.active ? Theme.primary-soft : transparent;
                            border-width: i > root.active ? 1px : 0px;
                            border-color: Theme.border-strong;
                            if i < root.active: Icon {
                                source: Icons.check;
                                tint: Theme.primary;
                                width: 13px;
                                height: 13px;
                            }
                            if i >= root.active: Text {
                                text: i + 1;
                                color: i == root.active ? Theme.primary-foreground : Theme.muted-foreground;
                                font-size: Theme.size-small;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    Text {
                        text: label;
                        color: i == root.active ? Theme.foreground : Theme.muted-foreground;
                        font-size: Theme.size-label;
                        font-weight: i == root.active ? 600 : 400;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// A single row of chips that scrolls sideways when there are more than fit,
// since Slint has no wrapping layout. Put FilterChips inside.
export component ChipStrip inherits Flickable {
    height: 28px;
    content-width: strip.preferred-width;
    content-height: self.height;

    strip := HorizontalLayout {
        spacing: 6px;
        alignment: start;
        @children
    }
}

// -- ER diagram and schema designer additions ---------------------------------

// A form control with a small caption above it, for property panels where
// SettingRow's two-column layout is too wide.
export component PropField inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    vertical-stretch: 0;
    Text {
        text: root.label;
        color: Theme.muted-foreground;
        font-size: Theme.size-small;
        font-weight: 600;
    }
    @children
}

// A small key marker ("PK", "FK") shown in front of a column name in lists.
export component KeyTag inherits Text {
    in property <bool> primary: false;
    width: 24px;
    color: root.primary ? Theme.primary : Theme.dim-foreground;
    font-size: Theme.size-small;
    font-weight: 700;
    vertical-alignment: center;
}

// -- Plugins additions ---------------------------------------------------------

// One marketplace entry as a flat row: name with its verified and category
// badges, who wrote it, what it does, its numbers and keywords, and the
// permissions it asks for, with the install control on the right. `state` is
// 0 available, 1 installing, 2 installed, 3 failed; a failure's reason shows
// under the description in the danger colour.
export component PluginMarketRow inherits Rectangle {
    in property <string> name;
    in property <string> byline;
    in property <string> description;
    in property <string> meta;
    in property <string> category;
    in property <[string]> keywords;
    in property <string> requests;
    // Asks for something that reads or writes outside the plugin itself.
    in property <bool> sensitive: false;
    in property <bool> verified: false;
    in property <int> state: 0;
    in property <string> note;
    callback install;

    min-height: 84px;
    border-radius: Theme.radius-control;
    background: row-touch.has-hover ? Theme.hover : transparent;
    animate background { duration: 90ms; }

    accessible-role: AccessibleRole.groupbox;
    accessible-label: root.name;
    accessible-description: root.description;

    row-touch := TouchArea { }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 3px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.name;
                    color: Theme.foreground;
                    font-size: Theme.size-body;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 0;
                }
                if root.verified: VerticalLayout {
                    alignment: center;
                    Badge { text: "Verified"; tone: Tone.success; dot: true; }
                }
                VerticalLayout {
                    alignment: center;
                    Badge { text: root.category; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            Text {
                text: root.byline;
                color: Theme.dim-foreground;
                font-size: Theme.size-small;
                overflow: elide;
            }
            Text {
                text: root.description;
                color: Theme.muted-foreground;
                font-size: Theme.size-label;
                wrap: word-wrap;
                overflow: elide;
                max-height: 2 * Theme.size-label * 1.35;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.meta;
                    color: Theme.dim-foreground;
                    font-size: Theme.size-small;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                for k in root.keywords: VerticalLayout {
                    alignment: center;
                    Badge { text: k; }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.requests != "": Text {
                text: root.requests;
                color: root.sensitive ? Theme.warning : Theme.dim-foreground;
                font-size: Theme.size-small;
                overflow: elide;
            }
            if root.note != "": Text {
                text: root.note;
                color: Theme.destructive;
                font-size: Theme.size-small;
                wrap: word-wrap;
            }
        }
        VerticalLayout {
            horizontal-stretch: 0;
            width: 112px;
            alignment: center;
            spacing: 6px;
            if root.state == 0 || root.state == 3: Button {
                text: root.state == 3 ? "Retry" : "Install";
                has-icon: true;
                icon: Icons.download;
                accessible-label: (root.state == 3 ? "Retry installing " : "Install ") + root.name;
                clicked => { root.install(); }
            }
            if root.state == 1: VerticalLayout {
                spacing: 6px;
                Text {
                    text: "Installing…";
                    color: Theme.muted-foreground;
                    font-size: Theme.size-label;
                    horizontal-alignment: center;
                }
                ProgressBar { indeterminate: true; }
            }
            if root.state == 2: HorizontalLayout {
                alignment: center;
                Badge { text: "Installed"; tone: Tone.success; dot: true; }
            }
        }
    }
}

// One line of a table a plugin described: equal-width cells, elided. The
// header line carries the secondary fill and semibold text.
export component PluginTableRow inherits Rectangle {
    in property <[string]> cells;
    in property <bool> head: false;

    min-height: 26px;
    border-radius: Theme.radius-control;
    background: root.head ? Theme.secondary : transparent;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        for cell in root.cells: Text {
            // Equal columns: every cell starts at zero width and shares the
            // row equally, so the columns line up from row to row.
            horizontal-stretch: 1;
            preferred-width: 0px;
            min-width: 0px;
            text: cell;
            color: root.head ? Theme.foreground : Theme.muted-foreground;
            font-size: Theme.size-small;
            font-weight: root.head ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

// One permission a plugin declared: a marker, its name and what it allows.
// A sensitive one (it reads or writes outside the plugin) gets a warning mark.
export component PluginPermissionRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> detail;
    in property <bool> sensitive: false;
    spacing: 10px;
    vertical-stretch: 0;

    VerticalLayout {
        alignment: start;
        padding-top: 2px;
        Icon {
            source: root.sensitive ? Icons.triangle-alert : Icons.circle-check;
            tint: root.sensitive ? Theme.warning : Theme.dim-foreground;
            width: 14px;
            height: 14px;
        }
    }
    VerticalLayout {
        horizontal-stretch: 1;
        spacing: 1px;
        Text {
            text: root.label;
            color: Theme.foreground;
            font-size: Theme.size-label;
            font-weight: 600;
        }
        Text {
            text: root.detail;
            color: Theme.muted-foreground;
            font-size: Theme.size-small;
            wrap: word-wrap;
        }
    }
}

// A multi-line text box in the field style, for a plugin's multi-line input.
export component PluginTextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <bool> enabled: true;
    callback edited(string);

    min-height: 84px;
    background: Theme.card;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: area.has-focus ? Theme.primary : Theme.border;
    opacity: root.enabled ? 1 : 0.5;
    animate border-color { duration: 110ms; }

    Rectangle {
        x: 10px;
        y: 8px;
        width: parent.width - 20px;
        height: parent.height - 16px;
        clip: true;
        area := TextInput {
            width: 100%;
            height: 100%;
            text <=> root.text;
            enabled: root.enabled;
            color: Theme.foreground;
            font-size: Theme.size-body;
            wrap: word-wrap;
            single-line: false;
            selection-background-color: Theme.primary.transparentize(0.65);
            selection-foreground-color: Theme.foreground;
            edited => { root.edited(self.text); }
        }
        Text {
            width: 100%;
            visible: root.text == "";
            text: root.placeholder;
            color: Theme.dim-foreground;
            font-size: Theme.size-body;
        }
    }
}
// -- AI assistant additions ---------------------------------------------------

// One entry of the assistant's conversation: the user's request, an answer
// (prose, then the statement in its own block with the ways to apply it) or a
// failure. Flat, not carded: an answer sits on the panel itself; a request is
// a tinted block, so the two read apart at a glance.
export component AiTurnCard inherits Rectangle {
    in property <bool> user: false;
    in property <string> heading;
    in property <string> body;
    in property <bool> has-sql: false;
    in property <string> sql;
    // "gpt-4o-mini · 1.2s".
    in property <string> meta;
    in property <bool> failed: false;
    callback replace;
    callback append;
    callback new-tab;
    callback copy;

    background: root.failed ? Theme.destructive-soft : root.user ? Theme.secondary : transparent;
    border-radius: Theme.radius-control;
    border-width: root.failed ? 1px : 0px;
    border-color: Theme.destructive.transparentize(0.6);

    VerticalLayout {
        padding: root.user || root.failed ? 10px : 2px;
        spacing: 6px;

        HorizontalLayout {
            spacing: 6px;
            if !root.user: VerticalLayout {
                alignment: center;
                Icon {
                    source: root.failed ? Icons.triangle-alert : Icons.sparkles;
                    tint: root.failed ? Theme.destructive : Theme.primary;
                    width: 13px;
                    height: 13px;
                }
            }
            Text {
                text: root.heading;
                color: root.failed ? Theme.destructive : Theme.muted-foreground;
                font-size: Theme.size-small;
                font-weight: 600;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            if root.meta != "": Text {
                text: root.meta;
                color: Theme.dim-foreground;
                font-size: Theme.size-small;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        if root.body != "": Text {
            text: root.body;
            color: root.failed ? Theme.destructive : root.user ? Theme.muted-foreground : Theme.foreground;
            font-size: root.user ? Theme.size-mono : Theme.size-label;
            font-family: root.user ? "Menlo" : "";
            wrap: word-wrap;
        }

        if root.has-sql: CodeBlock {
            text: root.sql;
            max-lines: 14;
        }

        if root.has-sql: HorizontalLayout {
            spacing: 6px;
            alignment: start;
            Button {
                text: "Replace in editor";
                accessible-label: "Replace the editor's query with this statement";
                clicked => { root.replace(); }
            }
            Button {
                text: "Add below";
                accessible-label: "Add this statement below the editor's query";
                clicked => { root.append(); }
            }
            Button {
                text: "New tab";
                accessible-label: "Open this statement in a new query tab";
                clicked => { root.new-tab(); }
            }
            Button {
                has-icon: true;
                icon: Icons.copy;
                variant: ButtonVariant.ghost;
                accessible-label: "Copy this statement";
                clicked => { root.copy(); }
            }
        }
    }
}

// Monospace text in a frame that scrolls when it is longer than the frame.
// The caller passes the line count so the frame fits short text and stops at
// `limit-height` for long text; measuring wrapped text from inside a scroll
// view would make the height depend on itself.
export component AiScrollText inherits Rectangle {
    in property <string> text;
    in property <int> line-count: 1;
    in property <length> limit-height: 160px;

    height: min(root.limit-height, root.line-count * Theme.size-mono * 1.5 + 18px);
    background: Theme.card;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            padding: 8px;
            padding-left: 10px;
            padding-right: 10px;
            Text {
                text: root.text;
                color: Theme.foreground;
                font-size: Theme.size-mono;
                font-family: "Menlo";
                wrap: word-wrap;
            }
        }
    }
}

// A line saying the assistant is waiting on the provider: a moving bar and
// what it is doing.
export component AiBusyRow inherits HorizontalLayout {
    in property <string> text;
    spacing: 10px;
    height: 22px;
    VerticalLayout {
        alignment: center;
        width: 72px;
        ProgressBar { indeterminate: true; }
    }
    Text {
        text: root.text;
        color: Theme.muted-foreground;
        font-size: Theme.size-small;
        vertical-alignment: center;
    }
}

// -- Schema browser: tree rows and a context menu ---------------------------------
// (name prefixes Tree and Ctx)

export enum TreeRowKind { database, schema, table, view, loading, error, empty }

// One visible row of the schema tree. Rust flattens the tree (what is
// expanded, what a search left standing) and hands over rows with a depth.
export struct TreeNode {
    kind: TreeRowKind,
    depth: int,
    label: string,
    // A table's row count, a schema's table count, or a note's action word.
    detail: string,
    expandable: bool,
    expanded: bool,
    // The connection's database, or the schema other tools act on.
    active: bool,
    // A server's own bookkeeping, drawn quieter.
    dim: bool,
    busy: bool,
}

// A flat tree row: an indent, a chevron, an icon, a label and a trailing
// detail on one vertical centre. `cursor` is the highlighted row; `ring` adds
// the focus outline when the tree owns the keyboard.
export component TreeRowView inherits Rectangle {
    in property <TreeNode> node;
    in property <bool> cursor: false;
    in property <bool> ring: false;
    callback clicked;
    callback double-clicked;
    // The chevron.
    callback toggled;
    // A right click, in window coordinates.
    callback context(length, length);

    property <bool> is-note: root.node.kind == TreeRowKind.loading
        || root.node.kind == TreeRowKind.error || root.node.kind == TreeRowKind.empty;
    property <image> glyph: root.node.kind == TreeRowKind.database ? Icons.database
        : root.node.kind == TreeRowKind.schema ? Icons.folder
        : root.node.kind == TreeRowKind.table ? Icons.table
        : root.node.kind == TreeRowKind.view ? Icons.eye
        : root.node.kind == TreeRowKind.error ? Icons.triangle-alert
        : root.node.kind == TreeRowKind.empty ? Icons.plus
        : Icons.refresh-cw;
    property <color> glyph-tint: root.node.kind == TreeRowKind.error ? Theme.destructive
        : root.node.active ? Theme.primary
        : root.node.dim ? Theme.dim-foreground
        : Theme.muted-foreground;
    property <color> label-color: root.node.kind == TreeRowKind.error ? Theme.destructive
        : root.is-note ? Theme.muted-foreground
        : root.node.dim ? Theme.dim-foreground
        : Theme.foreground;

    height: 28px;
    border-radius: Theme.radius-control;
    background: root.cursor ? Theme.primary-soft : touch.has-hover ? Theme.hover : transparent;
    border-width: root.cursor && root.ring ? 2px : 0px;
    border-color: Theme.primary;
    animate background { duration: 90ms; }

    accessible-role: list-item;
    accessible-label: root.node.label;
    accessible-description: root.node.detail;
    accessible-expandable: root.node.expandable;
    accessible-expanded: root.node.expanded;
    accessible-item-selected: root.cursor;
    accessible-action-default => { root.double-clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        double-clicked => { root.double-clicked(); }
        pointer-event(e) => {
            if (e.button == PointerEventButton.right && e.kind == PointerEventKind.up) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: 4px + root.node.depth * 12px;
        padding-right: 8px;
        spacing: 4px;
        Rectangle {
            width: 18px;
            if root.node.expandable: TouchArea {
                mouse-cursor: pointer;
                clicked => { root.toggled(); }
                Icon {
                    source: root.node.expanded ? Icons.chevron-down : Icons.chevron-right;
                    tint: Theme.dim-foreground;
                    width: 14px;
                    height: 14px;
                }
            }
        }
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.glyph;
                tint: root.glyph-tint;
                width: 14px;
                height: 14px;
            }
        }
        Text {
            text: root.node.label;
            color: root.label-color;
            font-size: Theme.size-label;
            font-weight: root.node.active ? 600 : 400;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.node.active: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 6px;
                height: 6px;
                border-radius: 3px;
                background: root.node.kind == TreeRowKind.database ? Theme.success : Theme.primary;
            }
        }
        if root.node.busy: Text {
            text: "…";
            color: Theme.dim-foreground;
            font-size: Theme.size-small;
            vertical-alignment: center;
        }
        if root.node.detail != "" && !root.node.busy: Text {
            text: root.node.detail;
            color: root.node.kind == TreeRowKind.error || root.node.kind == TreeRowKind.empty
                ? Theme.primary : Theme.dim-foreground;
            font-size: Theme.size-small;
            vertical-alignment: center;
        }
    }
}

// Read-only monospace text that fills its frame and scrolls when it is longer
// (a routine's definition). The caller sizes the frame.
export component TreeCodeView inherits Rectangle {
    in property <string> text;

    background: Theme.card;
    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: Theme.border;
    clip: true;

    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    ScrollView {
        width: 100%;
        height: 100%;
        VerticalLayout {
            padding: 10px;
            Text {
                text: root.text;
                color: Theme.foreground;
                font-size: Theme.size-mono;
                font-family: "Menlo";
                wrap: word-wrap;
            }
        }
    }
}

// One entry of a context menu. `icon` names a kit icon; the menu maps it.
export struct CtxItem {
    label: string,
    icon: string,
    enabled: bool,
    danger: bool,
    // A rule above this entry, to group the destructive ones apart.
    divider: bool,
}

// The surface and entries of a right-click menu. The caller places it (an
// overlay at the pointer) and decides what an entry does; this draws the
// entries, tracks the keyboard highlight and reports a pick or Escape.
export component CtxMenu inherits Popover {
    in property <[CtxItem]> items;
    in-out property <int> highlighted: -1;
    callback chosen(int);
    callback dismissed;

    function glyph(name: string) -> image {
        return name == "table" ? Icons.table
            : name == "code" ? Icons.code
            : name == "copy" ? Icons.copy
            : name == "pencil" ? Icons.pencil
            : name == "refresh-cw" ? Icons.refresh-cw
            : name == "trash-2" ? Icons.trash-2
            : name == "plus" ? Icons.plus
            : name == "database" ? Icons.database
            : Icons.circle;
    }

    width: 208px;
    height: col.preferred-height;

    accessible-role: list;
    accessible-label: "Actions";

    scope := FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.dismissed();
                return accept;
            }
            if (e.text == Key.DownArrow) {
                root.highlighted = min(root.highlighted + 1, root.items.length - 1);
                return accept;
            }
            if (e.text == Key.UpArrow) {
                root.highlighted = max(root.highlighted - 1, 0);
                return accept;
            }
            if (e.text == Key.Return) {
                if (root.highlighted >= 0 && root.items[root.highlighted].enabled) {
                    root.chosen(root.highlighted);
                }
                return accept;
            }
            return reject;
        }

        col := VerticalLayout {
            padding: 4px;
            for it[i] in root.items: VerticalLayout {
                if it.divider: Rectangle {
                    height: 9px;
                    Divider { y: 4px; }
                }
                Rectangle {
                    height: 30px;
                    border-radius: Theme.radius-control;
                    background: it.enabled && (item-touch.has-hover || root.highlighted == i) ? Theme.hover : transparent;
                    opacity: it.enabled ? 1 : 0.45;

                    accessible-role: button;
                    accessible-label: it.label;
                    accessible-action-default => {
                        if (it.enabled) {
                            root.chosen(i);
                        }
                    }

                    item-touch := TouchArea {
                        enabled: it.enabled;
                        mouse-cursor: it.enabled ? pointer : default;
                        clicked => { root.chosen(i); }
                    }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            Icon {
                                source: root.glyph(it.icon);
                                tint: it.danger ? Theme.destructive : Theme.muted-foreground;
                                width: 14px;
                                height: 14px;
                            }
                        }
                        Text {
                            text: it.label;
                            color: it.danger ? Theme.destructive : Theme.foreground;
                            font-size: Theme.size-label;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                        }
                    }
                }
            }
        }
    }
}
