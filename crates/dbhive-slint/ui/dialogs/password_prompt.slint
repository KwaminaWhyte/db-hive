// Asks for a saved connection's password when none is stored.
//
// Shown instead of connecting with an empty password, which servers answer
// with an opaque error. Rust (src/app/connect_flow.rs) decides when it shows
// and what it says; this file lays it out. The typed password goes straight to
// the connect call and is never echoed in a message.

import { Theme, Icons, Icon, Button, ButtonVariant, TextField, CheckBox, Popover } from "../kit/kit.slint";

export global PasswordPromptState {
    in property <bool> visible;
    in property <string> title;
    in property <string> message;
    in property <string> field-label: "Password";
    in-out property <string> password;
    in property <bool> show-text;
    in property <bool> remember: true;
    callback password-edited(string);
    callback toggle-show;
    callback toggle-remember;
    callback submit;
    callback cancel;
}

export component PasswordPromptOverlay inherits Rectangle {
    background: Theme.scrim;

    // Clicks on the backdrop go nowhere: the dialog holds typed input.
    TouchArea { }

    keys := FocusScope {
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                PasswordPromptState.cancel();
                return accept;
            }
            reject
        }

        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Popover {
                    width: 380px;

                    VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 12px;
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: Theme.primary-soft;
                                    Icon {
                                        source: Icons.key-round;
                                        tint: Theme.primary;
                                        width: 16px;
                                        height: 16px;
                                    }
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                Text {
                                    text: PasswordPromptState.title;
                                    color: Theme.foreground;
                                    font-size: Theme.size-subheading;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                            }
                        }

                        Text {
                            text: PasswordPromptState.message;
                            color: Theme.muted-foreground;
                            font-size: Theme.size-label;
                            wrap: word-wrap;
                        }

                        field := TextField {
                            text <=> PasswordPromptState.password;
                            placeholder: PasswordPromptState.field-label;
                            password: !PasswordPromptState.show-text;
                            has-icon: true;
                            icon: Icons.lock;
                            has-trailing-icon: true;
                            trailing-icon: PasswordPromptState.show-text ? Icons.eye-off : Icons.eye;
                            trailing-clicked => { PasswordPromptState.toggle-show(); }
                            edited(t) => { PasswordPromptState.password-edited(t); }
                            accepted(t) => { PasswordPromptState.submit(); }
                            init => { self.focus-input(); }
                        }

                        CheckBox {
                            text: "Remember in the system keychain";
                            checked: PasswordPromptState.remember;
                            toggled => { PasswordPromptState.toggle-remember(); }
                        }

                        Rectangle { height: 4px; }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: end;
                            Button {
                                text: "Cancel";
                                variant: ButtonVariant.secondary;
                                clicked => { PasswordPromptState.cancel(); }
                            }
                            Button {
                                text: "Connect";
                                variant: ButtonVariant.primary;
                                clicked => { PasswordPromptState.submit(); }
                            }
                        }
                    }
                }
            }
        }
    }
}
