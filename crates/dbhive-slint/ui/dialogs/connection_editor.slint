// The new/edit connection form.
//
// This is the dialog's *shape*: which fields show for the current driver,
// and their labels, come from `dbhive_ui_model::connection_editor` on the
// Rust side (`driver_fields`, `database_label`, `password_label`) so the two
// shells cannot disagree about a driver's fields. The dialog just lays out
// whatever the controller says is visible.
//
// The SSH sub-form, colour tag and pasted connection string follow the same
// rule: Rust decides what shows, this file only lays it out.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, Tone, SectionLabel, TextField, Dropdown, Toggle, SwatchPicker, Divider, Banner, Button, ButtonVariant, Badge, FilterChip } from "../kit/kit.slint";
import { FileBrowse, BrowseTarget } from "../components/file_browse.slint";

// Fields added after the dialog's callback list was wired through the
// window. They go straight to Rust through this global instead.
export global ConnectionEditorState {
    callback folder-changed(string);
    callback ssh-local-port-changed(string);
}

export struct ConnectionFormData {
    name: string,
    driver-label: string,
    driver-options: [string],
    // Which fields this driver wants, decided in Rust.
    show-file-path: bool,
    show-url: bool,
    show-host-port: bool,
    show-username: bool,
    show-password: bool,
    show-database: bool,
    show-ssl: bool,
    host: string,
    port: string,
    username: string,
    password: string,
    show-password-text: bool,
    database: string,
    database-label: string,
    password-label: string,
    ssl-label: string,
    ssl-options: [string],
    environment-label: string,
    environment-options: [string],
    description: string,
    favorite: bool,
    // Pasting a connection string fills host, port, user, password, database.
    show-connection-string: bool,
    connection-string: string,
    connection-string-placeholder: string,
    connection-string-error: string,
    // SSH tunnel sub-form. Only drivers that can tunnel set `show-ssh`.
    show-ssh: bool,
    ssh-enabled: bool,
    ssh-host: string,
    ssh-port: string,
    ssh-username: string,
    ssh-auth-label: string,
    ssh-auth-options: [string],
    ssh-show-key: bool,
    ssh-key-path: string,
    ssh-password: string,
    show-ssh-password-text: bool,
    // Colour tag swatches; `color-index` is -1 for none.
    color-options: [color],
    color-index: int,
    // Folder the connection is grouped under, and existing folders to pick.
    folder: string,
    folder-options: [string],
    // "0" or blank picks a free local port for the tunnel.
    ssh-local-port: string,
    // A password for this profile is already in the OS keychain.
    password-stored: bool,
}

export component ConnectionEditorDialog inherits Rectangle {
    in property <bool> is-new;
    in property <ConnectionFormData> form;
    in property <[string]> errors;
    in property <bool> testing;
    in property <string> test-message;
    in property <bool> test-ok;
    in property <bool> saving;

    callback name-changed(string);
    callback driver-selected(int);
    callback host-changed(string);
    callback port-changed(string);
    callback username-changed(string);
    callback password-changed(string);
    callback toggle-password-visibility;
    callback database-changed(string);
    callback ssl-selected(int);
    callback environment-selected(int);
    callback description-changed(string);
    callback toggle-favorite;
    callback connection-string-changed(string);
    callback apply-connection-string;
    callback toggle-ssh;
    callback ssh-host-changed(string);
    callback ssh-port-changed(string);
    callback ssh-username-changed(string);
    callback ssh-auth-selected(int);
    callback ssh-key-path-changed(string);
    callback ssh-password-changed(string);
    callback toggle-ssh-password-visibility;
    callback color-picked(int);
    callback test-connection;
    callback save;
    callback cancel;

    // Set by the window so the footer buttons never fall off a short window.
    in property <length> available-height: 960px;

    width: 480px;
    height: min(960px, root.available-height);
    background: Theme.popover;
    border-radius: Theme.radius-window;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 32px;
    drop-shadow-offset-y: 12px;
    drop-shadow-color: #00000070;

    VerticalLayout {
        padding: 20px;
        spacing: 4px;

        HorizontalLayout {
            Text {
                text: root.is-new ? "New connection" : "Edit connection";
                color: Theme.foreground;
                font-size: Theme.size-subheading;
                font-weight: 700;
                horizontal-stretch: 1;
            }
            TouchArea {
                width: 16px;
                mouse-cursor: pointer;
                clicked => { root.cancel(); }
                Icon { source: Icons.x; tint: Theme.dim-foreground; width: 13px; height: 13px; }
            }
        }

        ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
                spacing: 4px;
                // Keeps fields clear of the scrollbar drawn over the right edge.
                padding-right: 14px;
                // Without this, a driver with fewer fields (SQLite has no
                // host/port/username/password) leaves the layout with slack
                // height, and with no child stretching to take it, Slint
                // spreads it out as extra gaps between every row instead of
                // leaving it below the last one.
                alignment: start;

                SectionLabel { text: "Name"; }
                TextField {
                    text: root.form.name;
                    placeholder: "My database";
                    edited(t) => { root.name-changed(t); }
                }

                SectionLabel { text: "Driver"; }
                Dropdown {
                    value: root.form.driver-label;
                    options: root.form.driver-options;
                    selected(i) => { root.driver-selected(i); }
                }

                if root.form.show-connection-string: SectionLabel { text: "Connection string"; }
                if root.form.show-connection-string: HorizontalLayout {
                    spacing: 8px;
                    TextField {
                        horizontal-stretch: 1;
                        text: root.form.connection-string;
                        placeholder: root.form.connection-string-placeholder;
                        has-icon: true;
                        icon: Icons.link;
                        edited(t) => { root.connection-string-changed(t); }
                        accepted(t) => { root.apply-connection-string(); }
                    }
                    Button {
                        text: "Fill fields";
                        enabled: root.form.connection-string != "";
                        clicked => { root.apply-connection-string(); }
                    }
                }
                if root.form.show-connection-string && root.form.connection-string-error != "": Text {
                    text: root.form.connection-string-error;
                    color: Theme.destructive;
                    font-size: Theme.size-small;
                    wrap: word-wrap;
                }

                if root.form.show-file-path || root.form.show-url: SectionLabel {
                    text: root.form.show-url ? "URL" : root.form.database-label;
                }
                if root.form.show-url: TextField {
                    text: root.form.host;
                    placeholder: "libsql://my-db-org.turso.io";
                    edited(t) => { root.host-changed(t); }
                }
                if root.form.show-file-path && !root.form.show-url: HorizontalLayout {
                    spacing: 8px;
                    TextField {
                        horizontal-stretch: 1;
                        text: root.form.database;
                        placeholder: "/path/to/file.db";
                        edited(t) => { root.database-changed(t); }
                    }
                    Button {
                        text: "Browse…";
                        enabled: !FileBrowse.busy;
                        clicked => { FileBrowse.browse(BrowseTarget.sqlite-file); }
                    }
                }

                if root.form.show-host-port: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        SectionLabel { text: "Host"; }
                        TextField {
                            text: root.form.host;
                            placeholder: "localhost";
                            edited(t) => { root.host-changed(t); }
                        }
                    }
                    VerticalLayout {
                        width: 90px;
                        spacing: 4px;
                        SectionLabel { text: "Port"; }
                        TextField {
                            text: root.form.port;
                            edited(t) => { root.port-changed(t); }
                        }
                    }
                }

                if root.form.show-username: SectionLabel { text: "Username"; }
                if root.form.show-username: TextField {
                    text: root.form.username;
                    edited(t) => { root.username-changed(t); }
                }

                if root.form.show-password: HorizontalLayout {
                    spacing: 8px;
                    SectionLabel {
                        text: root.form.password-label;
                        horizontal-stretch: 1;
                    }
                    if root.form.password-stored: VerticalLayout {
                        alignment: end;
                        Badge {
                            text: "Saved in keychain";
                            tone: Tone.success;
                            dot: true;
                        }
                    }
                }
                if root.form.show-password: TextField {
                    text: root.form.password;
                    placeholder: root.form.password-stored ? "Leave blank to keep the saved one" : "";
                    password: !root.form.show-password-text;
                    has-trailing-icon: true;
                    trailing-icon: root.form.show-password-text ? Icons.eye-off : Icons.eye;
                    trailing-clicked => { root.toggle-password-visibility(); }
                    edited(t) => { root.password-changed(t); }
                }

                // SQLite's file path and Turso's URL are already "the
                // database" for those drivers, so this generic field only
                // shows up for the network drivers that have both.
                if root.form.show-database && !root.form.show-file-path && !root.form.show-url: SectionLabel {
                    text: root.form.database-label;
                }
                if root.form.show-database && !root.form.show-file-path && !root.form.show-url: TextField {
                    text: root.form.database;
                    edited(t) => { root.database-changed(t); }
                }

                HorizontalLayout {
                    spacing: 8px;
                    if root.form.show-ssl: VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        SectionLabel { text: "SSL"; }
                        Dropdown {
                            value: root.form.ssl-label;
                            options: root.form.ssl-options;
                            selected(i) => { root.ssl-selected(i); }
                        }
                    }
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        SectionLabel { text: "Environment"; }
                        Dropdown {
                            value: root.form.environment-label;
                            options: root.form.environment-options;
                            selected(i) => { root.environment-selected(i); }
                        }
                    }
                }

                SectionLabel { text: "Folder"; }
                TextField {
                    text: root.form.folder;
                    placeholder: "Unfiled";
                    has-icon: true;
                    icon: Icons.folder;
                    edited(t) => { ConnectionEditorState.folder-changed(t); }
                }
                if root.form.folder-options.length > 0: HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    for f in root.form.folder-options: FilterChip {
                        text: f;
                        selected: f == root.form.folder;
                        clicked => { ConnectionEditorState.folder-changed(self.selected ? "" : f); }
                    }
                }

                if root.form.show-ssh: Rectangle { height: 10px; }
                if root.form.show-ssh: Toggle {
                    text: "Connect through an SSH tunnel";
                    checked: root.form.ssh-enabled;
                    toggled => { root.toggle-ssh(); }
                }
                if root.form.show-ssh && root.form.ssh-enabled: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        SectionLabel { text: "SSH host"; }
                        TextField {
                            text: root.form.ssh-host;
                            placeholder: "bastion.example.com";
                            edited(t) => { root.ssh-host-changed(t); }
                        }
                    }
                    VerticalLayout {
                        width: 90px;
                        spacing: 4px;
                        SectionLabel { text: "Port"; }
                        TextField {
                            text: root.form.ssh-port;
                            edited(t) => { root.ssh-port-changed(t); }
                        }
                    }
                }
                if root.form.show-ssh && root.form.ssh-enabled: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 4px;
                        SectionLabel { text: "SSH username"; }
                        TextField {
                            text: root.form.ssh-username;
                            edited(t) => { root.ssh-username-changed(t); }
                        }
                    }
                    VerticalLayout {
                        width: 90px;
                        spacing: 4px;
                        SectionLabel { text: "Local port"; }
                        TextField {
                            text: root.form.ssh-local-port;
                            placeholder: "Auto";
                            edited(t) => { ConnectionEditorState.ssh-local-port-changed(t); }
                        }
                    }
                }
                if root.form.show-ssh && root.form.ssh-enabled: SectionLabel { text: "SSH authentication"; }
                if root.form.show-ssh && root.form.ssh-enabled: Dropdown {
                    value: root.form.ssh-auth-label;
                    options: root.form.ssh-auth-options;
                    selected(i) => { root.ssh-auth-selected(i); }
                }
                if root.form.show-ssh && root.form.ssh-enabled && root.form.ssh-show-key: SectionLabel { text: "Private key path"; }
                if root.form.show-ssh && root.form.ssh-enabled && root.form.ssh-show-key: HorizontalLayout {
                    spacing: 8px;
                    TextField {
                        horizontal-stretch: 1;
                        text: root.form.ssh-key-path;
                        placeholder: "~/.ssh/id_ed25519";
                        edited(t) => { root.ssh-key-path-changed(t); }
                    }
                    Button {
                        text: "Browse…";
                        enabled: !FileBrowse.busy;
                        clicked => { FileBrowse.browse(BrowseTarget.ssh-key); }
                    }
                }
                if root.form.show-ssh && root.form.ssh-enabled && root.form.ssh-show-key: SectionLabel { text: "Key passphrase (optional)"; }
                if root.form.show-ssh && root.form.ssh-enabled && root.form.ssh-show-key: TextField {
                    text: root.form.ssh-password;
                    placeholder: "Leave blank for an unencrypted key";
                    password: !root.form.show-ssh-password-text;
                    has-trailing-icon: true;
                    trailing-icon: root.form.show-ssh-password-text ? Icons.eye-off : Icons.eye;
                    trailing-clicked => { root.toggle-ssh-password-visibility(); }
                    edited(t) => { root.ssh-password-changed(t); }
                }
                if root.form.show-ssh && root.form.ssh-enabled && !root.form.ssh-show-key: SectionLabel { text: "SSH password"; }
                if root.form.show-ssh && root.form.ssh-enabled && !root.form.ssh-show-key: TextField {
                    text: root.form.ssh-password;
                    password: !root.form.show-ssh-password-text;
                    has-trailing-icon: true;
                    trailing-icon: root.form.show-ssh-password-text ? Icons.eye-off : Icons.eye;
                    trailing-clicked => { root.toggle-ssh-password-visibility(); }
                    edited(t) => { root.ssh-password-changed(t); }
                }

                SectionLabel { text: "Colour tag"; }
                SwatchPicker {
                    options: root.form.color-options;
                    selected: root.form.color-index;
                    picked(i) => { root.color-picked(i); }
                }

                SectionLabel { text: "Notes"; }
                TextField {
                    text: root.form.description;
                    placeholder: "Optional";
                    edited(t) => { root.description-changed(t); }
                }

                Rectangle { height: 10px; }
                Toggle {
                    text: "Favourite";
                    checked: root.form.favorite;
                    toggled => { root.toggle-favorite(); }
                }

                if root.errors.length > 0: Rectangle { height: 10px; }
                if root.errors.length > 0: Banner {
                    message: root.errors[0];
                    dismissible: false;
                }

                if root.test-message != "": Rectangle { height: 10px; }
                if root.test-message != "": Banner {
                    message: root.test-message;
                    tone: root.test-ok ? Tone.success : Tone.danger;
                    dismissible: false;
                }
            }
        }

        Rectangle { height: 14px; }
        Divider { }
        Rectangle { height: 12px; }

        HorizontalLayout {
            spacing: 8px;
            Button {
                text: root.testing ? "Testing…" : "Test connection";
                variant: ButtonVariant.secondary;
                enabled: !root.testing && !root.saving;
                clicked => { root.test-connection(); }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                text: "Cancel";
                variant: ButtonVariant.secondary;
                enabled: !root.saving;
                clicked => { root.cancel(); }
            }
            Button {
                text: root.saving ? "Saving…" : "Save";
                variant: ButtonVariant.primary;
                enabled: !root.saving;
                clicked => { root.save(); }
            }
        }
    }
}
