// The visual schema designer, opened over the workspace.
//
// Same arrangement as the ER diagram: all data and intents are in the
// `DesignerState` global and `app.slint` only mounts `DesignerOverlay`. The
// canvas is the shared diagram canvas; to its right a properties panel edits
// the selected table and column. Rust owns the design and its validation
// (`dbhive_ui_model::designer_session`); this file lays it out.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, Tone, ButtonVariant, Button, TextField, Dropdown, Banner, EmptyState, FilterChip, Divider, Card, DataRow, SectionLabel, FormField, KeyTag } from "../kit/kit.slint";
import { DiagramCanvas, DiagramMinimap, DiagramNode, DiagramEdge } from "../components/diagram.slint";

// One column in the selected table's list.
export struct DesignerColumnRow {
    name: string,
    type-label: string,
    // "PK", "FK" or empty.
    badge: string,
    selected: bool,
}

// What happened to one table when the design was applied.
export struct DesignerResultRow {
    name: string,
    // 0 created, 1 failed, 2 skipped.
    state: int,
    message: string,
}

export global DesignerState {
    in-out property <bool> visible: false;

    // The four states: empty (no tables), applying (creating them), a
    // populated canvas, and problems with the design (listed, not hidden).
    in property <bool> empty: true;
    in property <bool> applying: false;
    in property <string> problems;
    in property <string> subtitle;

    in property <[DiagramNode]> nodes;
    in property <[DiagramEdge]> edges;
    in property <float> zoom: 1.0;
    in property <string> zoom-label: "100%";
    in-out property <length> pan-x: 0px;
    in-out property <length> pan-y: 0px;
    in-out property <length> viewport-width: 0px;
    in-out property <length> viewport-height: 0px;
    in property <bool> snap: true;
    in property <float> map-scale: 0.1;
    in property <length> map-origin-x: 0px;
    in property <length> map-origin-y: 0px;
    in property <length> map-width: 180px;
    in property <length> map-height: 120px;

    // The selected table.
    in property <bool> has-selection: false;
    in-out property <string> table-name;
    in-out property <string> table-schema;
    in property <[DesignerColumnRow]> columns;

    // The selected column.
    in property <bool> has-column: false;
    in-out property <string> col-name;
    in property <[string]> type-labels;
    in property <string> col-type-label;
    in property <bool> col-takes-length: false;
    in-out property <string> col-length;
    in property <bool> col-takes-precision: false;
    in-out property <string> col-precision;
    in-out property <string> col-scale;
    in property <bool> col-takes-custom: false;
    in-out property <string> col-custom;
    in-out property <string> col-default;
    in property <bool> col-nullable: true;
    in property <bool> col-pk: false;
    in property <bool> col-unique: false;
    in property <bool> col-auto: false;
    in property <bool> col-can-auto: false;
    in property <bool> col-has-ref: false;
    in property <[string]> ref-table-options;
    in property <string> ref-table-value;
    in property <[string]> ref-column-options;
    in property <string> ref-column-value;
    in property <bool> ref-column-enabled: false;
    in property <[string]> action-labels;
    in property <string> action-label;
    in property <string> ref-problem;

    // Preview and result.
    in-out property <bool> preview-open: false;
    in property <string> preview-sql;
    // Why nothing can be created yet, one problem per line.
    in property <string> preview-problems;
    in property <[DesignerResultRow]> results;
    in property <string> results-summary;
    in property <bool> can-apply: false;
    in property <string> apply-label: "Create tables";

    callback open-requested;
    callback canvas-ready;
    callback close;
    callback open-erd;

    callback add-table;
    callback remove-table;
    callback table-name-edited(string);
    callback table-schema-edited(string);
    callback add-column;
    callback remove-column;
    callback column-selected(int);
    callback col-name-edited(string);
    callback col-type-picked(int);
    callback col-length-edited(string);
    callback col-precision-edited(string);
    callback col-scale-edited(string);
    callback col-custom-edited(string);
    callback col-default-edited(string);
    callback toggle-pk;
    callback toggle-nullable;
    callback toggle-unique;
    callback toggle-auto;
    callback ref-table-picked(int);
    callback ref-column-picked(int);
    callback on-delete-picked(int);

    callback auto-layout;
    callback fit;
    callback zoom-in;
    callback zoom-out;
    callback toggle-snap;
    callback wheel(length, length, length);
    callback node-dragged(int, length, length);
    callback node-clicked(int);
    callback node-released(int);
    callback background-clicked;
    callback minimap-navigate(length, length);

    callback preview;
    callback preview-close;
    callback apply;
}

// The column list of the selected table, and the editor for the chosen one.
component ColumnEditor inherits VerticalLayout {
    spacing: 12px;
    alignment: start;

    HorizontalLayout {
        spacing: 8px;
        TextField {
            horizontal-stretch: 1;
            text <=> DesignerState.col-name;
            placeholder: "column_name";
            edited(t) => { DesignerState.col-name-edited(t); }
        }
        Dropdown {
            width: 150px;
            options: DesignerState.type-labels;
            value: DesignerState.col-type-label;
            selected(i) => { DesignerState.col-type-picked(i); }
        }
    }

    if DesignerState.col-takes-length: FormField {
        label: "Length";
        TextField {
            text <=> DesignerState.col-length;
            edited(t) => { DesignerState.col-length-edited(t); }
        }
    }
    if DesignerState.col-takes-precision: HorizontalLayout {
        spacing: 8px;
        FormField {
            label: "Precision";
            TextField {
                text <=> DesignerState.col-precision;
                edited(t) => { DesignerState.col-precision-edited(t); }
            }
        }
        FormField {
            label: "Scale";
            TextField {
                text <=> DesignerState.col-scale;
                edited(t) => { DesignerState.col-scale-edited(t); }
            }
        }
    }
    if DesignerState.col-takes-custom: FormField {
        label: "Type name";
        TextField {
            text <=> DesignerState.col-custom;
            placeholder: "citext";
            edited(t) => { DesignerState.col-custom-edited(t); }
        }
    }

    HorizontalLayout {
        spacing: 6px;
        alignment: start;
        FilterChip {
            text: "Primary key";
            selected: DesignerState.col-pk;
            clicked => { DesignerState.toggle-pk(); }
        }
        FilterChip {
            text: "Not null";
            selected: !DesignerState.col-nullable;
            clicked => { DesignerState.toggle-nullable(); }
        }
        FilterChip {
            text: "Unique";
            selected: DesignerState.col-unique;
            clicked => { DesignerState.toggle-unique(); }
        }
        if DesignerState.col-can-auto: FilterChip {
            text: "Auto";
            selected: DesignerState.col-auto;
            clicked => { DesignerState.toggle-auto(); }
        }
    }

    FormField {
        label: "Default value";
        TextField {
            text <=> DesignerState.col-default;
            placeholder: "none";
            edited(t) => { DesignerState.col-default-edited(t); }
        }
    }

    FormField {
        label: "References";
        HorizontalLayout {
            spacing: 6px;
            Dropdown {
                horizontal-stretch: 1;
                options: DesignerState.ref-table-options;
                value: DesignerState.ref-table-value;
                selected(i) => { DesignerState.ref-table-picked(i); }
            }
            Dropdown {
                horizontal-stretch: 1;
                enabled: DesignerState.ref-column-enabled;
                options: DesignerState.ref-column-options;
                value: DesignerState.ref-column-value;
                selected(i) => { DesignerState.ref-column-picked(i); }
            }
        }
    }
    if DesignerState.col-has-ref: FormField {
        label: "On delete";
        Dropdown {
            options: DesignerState.action-labels;
            value: DesignerState.action-label;
            selected(i) => { DesignerState.on-delete-picked(i); }
        }
    }
    if DesignerState.ref-problem != "": Text {
        text: DesignerState.ref-problem;
        color: Theme.warning;
        font-size: Theme.size-small;
        wrap: word-wrap;
    }

    HorizontalLayout {
        alignment: start;
        Button {
            text: "Remove column";
            has-icon: true;
            icon: Icons.trash-2;
            variant: ButtonVariant.danger;
            clicked => { DesignerState.remove-column(); }
        }
    }
}

component PropertiesPanel inherits Rectangle {
    background: Theme.card;

    if !DesignerState.has-selection: VerticalLayout {
        alignment: center;
        padding: 24px;
        spacing: 6px;
        Text {
            text: "No table selected";
            color: Theme.foreground;
            font-size: Theme.size-label;
            font-weight: 600;
            horizontal-alignment: center;
        }
        Text {
            text: "Select a table on the canvas to rename it and edit its columns.";
            color: Theme.muted-foreground;
            font-size: Theme.size-small;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    if DesignerState.has-selection: ScrollView {
        VerticalLayout {
            padding: 14px;
            spacing: 12px;
            alignment: start;

            FormField {
                label: "Table name";
                TextField {
                    text <=> DesignerState.table-name;
                    placeholder: "table_name";
                    edited(t) => { DesignerState.table-name-edited(t); }
                }
            }
            FormField {
                label: "Schema (optional)";
                TextField {
                    text <=> DesignerState.table-schema;
                    placeholder: "connection default";
                    edited(t) => { DesignerState.table-schema-edited(t); }
                }
            }

            SectionLabel { text: "COLUMNS (" + DesignerState.columns.length + ")"; }
            Card {
                clip: true;
                VerticalLayout {
                    for col[i] in DesignerState.columns: DataRow {
                        clickable: true;
                        selected: col.selected;
                        min-height: 28px;
                        clicked => { DesignerState.column-selected(i); }
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            KeyTag { text: col.badge; primary: col.badge == "PK"; }
                            Text {
                                text: col.name;
                                color: Theme.foreground;
                                font-size: Theme.size-label;
                                font-weight: col.selected ? 600 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: col.type-label;
                                color: Theme.dim-foreground;
                                font-size: Theme.size-small;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Button {
                    text: "Add column";
                    has-icon: true;
                    icon: Icons.plus;
                    clicked => { DesignerState.add-column(); }
                }
                Button {
                    text: "Delete table";
                    has-icon: true;
                    icon: Icons.trash-2;
                    variant: ButtonVariant.danger;
                    clicked => { DesignerState.remove-table(); }
                }
            }

            if DesignerState.has-column: VerticalLayout {
                spacing: 12px;
                SectionLabel { text: "COLUMN"; }
                Card {
                    ColumnEditor {
                        padding: 12px;
                    }
                }
            }
        }
    }
    Rectangle {
        x: 0;
        width: 1px;
        background: Theme.border;
    }
}

export component DesignerOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.background;

    fs := FocusScope {
        width: parent.width;
        height: parent.height;
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                if (DesignerState.preview-open) {
                    DesignerState.preview-close();
                } else {
                    DesignerState.close();
                }
                return accept;
            }
            return reject;
        }
        init => { self.focus(); }

        VerticalLayout {
            width: parent.width;
            height: parent.height;
            spacing: 0;

            // Title bar.
            Rectangle {
                height: 48px;
                background: Theme.sidebar;
                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 14px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Workspace";
                            has-icon: true;
                            icon: Icons.chevron-left;
                            variant: ButtonVariant.ghost;
                            accessible-label: "Close the designer and return to the workspace";
                            clicked => { DesignerState.close(); }
                        }
                    }
                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: "Schema Designer";
                            color: Theme.foreground;
                            font-size: Theme.size-body;
                            font-weight: 700;
                        }
                        if DesignerState.subtitle != "": Text {
                            text: DesignerState.subtitle;
                            color: Theme.muted-foreground;
                            font-size: Theme.size-small;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "ER diagram";
                            has-icon: true;
                            icon: Icons.workflow;
                            variant: ButtonVariant.ghost;
                            clicked => { DesignerState.open-erd(); }
                        }
                    }
                }
                Divider { y: parent.height - 1px; }
            }

            // Toolbar.
            Rectangle {
                height: 44px;
                background: Theme.background;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Add table";
                            has-icon: true;
                            icon: Icons.plus;
                            enabled: !DesignerState.applying;
                            clicked => { DesignerState.add-table(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        FilterChip {
                            text: "Snap to grid";
                            selected: DesignerState.snap;
                            clicked => { DesignerState.toggle-snap(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Auto layout";
                            has-icon: true;
                            icon: Icons.layout-grid;
                            enabled: !DesignerState.empty;
                            clicked => { DesignerState.auto-layout(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            has-icon: true;
                            icon: Icons.minus;
                            variant: ButtonVariant.ghost;
                            accessible-label: "Zoom out";
                            enabled: !DesignerState.empty;
                            clicked => { DesignerState.zoom-out(); }
                        }
                    }
                    Text {
                        width: 44px;
                        text: DesignerState.empty ? "" : DesignerState.zoom-label;
                        color: Theme.muted-foreground;
                        font-size: Theme.size-label;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            has-icon: true;
                            icon: Icons.plus;
                            variant: ButtonVariant.ghost;
                            accessible-label: "Zoom in";
                            enabled: !DesignerState.empty;
                            clicked => { DesignerState.zoom-in(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Fit";
                            enabled: !DesignerState.empty;
                            clicked => { DesignerState.fit(); }
                        }
                    }
                    Rectangle {
                        width: 1px;
                        background: Theme.border;
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: "Preview SQL";
                            has-icon: true;
                            icon: Icons.code;
                            enabled: !DesignerState.empty && !DesignerState.applying;
                            clicked => { DesignerState.preview(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        Button {
                            text: DesignerState.apply-label;
                            has-icon: true;
                            icon: Icons.play;
                            variant: DesignerState.can-apply ? ButtonVariant.primary : ButtonVariant.secondary;
                            enabled: DesignerState.can-apply && !DesignerState.applying;
                            clicked => { DesignerState.apply(); }
                        }
                    }
                }
                Divider { y: parent.height - 1px; }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0;

                // The canvas, or what stands in for it.
                Rectangle {
                    horizontal-stretch: 1;
                    background: Theme.background;

                    if DesignerState.empty: EmptyState {
                        icon: Icons.workflow;
                        title: "Design tables visually";
                        message: "Add a table, name its columns and link them with foreign keys. Nothing touches your database until you create them.";
                        Button {
                            text: "Add your first table";
                            variant: ButtonVariant.primary;
                            has-icon: true;
                            icon: Icons.plus;
                            clicked => { DesignerState.add-table(); }
                        }
                    }

                    if !DesignerState.empty: Rectangle {
                        canvas := DiagramCanvas {
                            width: parent.width;
                            height: parent.height;
                            nodes: DesignerState.nodes;
                            edges: DesignerState.edges;
                            zoom: DesignerState.zoom;
                            pan-x <=> DesignerState.pan-x;
                            pan-y <=> DesignerState.pan-y;
                            shadows: false;
                            accessible-name: "Schema designer canvas";
                            node-dragged(i, dx, dy) => { DesignerState.node-dragged(i, dx, dy); }
                            node-clicked(i) => { DesignerState.node-clicked(i); }
                            node-released(i) => { DesignerState.node-released(i); }
                            background-clicked => { DesignerState.background-clicked(); }
                            wheel(d, x, y) => { DesignerState.wheel(d, x, y); }
                            init => {
                                DesignerState.viewport-width = self.width;
                                DesignerState.viewport-height = self.height;
                                DesignerState.canvas-ready();
                            }
                            changed width => { DesignerState.viewport-width = self.width; }
                            changed height => { DesignerState.viewport-height = self.height; }
                        }

                        DiagramMinimap {
                            width: DesignerState.map-width;
                            height: DesignerState.map-height;
                            x: parent.width - self.width - 16px;
                            y: parent.height - self.height - 16px;
                            nodes: DesignerState.nodes;
                            pan-x: DesignerState.pan-x;
                            pan-y: DesignerState.pan-y;
                            zoom: DesignerState.zoom;
                            view-width: DesignerState.viewport-width;
                            view-height: DesignerState.viewport-height;
                            scale: DesignerState.map-scale;
                            origin-x: DesignerState.map-origin-x;
                            origin-y: DesignerState.map-origin-y;
                            navigate(x, y) => { DesignerState.minimap-navigate(x, y); }
                        }

                        if DesignerState.problems != "": Banner {
                            x: 16px;
                            y: 12px;
                            width: min(parent.width - 32px, 560px);
                            height: self.preferred-height;
                            message: DesignerState.problems;
                            tone: Tone.warning;
                            dismissible: false;
                        }

                        if DesignerState.applying: Rectangle {
                            background: Theme.background.transparentize(0.35);
                            TouchArea { }
                            VerticalLayout {
                                alignment: center;
                                spacing: 10px;
                                HorizontalLayout {
                                    alignment: center;
                                    Icon { source: Icons.refresh-cw; tint: Theme.primary; width: 22px; height: 22px; }
                                }
                                Text {
                                    text: "Creating tables";
                                    color: Theme.muted-foreground;
                                    font-size: Theme.size-label;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }

                    // Preview and result.
                    if DesignerState.preview-open: Rectangle {
                        background: Theme.background.transparentize(0.25);
                        TouchArea {
                            clicked => { DesignerState.preview-close(); }
                        }
                        Card {
                            width: min(680px, parent.width - 48px);
                            height: min(540px, parent.height - 48px);
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            background: Theme.popover;
                            border-color: Theme.border-strong;
                            TouchArea { }
                            VerticalLayout {
                                padding: 16px;
                                spacing: 10px;
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        horizontal-stretch: 1;
                                        text: DesignerState.results.length > 0 ? "Result" : "Preview SQL";
                                        color: Theme.foreground;
                                        font-size: Theme.size-subheading;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Button {
                                        has-icon: true;
                                        icon: Icons.x;
                                        variant: ButtonVariant.ghost;
                                        accessible-label: "Close";
                                        clicked => { DesignerState.preview-close(); }
                                    }
                                }
                                if DesignerState.preview-problems != "": Banner {
                                    message: DesignerState.preview-problems;
                                    tone: Tone.warning;
                                    dismissible: false;
                                }
                                if DesignerState.results.length > 0: VerticalLayout {
                                    spacing: 6px;
                                    Text {
                                        text: DesignerState.results-summary;
                                        color: Theme.muted-foreground;
                                        font-size: Theme.size-label;
                                    }
                                    for r in DesignerState.results: DataRow {
                                        min-height: 28px;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                Icon {
                                                    source: r.state == 0 ? Icons.circle-check : r.state == 1 ? Icons.triangle-alert : Icons.circle;
                                                    tint: r.state == 0 ? Theme.success : r.state == 1 ? Theme.destructive : Theme.dim-foreground;
                                                    width: 14px;
                                                    height: 14px;
                                                }
                                            }
                                            Text {
                                                text: r.name;
                                                color: Theme.foreground;
                                                font-size: Theme.size-label;
                                                font-weight: 600;
                                                vertical-alignment: center;
                                            }
                                            Text {
                                                horizontal-stretch: 1;
                                                text: r.message;
                                                color: r.state == 1 ? Theme.destructive : Theme.muted-foreground;
                                                font-size: Theme.size-small;
                                                vertical-alignment: center;
                                                overflow: elide;
                                            }
                                        }
                                    }
                                }
                                if DesignerState.preview-sql != "": Rectangle {
                                    vertical-stretch: 1;
                                    background: Theme.background;
                                    border-radius: Theme.radius-control;
                                    border-width: 1px;
                                    border-color: Theme.border;
                                    clip: true;
                                    ScrollView {
                                        VerticalLayout {
                                            padding: 12px;
                                            alignment: start;
                                            TextInput {
                                                text: DesignerState.preview-sql;
                                                read-only: true;
                                                wrap: word-wrap;
                                                color: Theme.foreground;
                                                font-family: "Menlo";
                                                font-size: Theme.size-mono;
                                                selection-background-color: Theme.primary.transparentize(0.65);
                                                accessible-label: "Generated SQL";
                                            }
                                        }
                                    }
                                }
                                if DesignerState.preview-sql == "": Rectangle { vertical-stretch: 1; }
                                HorizontalLayout {
                                    spacing: 8px;
                                    alignment: end;
                                    Button {
                                        text: "Close";
                                        clicked => { DesignerState.preview-close(); }
                                    }
                                    Button {
                                        text: DesignerState.apply-label;
                                        variant: ButtonVariant.primary;
                                        enabled: DesignerState.can-apply && !DesignerState.applying;
                                        clicked => { DesignerState.apply(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Properties.
                PropertiesPanel {
                    width: 340px;
                }
            }
        }
    }
}
