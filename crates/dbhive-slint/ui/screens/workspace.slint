import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Tone, ButtonVariant, Button, TextField, Divider, ListRow, Banner, EmptyState, TabBar, TabInfo } from "../kit/kit.slint";
import { ResultsGrid, GridColumn, GridRow } from "../components/results_grid.slint";
import { SqlEditor, HighlightLine, CompletionItem, EditorPrefs } from "../components/sql_editor.slint";
import { TableInspectorView } from "table_inspector.slint";
import { BuilderState } from "query_builder.slint";
import { TableDialogState } from "table_dialog.slint";
import { PluginsState, PluginToolbarHost } from "plugins_panel.slint";
import { AiState, AiDock } from "ai_assistant.slint";
import { ResultsState, ResultsModeBar, ResultsViewPane, ResultsErrorPanel } from "results_tools.slint";
import { QueryState } from "query_tabs.slint";
import { SchemaTreePanel, TreeState, TreeDropZone } from "schema_tree.slint";

export struct TableItem {
    name: string,
    // Preformatted ("~1,234 rows"), empty when the driver reports nothing.
    row-count: string,
}

// The connected workspace: a table list down the side, and on the right a row
// of tabs. A tab is either a query (editor above its results) or a preview of
// one table. Rust owns every tab's state; this file draws the active one and
// reports intents.
export component WorkspaceScreen inherits VerticalLayout {
    in property <string> connection-name;
    // e.g. "app · public", blank on a driver with no separate database.
    in property <string> location-label;
    in property <[TableItem]> tables;
    // The table whose preview tab is active, for highlighting it in the list.
    in property <string> selected-table;
    in property <bool> loading-tables;
    in property <string> tables-error;

    in property <[TabInfo]> tabs;
    in property <int> active-tab: -1;
    in property <bool> active-is-query;
    in-out property <string> editor-text;
    in property <[HighlightLine]> editor-lines;
    // Autocomplete: the rows, which one is selected, and a caret position to
    // jump to once a completion has been applied.
    in property <[CompletionItem]> completions;
    in property <int> completion-selected;
    in-out property <int> editor-pending-cursor: -1;
    // The active tab has a query in flight.
    in property <bool> running;
    in property <string> rows-error;
    // "Results" for a query tab, the table's name for a table tab.
    in property <string> result-title;
    // "8 rows · 12ms".
    in property <string> result-summary;
    // Set instead of a grid when a statement changed data rather than
    // returning rows ("3 rows affected").
    in property <string> result-message;
    in property <bool> has-result;
    in-out property <string> filter;

    in property <[GridColumn]> columns;
    in property <[GridRow]> rows;
    in property <length> grid-width;
    in property <int> row-count;
    in property <int> visible-row-count;

    callback back;
    callback refresh-tables;
    callback select-table(string);
    callback filter-changed(string);
    callback header-clicked(int);
    callback tab-selected(int);
    callback tab-closed(int);
    callback new-query;
    callback editor-edited(string);
    callback cursor-moved(int);
    callback completion-move(int);
    callback completion-accept;
    callback completion-dismiss;
    callback completion-picked(int);
    callback run-query;
    callback retry;
    callback open-history;
    callback open-activity;
    callback open-migrations;
    callback open-diagram;

    spacing: 0;

    Rectangle {
        height: 48px;
        background: Theme.sidebar;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 14px;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Connections";
                    has-icon: true;
                    icon: Icons.chevron-left;
                    variant: ButtonVariant.ghost;
                    clicked => { root.back(); }
                }
            }
            Rectangle {
                width: 1px;
                background: Theme.border;
            }
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: root.connection-name;
                    color: Theme.foreground;
                    font-size: Theme.size-body;
                    font-weight: 700;
                }
                if root.location-label != "": Text {
                    text: root.location-label;
                    color: Theme.muted-foreground;
                    font-size: Theme.size-small;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            // Toolbar buttons enabled plugins registered, then the manager.
            PluginToolbarHost { }
            VerticalLayout {
                alignment: center;
                Button {
                    has-icon: true;
                    icon: Icons.plug;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Plugins";
                    clicked => { PluginsState.open-requested(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Builder";
                    has-icon: true;
                    icon: Icons.workflow;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Visual query builder";
                    clicked => { BuilderState.open-requested(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "AI";
                    has-icon: true;
                    icon: Icons.sparkles;
                    variant: AiState.visible ? ButtonVariant.secondary : ButtonVariant.ghost;
                    accessible-label: "AI assistant";
                    clicked => {
                        if (AiState.visible) {
                            AiState.close();
                        } else {
                            AiState.open-requested();
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "History";
                    has-icon: true;
                    icon: Icons.history;
                    variant: ButtonVariant.ghost;
                    accessible-label: "History, snippets and templates";
                    clicked => { root.open-history(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Activity";
                    has-icon: true;
                    icon: Icons.activity;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Activity monitor";
                    clicked => { root.open-activity(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Migrations";
                    has-icon: true;
                    icon: Icons.git-compare;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Schema migrations";
                    clicked => { root.open-migrations(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Diagram";
                    has-icon: true;
                    icon: Icons.workflow;
                    variant: ButtonVariant.ghost;
                    enabled: !root.loading-tables && root.tables-error == "";
                    accessible-label: "ER diagram of this schema";
                    clicked => { root.open-diagram(); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    has-icon: true;
                    icon: Icons.refresh-cw;
                    variant: ButtonVariant.ghost;
                    enabled: !root.loading-tables;
                    clicked => { root.refresh-tables(); }
                }
            }
        }
        Divider { y: parent.height - 1px; }
    }

    HorizontalLayout {
        vertical-stretch: 1;
        spacing: 0;

        // The schema browser: databases, schemas and tables. Its state is
        // `TreeState`, so this screen passes it nothing.
        SchemaTreePanel {
            width: 264px;
        }

        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 0;

            TabBar {
                tabs: root.tabs;
                active: root.active-tab;
                focus-tick: QueryState.bar-focus-tick;
                selected(i) => { root.tab-selected(i); }
                closed(i) => { root.tab-closed(i); }
                add => { root.new-query(); }
                context(i, x, y) => { QueryState.tab-context(i, x, y); }
                navigate(key) => { QueryState.tab-navigate(key); }
            }

            if root.tabs.length == 0: EmptyState {
                vertical-stretch: 1;
                icon: Icons.code;
                title: "Nothing open";
                message: "Pick a table to preview it, or start a new query.";
                Button {
                    text: "New query";
                    variant: ButtonVariant.primary;
                    has-icon: true;
                    icon: Icons.plus;
                    clicked => { root.new-query(); }
                }
            }

            if root.tabs.length > 0 && root.active-is-query: VerticalLayout {
                vertical-stretch: 1;
                padding: 14px;
                spacing: 10px;

                if root.active-is-query: Rectangle {
                    height: 220px;
                    min-width: 0px;
                    FocusScope {
                        // Cmd+Enter on macOS, Ctrl+Enter elsewhere. Slint maps
                        // the two differently per platform, so accept both.
                        capture-key-pressed(event) => {
                            // With the completion list open, these keys drive
                            // it instead of the text.
                            if (root.completions.length > 0 && !event.modifiers.control
                                && !event.modifiers.meta && !event.modifiers.alt) {
                                if (event.text == Key.DownArrow) {
                                    root.completion-move(1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.completion-move(-1);
                                    return accept;
                                }
                                if (event.text == Key.Return || event.text == Key.Tab) {
                                    root.completion-accept();
                                    return accept;
                                }
                                if (event.text == Key.Escape) {
                                    root.completion-dismiss();
                                    return accept;
                                }
                            }
                            if ((event.modifiers.control || event.modifiers.meta) && event.text == Key.Return) {
                                if (!root.running) {
                                    root.run-query();
                                }
                                return accept;
                            }
                            // Ctrl+Tab and Ctrl+Shift+Tab switch tabs; the text
                            // box would otherwise take the Tab.
                            if ((event.modifiers.control || event.modifiers.meta) && event.text == Key.Tab) {
                                QueryState.tab-navigate(event.modifiers.shift ? "prev" : "next");
                                return accept;
                            }
                            if ((event.modifiers.control || event.modifiers.meta) && event.text == Key.Backtab) {
                                QueryState.tab-navigate("prev");
                                return accept;
                            }
                            return reject;
                        }
                        SqlEditor {
                            text <=> root.editor-text;
                            lines: root.editor-lines;
                            completions: root.completions;
                            completion-selected: root.completion-selected;
                            pending-cursor <=> root.editor-pending-cursor;
                            // A running statement is not edited under it.
                            read-only: root.running;
                            wrap: EditorPrefs.word-wrap;
                            minimap: EditorPrefs.minimap;
                            wrap-columns-changed(n) => { EditorPrefs.wrap-columns-changed(n); }
                            init => { EditorPrefs.wrap-columns-changed(self.wrap-columns); }
                            edited(t) => { root.editor-edited(t); }
                            cursor-moved(o) => {
                                TreeState.editor-caret = o;
                                root.cursor-moved(o);
                            }
                            completion-picked(i) => { root.completion-picked(i); }
                        }
                    }
                    // Where a table dragged from the schema tree lands.
                    TreeDropZone { }
                }

                if root.active-is-query: HorizontalLayout {
                    spacing: 10px;
                    if !root.running: Button {
                        text: "Run";
                        variant: ButtonVariant.primary;
                        has-icon: true;
                        icon: Icons.play;
                        enabled: root.editor-text != "";
                        clicked => { root.run-query(); }
                    }
                    // Stop replaces Run while the tab's query is in flight.
                    if root.running: Button {
                        text: "Stop";
                        has-icon: true;
                        icon: Icons.square;
                        accessible-label: "Stop the running query";
                        clicked => { QueryState.stop(); }
                    }
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: root.running ? "Running…" : "⌘/Ctrl + Enter";
                            color: root.running ? Theme.muted-foreground : Theme.dim-foreground;
                            font-size: Theme.size-small;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Clear";
                        variant: ButtonVariant.ghost;
                        enabled: !root.running && root.editor-text != "";
                        accessible-label: "Clear the editor";
                        clicked => { QueryState.clear-editor(); }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: root.result-title;
                        color: Theme.foreground;
                        font-size: Theme.size-subheading;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    if QueryState.cancelled && !root.running: Text {
                        text: QueryState.cancelled-summary;
                        color: Theme.muted-foreground;
                        font-size: Theme.size-small;
                        vertical-alignment: center;
                    }
                    if root.has-result && root.result-summary != "" && root.result-message == "": Text {
                        text: root.visible-row-count == root.row-count
                            ? root.result-summary
                            : root.visible-row-count + " of " + root.result-summary;
                        color: Theme.muted-foreground;
                        font-size: Theme.size-small;
                        vertical-alignment: center;
                    }
                    // Table / JSON / Text and Export.
                    if root.has-result && root.result-message == "" && root.rows-error == "": ResultsModeBar { }
                    if root.has-result && root.result-message == "": TextField {
                        width: 220px;
                        has-icon: true;
                        icon: Icons.search;
                        placeholder: "Filter rows";
                        text <=> root.filter;
                        edited(t) => { root.filter-changed(t); }
                    }
                }

                // A failed query: headline, the driver's message, the query
                // behind a disclosure, Copy and Retry.
                if root.rows-error != "" && !QueryState.cancelled: ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        alignment: start;
                        ResultsErrorPanel { }
                    }
                }

                if root.running: Text {
                    vertical-stretch: 1;
                    text: "Running…";
                    color: Theme.muted-foreground;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                if !root.running && root.rows-error == "" && !root.has-result && root.active-is-query && !QueryState.cancelled: EmptyState {
                    vertical-stretch: 1;
                    icon: Icons.play;
                    title: "Run a query";
                    message: "Write SQL above and press Run to see results here.";
                }

                // Stopped by the user: not an error, so no red panel.
                if !root.running && QueryState.cancelled: EmptyState {
                    vertical-stretch: 1;
                    icon: Icons.square;
                    title: "Query cancelled";
                    message: QueryState.server-stops
                        ? "The statement was stopped on the database. Run it again to see results."
                        : "DB Hive stopped waiting for it. The server may still finish the statement on its own.";
                    Button {
                        text: "Run again";
                        has-icon: true;
                        icon: Icons.play;
                        enabled: root.editor-text != "";
                        clicked => { root.run-query(); }
                    }
                }

                if !root.running && root.result-message != "": Banner {
                    message: root.result-message;
                    tone: Tone.success;
                    dismissible: false;
                }

                // The selected cell and what can be copied from it.
                if !root.running && root.rows-error == "" && root.has-result && root.result-message == "" && root.visible-row-count > 0 && ResultsState.mode == 0 && QueryState.selected-row >= 0: HorizontalLayout {
                    spacing: 8px;
                    VerticalLayout {
                        alignment: center;
                        Text {
                            text: QueryState.selection-label;
                            color: Theme.muted-foreground;
                            font-size: Theme.size-small;
                            overflow: elide;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: "Copy cell";
                        has-icon: true;
                        icon: Icons.copy;
                        variant: ButtonVariant.ghost;
                        clicked => { QueryState.copy-cell(); }
                    }
                    Button {
                        text: "Copy row";
                        variant: ButtonVariant.ghost;
                        accessible-label: "Copy row as tab-separated values";
                        clicked => { QueryState.copy-row(); }
                    }
                    Button {
                        text: "Copy column";
                        variant: ButtonVariant.ghost;
                        clicked => { QueryState.copy-column(); }
                    }
                    Button {
                        has-icon: true;
                        icon: Icons.x;
                        variant: ButtonVariant.ghost;
                        accessible-label: "Clear selection";
                        clicked => { QueryState.clear-selection(); }
                    }
                }

                if !root.running && root.rows-error == "" && root.has-result && root.result-message == "" && root.visible-row-count > 0 && ResultsState.mode == 0: ResultsGrid {
                    vertical-stretch: 1;
                    columns: root.columns;
                    rows: root.rows;
                    total-width: root.grid-width;
                    row-numbers: true;
                    controlled: true;
                    selected-row: QueryState.selected-row;
                    selected-col: QueryState.selected-col;
                    header-clicked(i) => { root.header-clicked(i); }
                    cell-clicked(r, c) => { QueryState.cell-clicked(r, c); }
                }

                // The same rows as pretty JSON or aligned text.
                if !root.running && root.rows-error == "" && root.has-result && root.result-message == "" && root.visible-row-count > 0 && ResultsState.mode != 0: ResultsViewPane {
                    vertical-stretch: 1;
                }

                // The query ran and returned nothing, or the filter hides it all.
                if !root.running && root.rows-error == "" && root.has-result && root.result-message == "" && root.row-count == 0: EmptyState {
                    vertical-stretch: 1;
                    icon: Icons.table;
                    title: "No rows returned";
                    message: "The query ran without error but matched no rows. The column headers can still be exported.";
                }

                if !root.running && root.rows-error == "" && root.has-result && root.result-message == "" && root.row-count > 0 && root.visible-row-count == 0: VerticalLayout {
                    // Compact, so the button still fits in a short window.
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 6px;
                    Text {
                        text: "No rows match the filter";
                        color: Theme.foreground;
                        font-size: Theme.size-subheading;
                        font-weight: 600;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "None of the " + root.row-count + " rows in this result contain \"" + root.filter + "\".";
                        color: Theme.muted-foreground;
                        font-size: Theme.size-small;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Button {
                            text: "Clear filter";
                            clicked => {
                                root.filter = "";
                                root.filter-changed("");
                            }
                        }
                    }
                }

                // A tab with a Banner or message but no grid would otherwise
                // let the layout spread its slack as gaps; this takes it.
                if !root.running && root.result-message != "": Rectangle {
                    vertical-stretch: 1;
                }
            }

            // A table tab is the table inspector: Data and Structure views.
            if root.tabs.length > 0 && !root.active-is-query: TableInspectorView {
                vertical-stretch: 1;
                columns: root.columns;
                rows: root.rows;
                grid-width: root.grid-width;
                running: root.running;
                rows-error: root.rows-error;
                has-result: root.has-result;
            }
        }

        // The assistant, beside the editor and results it works on. It sits
        // below the header, so the header keeps its full width.
        if AiState.visible: AiDock {
            width: min(400px, root.width * 0.4);
        }
    }
}
