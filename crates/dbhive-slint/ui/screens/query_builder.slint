// The visual query builder, opened over the workspace.
//
// Every row and intent lives in the `BuilderState` global, so `app.slint` only
// mounts `BuilderOverlay` and the controller reaches it through
// `window.global::<BuilderState>()`. Rust decides what every row says
// (`dbhive_ui_model::builder_editor`); this file lays it out. Every edit is
// one callback, `act(action, row, choice, text)`, which the model understands.

import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Icon, Tone, ButtonVariant, Button, TextField, Dropdown, Toggle, Divider, Banner, EmptyState, ListRow, FilterChip, Badge, SectionLabel, CollapseHeader, CheckBox, VDivider } from "../kit/kit.slint";
import { SqlEditor, HighlightLine } from "../components/sql_editor.slint";

export struct QbSection {
    title: string,
    open: bool,
    count: int,
}

// A table in the query, with the columns a picker can offer from it.
export struct QbSource {
    alias: string,
    columns: [string],
    // `columns` with "All columns (*)" first, for the add-column picker.
    star-columns: [string],
}

export struct QbAdded {
    alias: string,
    detail: string,
}

export struct QbJoin {
    type-label: string,
    type-index: int,
    left-alias: string,
    left-alias-index: int,
    left-column: string,
    left-column-index: int,
    right-alias: string,
    right-alias-index: int,
    right-column: string,
    right-column-index: int,
    takes-on: bool,
    warning: string,
    incomplete: bool,
}

export struct QbColumn {
    label: string,
    aggregate: string,
    alias: string,
    distinct: bool,
    distinct-enabled: bool,
}

// One row of the WHERE tree: a group header (kind 0) or a condition (kind 1).
export struct QbFilter {
    kind: int,
    depth: int,
    group-operator: string,
    can-nest: bool,
    is-root: bool,
    alias: string,
    alias-index: int,
    column: string,
    column-index: int,
    op-label: string,
    ops: [string],
    // 0 no value, 1 one, 2 range, 3 list.
    arity: int,
    is-bool: bool,
    value: string,
    value2: string,
    placeholder: string,
    hint: string,
}

export struct QbHaving {
    aggregate: string,
    alias: string,
    alias-index: int,
    column: string,
    column-index: int,
    op-label: string,
    value: string,
    hint: string,
}

export struct QbOrder {
    label: string,
    descending: bool,
}

export global BuilderState {
    in-out property <bool> visible: false;
    // "Production Postgres / app".
    in property <string> scope-label;
    // The workspace's table list is still loading.
    in property <bool> loading: false;
    // A failed column read, with a way to try again.
    in property <string> error;
    in property <bool> error-retry: false;
    // "Reading columns of orders...", blank when idle.
    in property <string> pending-note;

    in property <[QbSection]> sections;
    in property <[QbSource]> sources;
    // The aliases of `sources`, as the plain list a table picker takes.
    in property <[string]> aliases;

    in property <[string]> catalog;
    in property <bool> catalog-truncated: false;
    in-out property <string> table-search;
    in property <[QbAdded]> added;

    in property <[QbJoin]> joins;
    in property <[string]> join-types;
    in property <[string]> join-suggestions;

    in property <bool> query-distinct: false;
    in property <[QbColumn]> columns;
    in property <[string]> aggregates;

    in property <[QbFilter]> filters;

    in property <[string]> group-by;
    in property <[QbHaving]> having;
    in property <[string]> having-aggregates;
    in property <[string]> having-ops;
    in property <[string]> group-issues;

    in property <[QbOrder]> order-by;

    in-out property <string> limit-text;
    in-out property <string> offset-text;
    in property <string> limit-error;
    in property <string> offset-error;
    in property <string> pagination;

    in property <string> sql;
    in property <[HighlightLine]> sql-lines;
    in property <[string]> warnings;
    // The statement can be sent to a tab.
    in property <bool> can-use: false;

    // The workspace header or the View menu asked for the builder; the
    // controller fills it and sets `visible`.
    callback open-requested;
    callback close;
    callback retry;
    callback dismiss-error;
    callback add-table(string);
    // action, row, choice, typed text. See `builder_editor::BuilderEditor::apply`.
    callback act(string, int, int, string);
    callback copy-sql;
    callback use-sql;
    callback run-sql;
}

// -- Pieces ---------------------------------------------------------------------

// Pick a table, then one of its columns; picking the column adds it.
component ColumnPicker inherits HorizontalLayout {
    in property <string> placeholder: "Add column";
    // Offer "All columns (*)" first.
    in property <bool> star: false;
    callback picked(int, int);

    property <int> table-index: 0;
    property <int> ti: BuilderState.sources.length == 0 ? 0 : max(0, min(root.table-index, BuilderState.sources.length - 1));

    spacing: 6px;
    alignment: start;
    height: 32px;

    Dropdown {
        width: 112px;
        enabled: BuilderState.sources.length > 0;
        options: BuilderState.aliases;
        value: BuilderState.sources.length == 0 ? "No table" : BuilderState.sources[root.ti].alias;
        selected(i) => { root.table-index = i; }
    }
    Dropdown {
        width: 180px;
        enabled: BuilderState.sources.length > 0;
        options: root.star ? BuilderState.sources[root.ti].star-columns : BuilderState.sources[root.ti].columns;
        value: root.placeholder + "…";
        selected(j) => { root.picked(root.ti, j); }
    }
}

component RemoveButton inherits Button {
    has-icon: true;
    icon: Icons.x;
    variant: ButtonVariant.ghost;
    accessible-label: "Remove";
}

component Hint inherits Text {
    color: Theme.muted-foreground;
    font-size: Theme.size-small;
    wrap: word-wrap;
}

component WarnText inherits HorizontalLayout {
    in property <string> text;
    spacing: 6px;
    VerticalLayout {
        alignment: start;
        padding-top: 1px;
        Icon { source: Icons.triangle-alert; tint: Theme.warning; width: 13px; height: 13px; }
    }
    Text {
        text: root.text;
        color: Theme.warning;
        font-size: Theme.size-small;
        wrap: word-wrap;
        horizontal-stretch: 1;
    }
}

// -- Sections -------------------------------------------------------------------

component TablesSection inherits VerticalLayout {
    spacing: 8px;

    TextField {
        has-icon: true;
        icon: Icons.search;
        placeholder: "Search tables to add";
        text <=> BuilderState.table-search;
        edited(t) => { BuilderState.act("table-search", 0, 0, t); }
    }

    if BuilderState.loading: Hint { text: "Loading tables…"; }
    if !BuilderState.loading && BuilderState.catalog.length == 0: Hint {
        text: BuilderState.table-search == "" ? "This schema has no tables." : "No table matches the search.";
    }
    if !BuilderState.loading && BuilderState.catalog.length > 0: Rectangle {
        height: min(132px, BuilderState.catalog.length * 28px + 4px);
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-control;
        clip: true;
        ScrollView {
            VerticalLayout {
                alignment: start;
                padding: 2px;
                for name in BuilderState.catalog: ListRow {
                    height: 28px;
                    icon: Icons.table;
                    text: name;
                    detail: "Add";
                    clicked => { BuilderState.add-table(name); }
                }
            }
        }
    }
    if BuilderState.catalog-truncated: Hint { text: "Showing the first matches. Type to narrow the list."; }

    if BuilderState.pending-note != "": Hint { text: BuilderState.pending-note; }

    if BuilderState.added.length == 0 && BuilderState.pending-note == "": Hint {
        text: "Click a table to add it. Add the same table twice to join it to itself.";
    }
    for t[i] in BuilderState.added: Rectangle {
        height: 30px;
        border-radius: Theme.radius-control;
        background: Theme.secondary;
        HorizontalLayout {
            padding-left: 10px;
            padding-right: 4px;
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                Icon { source: Icons.table; tint: Theme.primary; width: 14px; height: 14px; }
            }
            Text {
                text: t.alias;
                color: Theme.foreground;
                font-size: Theme.size-label;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: t.detail;
                color: Theme.muted-foreground;
                font-size: Theme.size-small;
                vertical-alignment: center;
                overflow: elide;
                horizontal-stretch: 1;
            }
            VerticalLayout {
                alignment: center;
                RemoveButton {
                    accessible-label: "Remove " + t.alias + " and everything that uses it";
                    clicked => { BuilderState.act("table-remove", i, 0, ""); }
                }
            }
        }
    }
}

component JoinCard inherits Rectangle {
    in property <QbJoin> j;
    in property <int> index;

    border-radius: Theme.radius-control;
    border-width: 1px;
    border-color: root.j.incomplete ? Theme.warning.transparentize(0.5) : Theme.border;
    background: Theme.card;

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 6px;
            Dropdown {
                width: 120px;
                options: BuilderState.join-types;
                value: root.j.type-label + " JOIN";
                selected(k) => { BuilderState.act("join-type", root.index, k, ""); }
            }
            if !root.j.takes-on: Text {
                text: "no condition";
                color: Theme.muted-foreground;
                font-size: Theme.size-small;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            RemoveButton { clicked => { BuilderState.act("join-remove", root.index, 0, ""); } }
        }
        if root.j.takes-on: HorizontalLayout {
            spacing: 6px;
            Dropdown {
                width: 104px;
                options: BuilderState.aliases;
                value: root.j.left-alias;
                selected(k) => { BuilderState.act("join-lt", root.index, k, ""); }
            }
            Dropdown {
                width: 108px;
                options: BuilderState.sources[root.j.left-alias-index].columns;
                value: root.j.left-column;
                selected(k) => { BuilderState.act("join-lc", root.index, k, ""); }
            }
            Text {
                text: "=";
                color: Theme.muted-foreground;
                font-size: Theme.size-label;
                vertical-alignment: center;
            }
            Dropdown {
                width: 104px;
                options: BuilderState.aliases;
                value: root.j.right-alias;
                selected(k) => { BuilderState.act("join-rt", root.index, k, ""); }
            }
            Dropdown {
                width: 108px;
                options: BuilderState.sources[root.j.right-alias-index].columns;
                value: root.j.right-column;
                selected(k) => { BuilderState.act("join-rc", root.index, k, ""); }
            }
        }
        if !root.j.takes-on: HorizontalLayout {
            spacing: 6px;
            Text {
                text: "with";
                color: Theme.muted-foreground;
                font-size: Theme.size-label;
                vertical-alignment: center;
            }
            Dropdown {
                width: 120px;
                options: BuilderState.aliases;
                value: root.j.right-alias;
                selected(k) => { BuilderState.act("join-rt", root.index, k, ""); }
            }
        }
        if root.j.warning != "": WarnText { text: root.j.warning; }
        if root.j.incomplete && root.j.takes-on: Hint { text: "Pick a column on each side. Until then this join is left out."; }
    }
}

component JoinsSection inherits VerticalLayout {
    spacing: 8px;

    if BuilderState.sources.length < 2: Hint { text: "Add a second table to join them."; }

    if BuilderState.join-suggestions.length > 0: VerticalLayout {
        spacing: 4px;
        Hint { text: "Suggested from foreign keys"; }
        for s[i] in BuilderState.join-suggestions: Rectangle {
            height: 30px;
            border-radius: Theme.radius-control;
            background: sug-touch.has-hover ? Theme.hover : Theme.primary-soft;
            sug-touch := TouchArea {
                mouse-cursor: pointer;
                clicked => { BuilderState.act("join-suggest", i, 0, ""); }
            }
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon { source: Icons.link; tint: Theme.primary; width: 14px; height: 14px; }
                }
                Text {
                    text: s;
                    color: Theme.foreground;
                    font-size: Theme.size-mono;
                    font-family: "Menlo";
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "Use";
                    color: Theme.primary;
                    font-size: Theme.size-small;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
    }

    for j[i] in BuilderState.joins: JoinCard { j: j; index: i; }

    HorizontalLayout {
        alignment: start;
        Button {
            text: "Add join";
            has-icon: true;
            icon: Icons.plus;
            enabled: BuilderState.sources.length >= 2;
            clicked => { BuilderState.act("join-add", 0, 0, ""); }
        }
    }
}

component ColumnsSection inherits VerticalLayout {
    spacing: 8px;

    Toggle {
        text: "Distinct rows only";
        checked: BuilderState.query-distinct;
        toggled => { BuilderState.act("distinct", 0, 0, ""); }
    }
    ColumnPicker {
        star: true;
        placeholder: "Add column";
        picked(t, c) => { BuilderState.act("col-add", t, c, ""); }
    }
    if BuilderState.columns.length == 0: Hint {
        text: BuilderState.sources.length == 0
            ? "Nothing picked. Once a table is added the query selects every column."
            : "No column picked, so the query selects every column (SELECT *).";
    }
    for c[i] in BuilderState.columns: HorizontalLayout {
        height: 32px;
        spacing: 6px;
        Text {
            text: c.label;
            width: 130px;
            color: Theme.foreground;
            font-size: Theme.size-mono;
            font-family: "Menlo";
            vertical-alignment: center;
            overflow: elide;
        }
        Dropdown {
            width: 130px;
            options: BuilderState.aggregates;
            value: c.aggregate;
            selected(k) => { BuilderState.act("col-agg", i, k, ""); }
        }
        TextField {
            horizontal-stretch: 1;
            min-width: 80px;
            placeholder: "Output name";
            text: c.alias;
            edited(t) => { BuilderState.act("col-alias", i, 0, t); }
        }
        VerticalLayout {
            alignment: center;
            CheckBox {
                text: "Distinct";
                checked: c.distinct;
                enabled: c.distinct-enabled;
                toggled => { BuilderState.act("col-distinct", i, 0, ""); }
            }
        }
        RemoveButton { accessible-label: "Remove column"; clicked => { BuilderState.act("col-remove", i, 0, ""); } }
    }
}

component FilterRow inherits VerticalLayout {
    in property <QbFilter> f;
    in property <int> index;

    spacing: 2px;

    if root.f.kind == 0: Rectangle {
        height: 36px;
        border-radius: Theme.radius-control;
        background: Theme.secondary;
        HorizontalLayout {
            padding-left: 8px + root.f.depth * 18px;
            padding-right: 4px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                Button {
                    text: root.f.group-operator == "AND" ? "All of (AND)" : "Any of (OR)";
                    variant: ButtonVariant.ghost;
                    accessible-label: "Switch between AND and OR";
                    clicked => { BuilderState.act("f-op", root.index, 0, ""); }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Condition";
                    has-icon: true;
                    icon: Icons.plus;
                    variant: ButtonVariant.ghost;
                    enabled: BuilderState.sources.length > 0;
                    clicked => { BuilderState.act("f-cond-add", root.index, 0, ""); }
                }
            }
            if root.f.can-nest: VerticalLayout {
                alignment: center;
                Button {
                    text: "Group";
                    has-icon: true;
                    icon: Icons.plus;
                    variant: ButtonVariant.ghost;
                    clicked => { BuilderState.act("f-group-add", root.index, 0, ""); }
                }
            }
            if !root.f.can-nest: VerticalLayout {
                alignment: center;
                Text {
                    text: "Deepest level";
                    color: Theme.dim-foreground;
                    font-size: Theme.size-small;
                }
            }
            VerticalLayout {
                alignment: center;
                RemoveButton {
                    accessible-label: root.f.is-root ? "Clear all conditions" : "Remove this group";
                    clicked => { BuilderState.act("f-remove", root.index, 0, ""); }
                }
            }
        }
    }

    if root.f.kind == 1: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            height: 32px;
            padding-left: 8px + root.f.depth * 18px;
            spacing: 6px;
            Dropdown {
                width: 104px;
                options: BuilderState.aliases;
                value: root.f.alias;
                selected(k) => { BuilderState.act("f-alias", root.index, k, ""); }
            }
            Dropdown {
                width: 108px;
                options: BuilderState.sources[root.f.alias-index].columns;
                value: root.f.column;
                selected(k) => { BuilderState.act("f-col", root.index, k, ""); }
            }
            Dropdown {
                width: 88px;
                options: root.f.ops;
                value: root.f.op-label;
                selected(k) => { BuilderState.act("f-cmp", root.index, k, ""); }
            }
            if root.f.arity == 0: Text {
                text: "no value needed";
                color: Theme.dim-foreground;
                font-size: Theme.size-small;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.f.arity == 1 && root.f.is-bool: Dropdown {
                width: 100px;
                options: ["true", "false"];
                value: root.f.value == "" ? "Choose…" : root.f.value;
                selected(k) => { BuilderState.act("f-bool", root.index, k, ""); }
            }
            if root.f.arity == 1 && !root.f.is-bool: TextField {
                horizontal-stretch: 1;
                min-width: 80px;
                placeholder: root.f.placeholder;
                text: root.f.value;
                edited(t) => { BuilderState.act("f-val", root.index, 0, t); }
            }
            if root.f.arity == 3: TextField {
                horizontal-stretch: 1;
                min-width: 80px;
                placeholder: root.f.placeholder;
                text: root.f.value;
                edited(t) => { BuilderState.act("f-val", root.index, 0, t); }
            }
            if root.f.arity == 2: TextField {
                horizontal-stretch: 1;
                min-width: 50px;
                placeholder: "From";
                text: root.f.value;
                edited(t) => { BuilderState.act("f-val", root.index, 0, t); }
            }
            if root.f.arity == 2: Text {
                text: "and";
                color: Theme.muted-foreground;
                font-size: Theme.size-small;
                vertical-alignment: center;
            }
            if root.f.arity == 2: TextField {
                horizontal-stretch: 1;
                min-width: 50px;
                placeholder: "To";
                text: root.f.value2;
                edited(t) => { BuilderState.act("f-val2", root.index, 0, t); }
            }
            RemoveButton { clicked => { BuilderState.act("f-remove", root.index, 0, ""); } }
        }
        if root.f.hint != "": HorizontalLayout {
            padding-left: 8px + root.f.depth * 18px;
            Text {
                text: root.f.hint;
                color: Theme.warning;
                font-size: Theme.size-small;
            }
        }
    }
}

component FiltersSection inherits VerticalLayout {
    spacing: 4px;

    if BuilderState.sources.length == 0: Hint { text: "Add a table first, then build conditions on its columns."; }
    if BuilderState.sources.length > 0: VerticalLayout {
        spacing: 4px;
        for f[i] in BuilderState.filters: FilterRow { f: f; index: i; }
    }
    if BuilderState.sources.length > 0 && BuilderState.filters.length > 0: Hint {
        text: "Rows missing a value are left out of the query. Groups nest up to 3 levels.";
    }
}

component GroupBySection inherits VerticalLayout {
    spacing: 8px;

    Hint { text: "Group by"; }
    ColumnPicker {
        placeholder: "Group by column";
        picked(t, c) => { BuilderState.act("gb-add", t, c, ""); }
    }
    for g[i] in BuilderState.group-by: HorizontalLayout {
        height: 28px;
        spacing: 6px;
        Text {
            text: g;
            color: Theme.foreground;
            font-size: Theme.size-mono;
            font-family: "Menlo";
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        RemoveButton { clicked => { BuilderState.act("gb-remove", i, 0, ""); } }
    }
    for w in BuilderState.group-issues: WarnText { text: w; }

    Rectangle { height: 4px; }
    Hint { text: "Having"; }
    for h[i] in BuilderState.having: VerticalLayout {
        spacing: 2px;
        HorizontalLayout {
            height: 32px;
            spacing: 6px;
            Dropdown {
                width: 104px;
                options: BuilderState.having-aggregates;
                value: h.aggregate;
                selected(k) => { BuilderState.act("hv-agg", i, k, ""); }
            }
            Dropdown {
                width: 104px;
                options: BuilderState.aliases;
                value: h.alias;
                selected(k) => { BuilderState.act("hv-alias", i, k, ""); }
            }
            Dropdown {
                width: 100px;
                options: BuilderState.sources[h.alias-index].columns;
                value: h.column;
                selected(k) => { BuilderState.act("hv-col", i, k, ""); }
            }
            Dropdown {
                width: 60px;
                options: BuilderState.having-ops;
                value: h.op-label;
                selected(k) => { BuilderState.act("hv-op", i, k, ""); }
            }
            TextField {
                horizontal-stretch: 1;
                min-width: 60px;
                placeholder: "Value";
                text: h.value;
                edited(t) => { BuilderState.act("hv-val", i, 0, t); }
            }
            RemoveButton { clicked => { BuilderState.act("hv-remove", i, 0, ""); } }
        }
        if h.hint != "": Text {
            text: h.hint;
            color: Theme.warning;
            font-size: Theme.size-small;
        }
    }
    HorizontalLayout {
        alignment: start;
        Button {
            text: "Add having";
            has-icon: true;
            icon: Icons.plus;
            enabled: BuilderState.sources.length > 0;
            clicked => { BuilderState.act("hv-add", 0, 0, ""); }
        }
    }
}

component OrderBySection inherits VerticalLayout {
    spacing: 8px;

    ColumnPicker {
        placeholder: "Order by column";
        picked(t, c) => { BuilderState.act("ob-add", t, c, ""); }
    }
    if BuilderState.order-by.length == 0: Hint { text: "No ordering. Rows come back in whatever order the database likes."; }
    for o[i] in BuilderState.order-by: HorizontalLayout {
        height: 30px;
        spacing: 6px;
        Text {
            text: o.label;
            color: Theme.foreground;
            font-size: Theme.size-mono;
            font-family: "Menlo";
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Button {
            text: o.descending ? "Descending" : "Ascending";
            has-icon: true;
            icon: o.descending ? Icons.arrow-down : Icons.arrow-up;
            accessible-label: "Toggle sort direction";
            clicked => { BuilderState.act("ob-dir", i, 0, ""); }
        }
        RemoveButton { clicked => { BuilderState.act("ob-remove", i, 0, ""); } }
    }
}

component LimitSection inherits VerticalLayout {
    spacing: 8px;

    HorizontalLayout {
        spacing: 10px;
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Hint { text: "Limit (rows to return)"; }
            TextField {
                placeholder: "No limit";
                text <=> BuilderState.limit-text;
                edited(t) => { BuilderState.act("limit", 0, 0, t); }
            }
            if BuilderState.limit-error != "": Text {
                text: BuilderState.limit-error;
                color: Theme.destructive;
                font-size: Theme.size-small;
            }
        }
        VerticalLayout {
            spacing: 4px;
            horizontal-stretch: 1;
            Hint { text: "Offset (rows to skip)"; }
            TextField {
                placeholder: "0";
                text <=> BuilderState.offset-text;
                edited(t) => { BuilderState.act("offset", 0, 0, t); }
            }
            if BuilderState.offset-error != "": Text {
                text: BuilderState.offset-error;
                color: Theme.destructive;
                font-size: Theme.size-small;
            }
        }
    }
    Text {
        text: BuilderState.pagination;
        color: Theme.muted-foreground;
        font-size: Theme.size-label;
    }
}

// The header of one collapsible section.
component SectionHead inherits CollapseHeader {
    in property <int> index;
    title: BuilderState.sections[root.index].title;
    count: BuilderState.sections[root.index].count;
    open: BuilderState.sections[root.index].open;
    clicked => { BuilderState.act("section", root.index, 0, ""); }
}

// -- The panel --------------------------------------------------------------------

component BuilderForm inherits ScrollView {
    VerticalLayout {
        alignment: start;
        padding-right: 14px;
        spacing: 4px;

        if BuilderState.sections.length == 7: VerticalLayout {
            spacing: 4px;
            SectionHead { index: 0; }
            if BuilderState.sections[0].open: TablesSection { padding-left: 22px; padding-right: 8px; padding-bottom: 8px; }
            Divider { }
            SectionHead { index: 1; }
            if BuilderState.sections[1].open: JoinsSection { padding-left: 22px; padding-right: 8px; padding-bottom: 8px; }
            Divider { }
            SectionHead { index: 2; }
            if BuilderState.sections[2].open: ColumnsSection { padding-left: 22px; padding-right: 8px; padding-bottom: 8px; }
            Divider { }
            SectionHead { index: 3; }
            if BuilderState.sections[3].open: FiltersSection { padding-left: 22px; padding-right: 8px; padding-bottom: 8px; }
            Divider { }
            SectionHead { index: 4; }
            if BuilderState.sections[4].open: GroupBySection { padding-left: 22px; padding-right: 8px; padding-bottom: 8px; }
            Divider { }
            SectionHead { index: 5; }
            if BuilderState.sections[5].open: OrderBySection { padding-left: 22px; padding-right: 8px; padding-bottom: 8px; }
            Divider { }
            SectionHead { index: 6; }
            if BuilderState.sections[6].open: LimitSection { padding-left: 22px; padding-right: 8px; padding-bottom: 8px; }
            Divider { }
        }
    }
}

component PreviewPane inherits VerticalLayout {
    spacing: 8px;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            SectionLabel { text: "SQL PREVIEW"; min-height: 20px; vertical-alignment: center; }
        }
        Rectangle { horizontal-stretch: 1; }
        Button {
            text: "Copy";
            has-icon: true;
            icon: Icons.copy;
            variant: ButtonVariant.ghost;
            enabled: BuilderState.sql != "";
            clicked => { BuilderState.copy-sql(); }
        }
    }

    if BuilderState.sql == "": Rectangle {
        vertical-stretch: 1;
        border-width: 1px;
        border-color: Theme.border;
        border-radius: Theme.radius-card;
        background: Theme.card;
        EmptyState {
            icon: Icons.code;
            title: "No query yet";
            message: "Add a table and the SQL appears here as you build.";
        }
    }
    if BuilderState.sql != "": SqlEditor {
        vertical-stretch: 1;
        read-only: true;
        text: BuilderState.sql;
        lines: BuilderState.sql-lines;
    }

    if BuilderState.warnings.length > 0: Rectangle {
        height: min(112px, BuilderState.warnings.length * 38px);
        ScrollView {
            VerticalLayout {
                alignment: start;
                spacing: 6px;
                padding-right: 10px;
                for w in BuilderState.warnings: WarnText { text: w; }
            }
        }
    }

    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Button {
            text: "Open in tab";
            enabled: BuilderState.can-use;
            clicked => { BuilderState.use-sql(); }
        }
        Button {
            text: "Run";
            variant: ButtonVariant.primary;
            has-icon: true;
            icon: Icons.play;
            enabled: BuilderState.can-use;
            clicked => { BuilderState.run-sql(); }
        }
    }
}

export component BuilderPanel inherits Rectangle {
    in property <length> available-width: 1120px;
    in property <length> available-height: 720px;

    width: min(1120px, root.available-width);
    height: min(720px, root.available-height);
    background: Theme.popover;
    border-radius: Theme.radius-window;
    border-width: 1px;
    border-color: Theme.border-strong;
    clip: true;

    // Swallows clicks on the panel's own background.
    TouchArea { }

    VerticalLayout {
        padding: 20px;
        padding-top: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                Text {
                    text: "Visual query builder";
                    color: Theme.foreground;
                    font-size: Theme.size-subheading;
                    font-weight: 700;
                }
                if BuilderState.scope-label != "": Text {
                    text: BuilderState.scope-label;
                    color: Theme.muted-foreground;
                    font-size: Theme.size-small;
                    overflow: elide;
                }
            }
            Rectangle { horizontal-stretch: 1; }
            VerticalLayout {
                alignment: center;
                Button {
                    text: "Reset";
                    has-icon: true;
                    icon: Icons.refresh-cw;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Reset the builder";
                    clicked => { BuilderState.act("reset", 0, 0, ""); }
                }
            }
            VerticalLayout {
                alignment: center;
                Button {
                    has-icon: true;
                    icon: Icons.x;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Close";
                    clicked => { BuilderState.close(); }
                }
            }
        }

        if BuilderState.error != "": HorizontalLayout {
            spacing: 8px;
            Banner {
                horizontal-stretch: 1;
                message: BuilderState.error;
                dismissed => { BuilderState.dismiss-error(); }
            }
            if BuilderState.error-retry: VerticalLayout {
                alignment: center;
                Button {
                    text: "Retry";
                    has-icon: true;
                    icon: Icons.refresh-cw;
                    clicked => { BuilderState.retry(); }
                }
            }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 14px;
            BuilderForm {
                horizontal-stretch: 1;
                min-width: 420px;
            }
            VDivider { }
            PreviewPane {
                width: max(300px, min(420px, root.width * 0.34));
            }
        }
    }
}

// The panel over a dimmed workspace. A click on the backdrop closes it.
export component BuilderOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.background.transparentize(0.25);

    TouchArea {
        clicked => { BuilderState.close(); }
    }

    // Escape closes it from anywhere inside, since a key a text field does
    // not use bubbles up to here. Focus starts here so it works untouched.
    scope := FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) {
                BuilderState.close();
                return accept;
            }
            return reject;
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                BuilderPanel {
                    available-width: root.width - 48px;
                    available-height: root.height - 48px;
                }
            }
        }
    }
}
