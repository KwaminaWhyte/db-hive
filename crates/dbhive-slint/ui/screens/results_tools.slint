import { FileBrowse, BrowseTarget } from "../components/file_browse.slint";
import { Theme, Icons, Tone, ButtonVariant, Button, Segmented, Banner, Dropdown, EmptyState, ChartPlot, ResultViewLine, ResultViewText, ResultViewError, ExportDialog } from "../kit/kit.slint";

// What the results area adds around the grid: a Table / JSON / Text switch,
// the JSON and Text views, a structured query error, and the export dialog.
// Rust owns every value here (`app/results.rs`); this file draws it and
// reports intents.

export global ResultsState {
    // The active query tab's view: 0 Table, 1 JSON, 2 Text.
    in property <int> mode;
    in property <[ResultViewLine]> view-lines;
    // Longest line in characters, for the sideways scroll.
    in property <int> view-max-columns;
    // "Showing the first 2,000 of 2,500 rows", empty when nothing was cut.
    in property <string> view-notice;
    // The active tab holds a result with columns, and nothing is running.
    in property <bool> can-export;

    // Chart mode (mode 3): a bar or line of one numeric column per group.
    in property <int> chart-kind;
    in property <[string]> chart-x-options;
    in property <[string]> chart-y-options;
    in property <string> chart-x;
    in property <string> chart-y;
    in property <string> chart-commands;
    in property <string> chart-area;
    in property <string> chart-y-top;
    in property <string> chart-y-mid;
    in property <string> chart-y-bottom;
    in property <string> chart-x-start;
    in property <string> chart-x-end;
    in property <string> chart-caption;
    in property <string> chart-notice;
    // Set instead of a plot when there is nothing to draw.
    in property <string> chart-message;

    // The failed query, split into a headline and the driver's message.
    in property <string> error-headline;
    in property <string> error-detail;
    in property <string> error-code;
    in property <string> error-query;
    in property <bool> error-query-open;

    // The export dialog.
    in property <bool> export-visible;
    in property <string> export-scope-note;
    in property <[string]> export-formats;
    in property <int> export-format;
    in-out property <string> export-path;
    in property <string> export-path-error;
    in property <bool> export-replaces;
    in property <string> export-hint;
    in property <bool> export-running;
    in property <bool> export-done;
    in property <string> export-done-message;

    callback mode-picked(int);
    callback view-copy;
    callback chart-kind-picked(int);
    callback chart-x-picked(int);
    callback chart-y-picked(int);
    callback error-retry;
    callback error-copy;
    callback error-toggle-query;
    callback export-open;
    callback export-close;
    callback export-format-picked(int);
    callback export-path-edited(string);
    callback export-suggest;
    callback export-run;
    callback export-reveal;
}

// Table / JSON / Text and Export, for the results header of a query tab.
export component ResultsModeBar inherits HorizontalLayout {
    spacing: 8px;
    VerticalLayout {
        alignment: center;
        Segmented {
            options: ["Table", "JSON", "Text", "Chart"];
            selected: ResultsState.mode;
            picked(i) => { ResultsState.mode-picked(i); }
        }
    }
    if ResultsState.mode == 1 || ResultsState.mode == 2: VerticalLayout {
        alignment: center;
        Button {
            has-icon: true;
            icon: Icons.copy;
            variant: ButtonVariant.ghost;
            accessible-label: ResultsState.mode == 1 ? "Copy as JSON" : "Copy as TSV";
            clicked => { ResultsState.view-copy(); }
        }
    }
    VerticalLayout {
        alignment: center;
        Button {
            text: "Export";
            has-icon: true;
            icon: Icons.download;
            variant: ButtonVariant.ghost;
            enabled: ResultsState.can-export;
            accessible-label: "Export results to CSV or JSON";
            clicked => { ResultsState.export-open(); }
        }
    }
}

// Just the Export button, for the table inspector's toolbar. Icon only: that
// toolbar is already full in an editing state at a narrow window.
export component ResultsExportButton inherits Button {
    has-icon: true;
    icon: Icons.download;
    variant: ButtonVariant.ghost;
    enabled: ResultsState.can-export;
    accessible-label: "Export this page to CSV or JSON";
    clicked => { ResultsState.export-open(); }
}

// A bar or line chart of one numeric column per group, with its pickers.
component ResultsChartPane inherits VerticalLayout {
    spacing: 8px;
    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Segmented {
                options: ["Bar", "Line"];
                selected: ResultsState.chart-kind;
                picked(i) => { ResultsState.chart-kind-picked(i); }
            }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: "Group by";
                color: Theme.muted-foreground;
                font-size: Theme.size-small;
            }
        }
        Dropdown {
            width: 150px;
            options: ResultsState.chart-x-options;
            value: ResultsState.chart-x;
            selected(i) => { ResultsState.chart-x-picked(i); }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: "Sum of";
                color: Theme.muted-foreground;
                font-size: Theme.size-small;
            }
        }
        Dropdown {
            width: 150px;
            enabled: ResultsState.chart-y-options.length > 0;
            options: ResultsState.chart-y-options;
            value: ResultsState.chart-y;
            selected(i) => { ResultsState.chart-y-picked(i); }
        }
        // What is plotted, in the pickers' row to save height.
        if ResultsState.chart-message == "": Text {
            horizontal-stretch: 1;
            text: ResultsState.chart-caption;
            color: Theme.muted-foreground;
            font-size: Theme.size-small;
            horizontal-alignment: right;
            vertical-alignment: center;
            overflow: elide;
        }
        if ResultsState.chart-message != "": Rectangle { horizontal-stretch: 1; }
    }
    if ResultsState.chart-message != "": EmptyState {
        vertical-stretch: 1;
        icon: Icons.layout-grid;
        title: "Nothing to chart";
        message: ResultsState.chart-message;
    }
    if ResultsState.chart-message == "": ChartPlot {
        vertical-stretch: 1;
        plot-height: 64px;
        kind: ResultsState.chart-kind;
        commands: ResultsState.chart-commands;
        area: ResultsState.chart-area;
        y-top: ResultsState.chart-y-top;
        y-mid: ResultsState.chart-y-mid;
        y-bottom: ResultsState.chart-y-bottom;
        x-start: ResultsState.chart-x-start;
        x-end: ResultsState.chart-x-end;
        label: ResultsState.chart-caption;
    }
    if ResultsState.chart-notice != "": Banner {
        message: ResultsState.chart-notice;
        tone: Tone.warning;
        dismissible: false;
    }
}

// The JSON, Text or Chart view of a result. JSON and Text show a truncation
// notice underneath; their Copy button lives in the mode bar, to keep the
// pane's height.
export component ResultsViewPane inherits VerticalLayout {
    spacing: 8px;
    if ResultsState.mode == 3: ResultsChartPane {
        vertical-stretch: 1;
    }
    if ResultsState.mode != 3: ResultViewText {
        vertical-stretch: 1;
        lines: ResultsState.view-lines;
        max-columns: ResultsState.view-max-columns;
        label: ResultsState.mode == 1 ? "Results as JSON" : "Results as text";
    }
    if ResultsState.mode != 3 && ResultsState.view-notice != "": Banner {
        message: ResultsState.view-notice;
        tone: Tone.warning;
        dismissible: false;
    }
}

export component ResultsErrorPanel inherits ResultViewError {
    headline: ResultsState.error-headline;
    detail: ResultsState.error-detail;
    code: ResultsState.error-code;
    query: ResultsState.error-query;
    query-open: ResultsState.error-query-open;
    retry => { ResultsState.error-retry(); }
    copy => { ResultsState.error-copy(); }
    toggle-query => { ResultsState.error-toggle-query(); }
}

export component ResultsExportOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.scrim;

    TouchArea {
        clicked => {
            if (!ResultsState.export-running) {
                ResultsState.export-close();
            }
        }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            ExportDialog {
                scope-note: ResultsState.export-scope-note;
                formats: ResultsState.export-formats;
                format: ResultsState.export-format;
                path <=> ResultsState.export-path;
                path-error: ResultsState.export-path-error;
                replaces: ResultsState.export-replaces;
                hint: ResultsState.export-hint;
                running: ResultsState.export-running;
                done: ResultsState.export-done;
                done-message: ResultsState.export-done-message;
                format-picked(i) => { ResultsState.export-format-picked(i); }
                path-edited(t) => { ResultsState.export-path-edited(t); }
                browsable: true;
                browse-busy: FileBrowse.busy;
                browse => { FileBrowse.browse(BrowseTarget.results-export); }
                use-suggested => { ResultsState.export-suggest(); }
                export => { ResultsState.export-run(); }
                cancel => { ResultsState.export-close(); }
                reveal => { ResultsState.export-reveal(); }
            }
        }
    }
}
