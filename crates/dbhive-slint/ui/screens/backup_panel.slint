// The Backup / Restore panel, opened over the workspace.
//
// Four views: the list of backups in the backup folder, a form to create
// one, a restore confirmation that spells out what will be overwritten, and
// a progress view for the dump or restore that is running. All of it lives
// in the `BackupState` global, so `app.slint` only mounts `BackupOverlay`.
// Rust decides what every row says (`dbhive_ui_model::backup_manager`); this
// file lays it out.

import { FileBrowse, BrowseTarget } from "../components/file_browse.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme, Icons, Tone, ButtonVariant, Button, TextField, Toggle, Divider, Banner, EmptyState, Badge, DetailRow, ProgressBar, FormField, FactRow, Card } from "../kit/kit.slint";

// One backup file in the list. `id` is its path.
export struct BackupRow {
    id: string,
    title: string,
    subtitle: string,
    // The failure reason of a failed backup.
    note: string,
    ok: bool,
}

// What the panel is showing.
export enum BackupView { list, create, restore, progress }

export global BackupState {
    in-out property <bool> visible: false;
    in property <BackupView> view: BackupView.list;
    // "Widgets · Sqlite", the connection a backup is taken from.
    in property <string> location;

    // -- The list ----------------------------------------------------------
    in property <string> directory;
    in property <bool> loading: false;
    in property <string> list-error;
    in-out property <string> filter;
    in property <[BackupRow]> rows;
    in property <string> summary;
    // Blank when a backup can be created; otherwise why not.
    in property <string> backup-blocker;

    // -- The create form ---------------------------------------------------
    in property <bool> include-schema: true;
    in property <bool> include-data: true;
    in-out property <string> note;
    in-out property <string> tables;
    in-out property <string> output-dir;
    in property <string> tables-hint;
    in property <bool> tables-enabled: true;
    in property <string> form-error;

    // -- The restore confirmation -----------------------------------------
    in property <string> restore-file;
    in property <string> restore-facts;
    in property <[string]> restore-warnings;
    in property <string> restore-blocker;
    in property <bool> drop-applies: true;
    in property <bool> drop-existing: false;
    in property <string> restore-label: "Restore";

    // -- Progress ----------------------------------------------------------
    in property <string> op-title;
    in property <string> op-line;
    in property <float> op-fraction: 0;
    in property <bool> op-done: false;
    in property <bool> op-failed: false;
    in property <string> op-result;

    callback open-requested;
    callback close;
    callback refresh;
    callback open-folder;
    callback filter-edited(string);
    callback new-backup;
    callback restore-asked(string);
    callback delete-asked(string);

    callback create-submit;
    callback create-cancel;
    callback schema-toggled;
    callback data-toggled;
    callback note-edited(string);
    callback tables-edited(string);
    callback output-dir-edited(string);

    callback restore-submit;
    callback restore-cancel;
    callback drop-toggled;

    callback progress-dismiss;
}

component BackupList inherits VerticalLayout {
    spacing: 10px;

    HorizontalLayout {
        spacing: 8px;
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            alignment: center;
            spacing: 1px;
            Text {
                text: "Backup folder";
                color: Theme.dim-foreground;
                font-size: Theme.size-small;
            }
            Text {
                text: BackupState.directory == "" ? "Not read yet" : BackupState.directory;
                color: Theme.muted-foreground;
                font-size: Theme.size-mono;
                font-family: "Menlo";
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "Open folder";
                has-icon: true;
                icon: Icons.folder;
                variant: ButtonVariant.ghost;
                clicked => { BackupState.open-folder(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                has-icon: true;
                icon: Icons.refresh-cw;
                variant: ButtonVariant.ghost;
                accessible-label: "Refresh the list";
                enabled: !BackupState.loading;
                clicked => { BackupState.refresh(); }
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                text: "New backup";
                has-icon: true;
                icon: Icons.plus;
                variant: ButtonVariant.primary;
                enabled: BackupState.backup-blocker == "";
                clicked => { BackupState.new-backup(); }
            }
        }
    }

    if BackupState.backup-blocker != "": Text {
        text: BackupState.backup-blocker;
        color: Theme.warning;
        font-size: Theme.size-small;
        wrap: word-wrap;
    }

    TextField {
        text <=> BackupState.filter;
        placeholder: "Filter by file, connection, driver or note";
        has-icon: true;
        icon: Icons.search;
        edited(t) => { BackupState.filter-edited(t); }
    }

    if BackupState.list-error != "": VerticalLayout {
        spacing: 8px;
        Banner { message: BackupState.list-error; dismissible: false; }
        HorizontalLayout {
            alignment: start;
            Button {
                text: "Retry";
                has-icon: true;
                icon: Icons.refresh-cw;
                clicked => { BackupState.refresh(); }
            }
        }
    }

    // Takes the slack under an error banner, so the toolbar does not spread.
    if BackupState.list-error != "" && BackupState.rows.length == 0 && !BackupState.loading: Rectangle {
        vertical-stretch: 1;
    }

    if BackupState.loading: Text {
        vertical-stretch: 1;
        text: "Loading backups…";
        color: Theme.muted-foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if !BackupState.loading && BackupState.list-error == "" && BackupState.rows.length == 0: EmptyState {
        vertical-stretch: 1;
        icon: Icons.hard-drive;
        title: BackupState.filter == "" ? "No backups yet" : "No backups match";
        message: BackupState.filter == ""
            ? "A backup is a file you can restore later. Create one before a migration or a risky change."
            : "Nothing in the backup folder matches that filter.";
        if BackupState.filter == "" && BackupState.backup-blocker == "": Button {
            text: "Create a backup";
            has-icon: true;
            icon: Icons.plus;
            clicked => { BackupState.new-backup(); }
        }
    }

    if !BackupState.loading && BackupState.rows.length > 0: ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: 2px;
            padding-right: 14px;
            for row in BackupState.rows: DetailRow {
                title: row.title;
                subtitle: row.subtitle;
                note: row.note;
                has-status: true;
                status-tone: row.ok ? Tone.success : Tone.danger;
                clicked => { }
                Button {
                    text: "Restore";
                    has-icon: true;
                    icon: Icons.upload;
                    enabled: row.ok;
                    accessible-label: "Restore " + row.title;
                    clicked => { BackupState.restore-asked(row.id); }
                }
                Button {
                    has-icon: true;
                    icon: Icons.trash-2;
                    variant: ButtonVariant.ghost;
                    accessible-label: "Delete " + row.title;
                    clicked => { BackupState.delete-asked(row.id); }
                }
            }
        }
    }

    if !BackupState.loading && BackupState.rows.length > 0: Text {
        text: BackupState.summary;
        color: Theme.dim-foreground;
        font-size: Theme.size-small;
    }
}

component CreateView inherits VerticalLayout {
    spacing: 12px;

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: 14px;
            padding-right: 14px;

            Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    Text {
                        text: "What to include";
                        color: Theme.foreground;
                        font-size: Theme.size-label;
                        font-weight: 600;
                    }
                    HorizontalLayout {
                        spacing: 24px;
                        alignment: start;
                        Toggle {
                            text: "Schema (tables, indexes)";
                            checked: BackupState.include-schema;
                            toggled => { BackupState.schema-toggled(); }
                        }
                        Toggle {
                            text: "Data (rows)";
                            checked: BackupState.include-data;
                            toggled => { BackupState.data-toggled(); }
                        }
                    }
                }
            }

            FormField {
                label: "Note";
                hint: "Optional. Shown beside the backup in the list.";
                TextField {
                    text <=> BackupState.note;
                    placeholder: "before the orders migration";
                    edited(t) => { BackupState.note-edited(t); }
                }
            }

            FormField {
                label: "Tables";
                hint: BackupState.tables-hint;
                TextField {
                    text <=> BackupState.tables;
                    placeholder: "All tables, or a comma separated list";
                    enabled: BackupState.tables-enabled;
                    edited(t) => { BackupState.tables-edited(t); }
                }
            }

            FormField {
                label: "Save in";
                hint: "Leave blank to use the backup folder. An absolute path is required otherwise.";
                HorizontalLayout {
                    spacing: 8px;
                    TextField {
                        horizontal-stretch: 1;
                        text <=> BackupState.output-dir;
                        placeholder: BackupState.directory;
                        has-icon: true;
                        icon: Icons.folder;
                        edited(t) => { BackupState.output-dir-edited(t); }
                    }
                    Button {
                        text: "Browse…";
                        enabled: !FileBrowse.busy;
                        clicked => { FileBrowse.browse(BrowseTarget.backup-dir); }
                    }
                }
            }

            if BackupState.form-error != "": Banner { message: BackupState.form-error; dismissible: false; }
        }
    }

    Divider { }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Button {
            text: "Cancel";
            clicked => { BackupState.create-cancel(); }
        }
        Button {
            text: "Create backup";
            variant: ButtonVariant.primary;
            has-icon: true;
            icon: Icons.hard-drive;
            clicked => { BackupState.create-submit(); }
        }
    }
}

component RestoreView inherits VerticalLayout {
    spacing: 12px;

    ScrollView {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: start;
            spacing: 14px;
            padding-right: 14px;

            Card {
                VerticalLayout {
                    padding: 14px;
                    spacing: 8px;
                    FactRow { label: "Backup"; value: BackupState.restore-file; mono: true; }
                    FactRow { label: "Details"; value: BackupState.restore-facts; }
                    FactRow { label: "Restore into"; value: BackupState.location; }
                }
            }

            for w in BackupState.restore-warnings: Banner {
                message: w;
                tone: Tone.warning;
                dismissible: false;
            }

            if BackupState.drop-applies: Card {
                VerticalLayout {
                    padding: 16px;
                    spacing: 6px;
                    Toggle {
                        text: "Drop and recreate the database first";
                        checked: BackupState.drop-existing;
                        toggled => { BackupState.drop-toggled(); }
                    }
                    Text {
                        text: BackupState.drop-existing
                            ? "Everything currently in the database is deleted before the backup is loaded. This cannot be undone."
                            : "Off: the backup is loaded into the database as it is. Objects that already exist may cause errors.";
                        color: BackupState.drop-existing ? Theme.destructive : Theme.muted-foreground;
                        font-size: Theme.size-small;
                        wrap: word-wrap;
                    }
                }
            }

            if BackupState.restore-blocker != "": Banner {
                message: BackupState.restore-blocker;
                dismissible: false;
            }
        }
    }

    Divider { }
    HorizontalLayout {
        spacing: 8px;
        alignment: end;
        Button {
            text: "Cancel";
            clicked => { BackupState.restore-cancel(); }
        }
        Button {
            text: BackupState.restore-label;
            variant: ButtonVariant.danger;
            has-icon: true;
            icon: Icons.upload;
            enabled: BackupState.restore-blocker == "";
            clicked => { BackupState.restore-submit(); }
        }
    }
}

component ProgressView inherits VerticalLayout {
    alignment: center;
    spacing: 14px;

    Text {
        text: BackupState.op-title;
        color: Theme.foreground;
        font-size: Theme.size-subheading;
        font-weight: 600;
        horizontal-alignment: center;
    }
    ProgressBar {
        value: BackupState.op-fraction;
        tone: BackupState.op-failed ? Tone.danger : BackupState.op-done ? Tone.success : Tone.accent;
    }
    Text {
        text: BackupState.op-line;
        color: Theme.muted-foreground;
        font-size: Theme.size-label;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if !BackupState.op-done: Text {
        text: "This runs the database's own dump tool, which cannot be interrupted safely. It finishes or fails on its own.";
        color: Theme.dim-foreground;
        font-size: Theme.size-small;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    if BackupState.op-done && BackupState.op-result != "": Banner {
        message: BackupState.op-result;
        tone: BackupState.op-failed ? Tone.danger : Tone.success;
        dismissible: false;
    }
    if BackupState.op-done: HorizontalLayout {
        alignment: center;
        Button {
            text: "Back to backups";
            variant: ButtonVariant.primary;
            clicked => { BackupState.progress-dismiss(); }
        }
    }
}

export component BackupPanel inherits Rectangle {
    // Set by the window so the footer buttons never fall off a short window.
    in property <length> available-height: 640px;

    width: 840px;
    height: min(640px, root.available-height);
    background: Theme.popover;
    border-radius: Theme.radius-window;
    border-width: 1px;
    border-color: Theme.border-strong;
    clip: true;

    // Swallows clicks on the panel's own background, so they do not reach the
    // overlay's backdrop and close it.
    TouchArea { }

    VerticalLayout {
        padding: 20px;
        padding-top: 16px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                Text {
                    text: BackupState.view == BackupView.create ? "New backup"
                        : BackupState.view == BackupView.restore ? "Restore a backup"
                        : "Backup and restore";
                    color: Theme.foreground;
                    font-size: Theme.size-subheading;
                    font-weight: 700;
                }
            }
            if BackupState.location != "": VerticalLayout {
                alignment: center;
                Badge { text: BackupState.location; }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                has-icon: true;
                icon: Icons.x;
                variant: ButtonVariant.ghost;
                accessible-label: "Close";
                enabled: BackupState.view != BackupView.progress || BackupState.op-done;
                clicked => { BackupState.close(); }
            }
        }

        Divider { }

        if BackupState.view == BackupView.list: BackupList { vertical-stretch: 1; }
        if BackupState.view == BackupView.create: CreateView { vertical-stretch: 1; }
        if BackupState.view == BackupView.restore: RestoreView { vertical-stretch: 1; }
        if BackupState.view == BackupView.progress: ProgressView { vertical-stretch: 1; }
    }
}

// The panel over a dimmed workspace. Clicking the backdrop closes it from
// the list only: the other views hold typed work or a running operation.
export component BackupOverlay inherits Rectangle {
    width: 100%;
    height: 100%;
    background: Theme.background.transparentize(0.25);

    TouchArea {
        clicked => {
            if (BackupState.view == BackupView.list) {
                BackupState.close();
            }
        }
    }

    VerticalLayout {
        alignment: center;
        HorizontalLayout {
            alignment: center;
            BackupPanel {
                available-height: root.height - 48px;
            }
        }
    }
}
