import { Theme, Icons, Tone, ButtonVariant, Icon, Button, Card, ClickableCard, ListRow, SwatchPicker, Badge, TextField,
    ScreenHeader, SectionLabel, Banner, EmptyState, Divider, DetailRow, UnderlineTabs, FilterChip,
    Segmented, DataRow, SidePanel, ClipboardSink, KeyCap, KeyCaps, Popover, SettingRow, Toggle,
    StepBar, ProgressBar, CodeBlock, FormField, FactRow, Stepper, StatTile, MeterRow, LineChart,
    CollapseHeader, CheckBox, StepTabs, ChipStrip, PropField, KeyTag, Dropdown,
    AiTurnCard, AiScrollText, AiBusyRow } from "../kit/kit.slint";

export component KitGallery inherits Window {
    background: Theme.background;
    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        ScreenHeader {
            title: "Connections";
            subtitle: "5 connections";
            Button { text: "Import"; variant: ButtonVariant.ghost; has-icon: true; icon: Icons.upload; }
            Button { text: "New connection"; variant: ButtonVariant.primary; has-icon: true; icon: Icons.plus; }
        }

        HorizontalLayout {
            spacing: 18px;
            VerticalLayout {
                spacing: 10px;
                SectionLabel { text: "BUTTONS"; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Execute"; variant: ButtonVariant.primary; has-icon: true; icon: Icons.play; }
                    Button { text: "Secondary"; }
                    Button { text: "Ghost"; variant: ButtonVariant.ghost; }
                    Button { text: "Delete"; variant: ButtonVariant.danger; has-icon: true; icon: Icons.trash-2; }
                    Button { text: "Disabled"; variant: ButtonVariant.primary; enabled: false; }
                    Button { has-icon: true; icon: Icons.settings; variant: ButtonVariant.ghost; }
                }
                SectionLabel { text: "BADGES"; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Badge { text: "Connected"; tone: Tone.success; dot: true; }
                    Badge { text: "Production"; tone: Tone.danger; }
                    Badge { text: "Staging"; tone: Tone.warning; }
                    Badge { text: "12 matches"; tone: Tone.accent; }
                    Badge { text: "Local"; }
                }
                SectionLabel { text: "FIELDS"; }
                TextField { placeholder: "Search by name or host"; has-icon: true; icon: Icons.search; }
                TextField { text: "SELECT 1"; }
                Banner { message: "Connection failed: password authentication failed for user \"postgres\""; }
                Banner { message: "Schema refreshed"; tone: Tone.success; }
                SectionLabel { text: "TABS, CHIPS, DETAIL ROWS"; }
                UnderlineTabs { labels: ["History", "Snippets (4)", "Templates (3)"]; active: 1; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    FilterChip { text: "All"; selected: true; }
                    FilterChip { text: "maintenance"; }
                    FilterChip { text: "reports"; }
                }
                DetailRow {
                    title: "SELECT id, name FROM customers WHERE plan = 'pro'";
                    subtitle: "5m ago · Production / app · 12ms · 1,204 rows";
                    mono-title: true;
                    has-status: true;
                    Button { text: "Re-run"; has-icon: true; icon: Icons.play; }
                }
                DetailRow {
                    title: "SELECT * FROM order_itemz";
                    subtitle: "55m ago · Production / app · 3ms";
                    note: "relation \"order_itemz\" does not exist";
                    mono-title: true;
                    has-status: true;
                    status-tone: Tone.danger;
                    Button { text: "Re-run"; has-icon: true; icon: Icons.play; }
                }
                DetailRow {
                    title: "Active users this week";
                    subtitle: "Users seen in the last seven days";
                    tags: ["reports", "weekly"];
                    selected: true;
                    Button { has-icon: true; icon: Icons.pencil; variant: ButtonVariant.ghost; }
                }
                SectionLabel { text: "SEGMENTED AND LINK BADGE"; }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: start;
                    Segmented { options: ["Data", "Structure"]; selected: 1; }
                    VerticalLayout {
                        alignment: center;
                        Badge { text: "FK customers(id)"; clickable: true; }
                    }
                }
                SectionLabel { text: "STEP BAR, PROGRESS, CODE, FIELDS"; }
                StepBar {
                    labels: ["File", "Preview", "Mapping", "Options", "Confirm"];
                    current: 2;
                    reachable: 2;
                }
                ProgressBar { value: 0.45; }
                ProgressBar { indeterminate: true; }
                ProgressBar { value: 1; tone: Tone.success; }
                CodeBlock { text: "INSERT INTO \"public\".\"customers\" (\"id\", \"name\") VALUES (1, 'Ada'), (2, 'Grace');"; max-lines: 2; }
                CodeBlock { text: "TRUNCATE TABLE \"public\".\"customers\";"; tone: Tone.danger; }
                FormField {
                    label: "Save to";
                    hint: "A date-stamped name is suggested.";
                    error: "The folder does not exist.";
                    TextField { text: "/Users/me/Downloads/app_2026-10-21.sql"; }
                }
                FactRow { label: "Target"; value: "\"public\".\"customers\""; mono: true; }
                FactRow { label: "Rows"; value: "240 in 3 statement(s)"; }
                SectionLabel { text: "TABLE ROWS"; }
                Card {
                    clip: true;
                    VerticalLayout {
                        DataRow {
                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 12px;
                                Text { text: "id"; color: Theme.foreground; font-size: Theme.size-label; font-weight: 600; vertical-alignment: center; width: 200px; }
                                Text { text: "integer"; color: Theme.foreground; font-size: Theme.size-label; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                        DataRow {
                            clickable: true;
                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 12px;
                                Text { text: "customer_id (clickable)"; color: Theme.foreground; font-size: Theme.size-label; font-weight: 600; vertical-alignment: center; width: 200px; }
                                Text { text: "integer"; color: Theme.foreground; font-size: Theme.size-label; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                        DataRow {
                            selected: true;
                            HorizontalLayout {
                                padding-left: 12px;
                                spacing: 12px;
                                Text { text: "note (selected)"; color: Theme.foreground; font-size: Theme.size-label; font-weight: 600; vertical-alignment: center; width: 200px; }
                                Text { text: "text"; color: Theme.foreground; font-size: Theme.size-label; vertical-alignment: center; horizontal-stretch: 1; }
                            }
                        }
                    }
                }
                SectionLabel { text: "SETTING ROWS"; }
                Card {
                    VerticalLayout {
                        SettingRow {
                            title: "Query timeout";
                            description: "Seconds to wait; 0 means no limit";
                            error: "Must be between 0 and 300";
                            TextField { width: 72px; text: "900"; }
                        }
                        SettingRow {
                            title: "Confirm destructive queries";
                            last: true;
                            Toggle { checked: true; }
                        }
                    }
                }
            }
            VerticalLayout {
                spacing: 10px;
                SectionLabel { text: "LIST ROWS"; }
                ListRow { icon: Icons.table; text: "customers"; detail: "~1240"; selected: true; }
                ListRow { icon: Icons.table; text: "orders"; detail: "~2480"; }
                ListRow { icon: Icons.table; text: "a_table_with_a_very_long_name_that_must_be_elided_not_overflow"; detail: "~7440"; }
                SectionLabel { text: "SWATCHES"; }
                SwatchPicker {
                    options: [#ef4444, #f59e0b, #22c55e, #3b82f6, #a855f7, #ec4899];
                    selected: 3;
                }
                SectionLabel { text: "KEY CAPS AND POPOVER"; }
                Popover {
                    height: 64px;
                    HorizontalLayout {
                        padding: 14px;
                        spacing: 12px;
                        VerticalLayout {
                            alignment: center;
                            Text { text: "New Window"; color: Theme.foreground; font-size: Theme.size-body; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        KeyCaps { keys: ["Shift", "⌘", "N"]; }
                        KeyCaps { keys: ["Ctrl", "Enter"]; }
                    }
                }
                SectionLabel { text: "CARDS"; }
                ClickableCard {
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Theme.radius-control;
                            background: #3876ab40;
                            Text { text: "PG"; color: #7fb3e0; font-size: 11px; font-weight: 700; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "local pg"; color: Theme.foreground; font-size: Theme.size-body; font-weight: 600; }
                                Badge { text: "Local"; }
                            }
                            Text { text: "localhost:5432"; color: Theme.muted-foreground; font-size: Theme.size-small; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; Button { text: "Connect"; variant: ButtonVariant.primary; } }
                    }
                }
                ClickableCard {
                    selected: true;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Theme.radius-control;
                            background: #00758f40;
                            Text { text: "MY"; color: #5cc2d6; font-size: 11px; font-weight: 700; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Local MySQL"; color: Theme.foreground; font-size: Theme.size-body; font-weight: 600; }
                                Badge { text: "Connected"; tone: Tone.success; dot: true; }
                            }
                            Text { text: "localhost:3306"; color: Theme.muted-foreground; font-size: Theme.size-small; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; Button { text: "Disconnect"; variant: ButtonVariant.ghost; } }
                    }
                }
                SectionLabel { text: "SIDE PANEL AND CLIPBOARD"; }
                Card {
                    height: 120px;
                    clip: true;
                    SidePanel {
                        title: "Row 3 · note";
                        subtitle: "Selected row as JSON";
                        VerticalLayout {
                            padding: 12px;
                            alignment: start;
                            Button {
                                text: "Copy";
                                has-icon: true;
                                icon: Icons.copy;
                                clicked => { sink.copy-text("copied from the gallery"); }
                            }
                        }
                    }
                }
                sink := ClipboardSink { }
                SectionLabel { text: "FORM FIELD AND KEY TAG (ER diagram, schema designer)"; }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        PropField {
                            label: "Table name";
                            TextField { text: "orders"; }
                        }
                        PropField {
                            label: "References";
                            HorizontalLayout {
                                spacing: 6px;
                                Dropdown { horizontal-stretch: 1; options: ["(none)", "users"]; value: "users"; }
                                Dropdown { horizontal-stretch: 1; options: ["id"]; value: "id"; }
                            }
                        }
                        DataRow {
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;
                                KeyTag { text: "PK"; primary: true; }
                                Text { text: "id"; color: Theme.foreground; font-size: Theme.size-label; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "BIGINT"; color: Theme.dim-foreground; font-size: Theme.size-small; vertical-alignment: center; }
                            }
                        }
                        DataRow {
                            HorizontalLayout {
                                padding-left: 8px;
                                spacing: 4px;
                                KeyTag { text: "FK"; }
                                Text { text: "user_id"; color: Theme.foreground; font-size: Theme.size-label; vertical-alignment: center; horizontal-stretch: 1; }
                                Text { text: "BIGINT"; color: Theme.dim-foreground; font-size: Theme.size-small; vertical-alignment: center; }
                            }
                        }
                    }
                }
                Card {
                    height: 190px;
                    EmptyState {
                        icon: Icons.play;
                        title: "No results yet";
                        message: "Write a statement and run it.";
                        Button { text: "Run SELECT 1"; variant: ButtonVariant.secondary; }
                    }
                }
                SectionLabel { text: "ACTIVITY AND MIGRATIONS"; }
                Stepper { labels: ["Select", "Diff", "SQL"]; current: 1; }
                HorizontalLayout {
                    spacing: 8px;
                    StatTile { label: "Connections"; value: "31"; tone: Tone.accent; }
                    StatTile { label: "Active"; value: "5"; tone: Tone.success; }
                    StatTile { label: "Failed"; value: "2"; tone: Tone.danger; }
                    StatTile { label: "Rows"; value: "1.4K"; }
                }
                MeterRow { label: "SELECT"; value: "5  56%"; fraction: 0.56; }
                MeterRow { label: "Failed"; value: "1  11%"; fraction: 0.11; tone: Tone.danger; }
                LineChart {
                    height: 150px;
                    plot-height: 70px;
                    y-top: "50";
                    y-mid: "25";
                    x-start: "09:15:45";
                    x-end: "09:20:45";
                    lines: [
                        { name: "Connections", last: "31", tone: Tone.accent,
                          commands: "M 0 600 L 250 400 L 500 500 L 750 200 L 1000 300",
                          area: "M 0 600 L 250 400 L 500 500 L 750 200 L 1000 300 L 1000 1000 L 0 1000 Z" },
                        { name: "Active", last: "5", tone: Tone.success,
                          commands: "M 0 900 L 250 850 L 500 880 L 750 800 L 1000 850",
                          area: "M 0 900 L 250 850 L 500 880 L 750 800 L 1000 850 L 1000 1000 L 0 1000 Z" },
                    ];
                }
            }
            VerticalLayout {
                spacing: 10px;
                alignment: start;
                SectionLabel { text: "QUERY BUILDER AND TABLE DIALOG PARTS"; }
                StepTabs { labels: ["Basics", "Columns", "Constraints", "Preview"]; active: 1; }
                CollapseHeader { title: "Tables"; count: 2; open: true; }
                CollapseHeader { title: "Group by and having"; count: 0; open: false; }
                HorizontalLayout {
                    spacing: 18px;
                    alignment: start;
                    CheckBox { text: "Distinct"; checked: true; }
                    CheckBox { text: "Auto"; checked: false; }
                    CheckBox { text: "Null"; checked: true; enabled: false; }
                }
                ChipStrip {
                    FilterChip { text: "id"; selected: false; }
                    FilterChip { text: "customer_id"; selected: true; }
                    FilterChip { text: "reference"; selected: false; }
                    FilterChip { text: "amount"; selected: false; }
                    FilterChip { text: "issued_at"; selected: true; }
                    FilterChip { text: "a_column_that_runs_past_the_edge"; selected: false; }
                    FilterChip { text: "and_another_one"; selected: false; }
                }
                SectionLabel { text: "AI ASSISTANT PARTS"; }
                AiTurnCard { user: true; heading: "You"; body: "list the ten newest customers"; }
                AiTurnCard {
                    heading: "Generate SQL";
                    meta: "gpt-4o · 1.2s";
                    has-sql: true;
                    sql: "SELECT id, name FROM customers ORDER BY created_at DESC LIMIT 10;";
                }
                AiTurnCard { failed: true; heading: "Explain"; body: "OpenAI API error: rate limit reached"; }
                AiScrollText {
                    text: "Database: shop\n\nTables:\n\npublic.customers:\n  - id: integer\n  - name: text";
                    line-count: 6;
                }
                AiBusyRow { text: "Generating SQL"; }
            }
        }
    }
}
