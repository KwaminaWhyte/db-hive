import { Theme, Icons, Tone, ButtonVariant, Icon, Button, Card, ClickableCard, ListRow, SwatchPicker, Badge, TextField,
    ScreenHeader, SectionLabel, Banner, EmptyState, Divider, DetailRow, UnderlineTabs, FilterChip } from "../kit/kit.slint";

export component KitGallery inherits Window {
    background: Theme.background;
    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        ScreenHeader {
            title: "Connections";
            subtitle: "5 connections";
            Button { text: "Import"; variant: ButtonVariant.ghost; has-icon: true; icon: Icons.upload; }
            Button { text: "New connection"; variant: ButtonVariant.primary; has-icon: true; icon: Icons.plus; }
        }

        HorizontalLayout {
            spacing: 18px;
            VerticalLayout {
                spacing: 10px;
                SectionLabel { text: "BUTTONS"; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Button { text: "Execute"; variant: ButtonVariant.primary; has-icon: true; icon: Icons.play; }
                    Button { text: "Secondary"; }
                    Button { text: "Ghost"; variant: ButtonVariant.ghost; }
                    Button { text: "Delete"; variant: ButtonVariant.danger; has-icon: true; icon: Icons.trash-2; }
                    Button { text: "Disabled"; variant: ButtonVariant.primary; enabled: false; }
                    Button { has-icon: true; icon: Icons.settings; variant: ButtonVariant.ghost; }
                }
                SectionLabel { text: "BADGES"; }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Badge { text: "Connected"; tone: Tone.success; dot: true; }
                    Badge { text: "Production"; tone: Tone.danger; }
                    Badge { text: "Staging"; tone: Tone.warning; }
                    Badge { text: "12 matches"; tone: Tone.accent; }
                    Badge { text: "Local"; }
                }
                SectionLabel { text: "FIELDS"; }
                TextField { placeholder: "Search by name or host"; has-icon: true; icon: Icons.search; }
                TextField { text: "SELECT 1"; }
                Banner { message: "Connection failed: password authentication failed for user \"postgres\""; }
                Banner { message: "Schema refreshed"; tone: Tone.success; }
                SectionLabel { text: "TABS, CHIPS, DETAIL ROWS"; }
                UnderlineTabs { labels: ["History", "Snippets (4)", "Templates (3)"]; active: 1; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    FilterChip { text: "All"; selected: true; }
                    FilterChip { text: "maintenance"; }
                    FilterChip { text: "reports"; }
                }
                DetailRow {
                    title: "SELECT id, name FROM customers WHERE plan = 'pro'";
                    subtitle: "5m ago · Production / app · 12ms · 1,204 rows";
                    mono-title: true;
                    has-status: true;
                    Button { text: "Re-run"; has-icon: true; icon: Icons.play; }
                }
                DetailRow {
                    title: "SELECT * FROM order_itemz";
                    subtitle: "55m ago · Production / app · 3ms";
                    note: "relation \"order_itemz\" does not exist";
                    mono-title: true;
                    has-status: true;
                    status-tone: Tone.danger;
                    Button { text: "Re-run"; has-icon: true; icon: Icons.play; }
                }
                DetailRow {
                    title: "Active users this week";
                    subtitle: "Users seen in the last seven days";
                    tags: ["reports", "weekly"];
                    selected: true;
                    Button { has-icon: true; icon: Icons.pencil; variant: ButtonVariant.ghost; }
                }
            }
            VerticalLayout {
                spacing: 10px;
                SectionLabel { text: "LIST ROWS"; }
                ListRow { icon: Icons.table; text: "customers"; detail: "~1240"; selected: true; }
                ListRow { icon: Icons.table; text: "orders"; detail: "~2480"; }
                ListRow { icon: Icons.table; text: "a_table_with_a_very_long_name_that_must_be_elided_not_overflow"; detail: "~7440"; }
                SectionLabel { text: "SWATCHES"; }
                SwatchPicker {
                    options: [#ef4444, #f59e0b, #22c55e, #3b82f6, #a855f7, #ec4899];
                    selected: 3;
                }
                SectionLabel { text: "CARDS"; }
                ClickableCard {
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Theme.radius-control;
                            background: #3876ab40;
                            Text { text: "PG"; color: #7fb3e0; font-size: 11px; font-weight: 700; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "local pg"; color: Theme.foreground; font-size: Theme.size-body; font-weight: 600; }
                                Badge { text: "Local"; }
                            }
                            Text { text: "localhost:5432"; color: Theme.muted-foreground; font-size: Theme.size-small; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; Button { text: "Connect"; variant: ButtonVariant.primary; } }
                    }
                }
                ClickableCard {
                    selected: true;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 12px;
                        Rectangle {
                            width: 32px;
                            height: 32px;
                            border-radius: Theme.radius-control;
                            background: #00758f40;
                            Text { text: "MY"; color: #5cc2d6; font-size: 11px; font-weight: 700; }
                        }
                        VerticalLayout {
                            spacing: 2px;
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                Text { text: "Local MySQL"; color: Theme.foreground; font-size: Theme.size-body; font-weight: 600; }
                                Badge { text: "Connected"; tone: Tone.success; dot: true; }
                            }
                            Text { text: "localhost:3306"; color: Theme.muted-foreground; font-size: Theme.size-small; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        VerticalLayout { alignment: center; Button { text: "Disconnect"; variant: ButtonVariant.ghost; } }
                    }
                }
                Card {
                    height: 190px;
                    EmptyState {
                        icon: Icons.play;
                        title: "No results yet";
                        message: "Write a statement and run it.";
                        Button { text: "Run SELECT 1"; variant: ButtonVariant.secondary; }
                    }
                }
            }
        }
    }
}
