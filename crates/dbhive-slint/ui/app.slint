import { HighlightLine, CompletionItem } from "components/sql_editor.slint";
import { ConnectionsScreen, ConnectionItem } from "screens/connections.slint";
import { WorkspaceScreen, TableItem } from "screens/workspace.slint";
import { GridColumn, GridRow } from "components/results_grid.slint";
import { AboutDialog } from "dialogs/about.slint";
import { ConfirmDialog } from "dialogs/confirm.slint";
import { ConnectionEditorDialog, ConnectionFormData } from "dialogs/connection_editor.slint";
import { HistoryState, HistoryOverlay } from "screens/history_panel.slint";
import { ImportExportState, ImportExportOverlay } from "screens/import_export_panel.slint";
import { BackupState, BackupOverlay } from "screens/backup_panel.slint";
import { ErdState, ErdOverlay } from "screens/er_diagram.slint";
import { DesignerState, DesignerOverlay } from "screens/schema_designer.slint";
import { PaletteDialog, PaletteItem } from "dialogs/command_palette.slint";
import { ShortcutsDialog, ShortcutItem } from "dialogs/shortcuts.slint";
import { SettingsDialog, SettingsData, ShortcutRowData } from "dialogs/settings.slint";
import { Palette } from "std-widgets.slint";

export { Theme, Icons, Tone, ConnectionItem, ConnectionFormData, TableItem, GridColumn, GridRow, TabInfo, CompletionItem }
export { PaletteItem, ShortcutItem }
export { SettingsData, ShortcutRowData, Palette }

// Table inspector (a table tab's Data and Structure views).
import { ClipboardSink } from "kit/kit.slint";
import { InspectorBridge, FilterRowItem, ColumnRowItem, IndexRowItem, RelationRowItem, ReviewItem } from "screens/table_inspector.slint";
export { InspectorBridge, FilterRowItem, ColumnRowItem, IndexRowItem, RelationRowItem, ReviewItem }

export { SqlEditorSpike } from "spikes/sql_editor_spike.slint";
export { GridSpike } from "spikes/grid_spike.slint";
export { DiagramSpike } from "spikes/diagram_spike.slint";
export { KitGallery } from "spikes/kit_gallery.slint";
export { HistoryState, PanelRow, RunParam, FormParam, PanelMode } from "screens/history_panel.slint";
export { ImportExportState, MappingRow } from "screens/import_export_panel.slint";
// The AI assistant is docked inside the workspace screen, so the window needs
// only the types the controller fills.
export { AiState, AiTurnRow, AiDisclosure } from "screens/ai_assistant.slint";
export { BackupState, BackupRow, BackupView } from "screens/backup_panel.slint";

// Activity monitor and schema migrations (panels over the app).
import { ActivityState, ActivityOverlay } from "screens/activity_monitor.slint";
import { MigrationsState, MigrationsOverlay } from "screens/migrations.slint";
export { ActivityState, MonitorTile, MonitorBar, MonitorFact, MonitorChip, MonitorChart, MonitorServerState } from "screens/activity_monitor.slint";
export { MigrationsState, MigrationDiffRow } from "screens/migrations.slint";
export { ChartLine } from "kit/kit.slint";

// Visual query builder and table create/edit dialogs: each is a state global
// plus an overlay, so this window gains no properties for them.
import { BuilderState, BuilderOverlay } from "screens/query_builder.slint";
import { TableDialogState, TableDialogOverlay } from "screens/table_dialog.slint";
export { BuilderState, QbSection, QbSource, QbAdded, QbJoin, QbColumn, QbFilter, QbHaving, QbOrder } from "screens/query_builder.slint";
export { TableDialogState, TdChip, TdColumn, TdUnique, TdForeignKey, TdEditRow, TdStatement } from "screens/table_dialog.slint";
export { ErdState } from "screens/er_diagram.slint";

// Plugin manager: a state global plus an overlay, like the panels above.
import { PluginsState, PluginsOverlay } from "screens/plugins_panel.slint";
export { PluginsState, PluginInstalledRow, PluginMarketItem, PluginFact, PluginPermissionItem, PluginItem, PluginToolbarItem } from "screens/plugins_panel.slint";
export { DesignerState, DesignerColumnRow, DesignerResultRow } from "screens/schema_designer.slint";

// Schema browser: a state global plus the overlays for its right-click menu
// and its drop-table confirmation, like the panels above.
import { TreeState, TreeContextOverlay, TreeDropOverlay, TreeCreateDbOverlay, TreeRoutinesOverlay } from "screens/schema_tree.slint";
export { TreeState, TreeStatus, TreeRoutine } from "screens/schema_tree.slint";
export { TreeNode, TreeRowKind, CtxItem } from "kit/kit.slint";

export enum Screen { connections, workspace }

export struct ToastItem {
    id: int,
    text: string,
    tone: Tone,
}

component Toast inherits Rectangle {
    in property <ToastItem> item;
    callback dismiss;

    property <color> fg: root.item.tone == Tone.success ? Theme.success
        : root.item.tone == Tone.danger ? Theme.destructive
        : Theme.primary;

    width: 360px;
    background: Theme.popover;
    border-radius: Theme.radius-card;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 16px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: #00000060;

    HorizontalLayout {
        padding: 10px;
        padding-left: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Icon {
                source: root.item.tone == Tone.success ? Icons.circle-check
                    : root.item.tone == Tone.danger ? Icons.triangle-alert
                    : Icons.info;
                tint: root.fg;
            }
        }
        Text {
            text: root.item.text;
            color: Theme.foreground;
            font-size: Theme.size-label;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        TouchArea {
            width: 16px;
            mouse-cursor: pointer;
            clicked => { root.dismiss(); }
            Icon { source: Icons.x; tint: Theme.dim-foreground; width: 13px; height: 13px; }
        }
    }
}

export component AppWindow inherits Window {
    title: "DB Hive";
    preferred-width: 1280px;
    preferred-height: 800px;
    min-width: 900px;
    min-height: 600px;
    background: Theme.background;

    in-out property <Screen> screen: Screen.connections;

    // Connections.
    in property <[ConnectionItem]> connections;
    in property <int> connection-total;
    in property <string> connection-error;
    in-out property <string> connection-search;
    callback connection-search-changed(string);
    callback connect(string);
    callback disconnect(string);
    callback edit-connection(string);
    callback duplicate-connection(string);
    callback toggle-favorite(string);
    callback delete-connection(string);
    callback dismiss-connection-error;

    // Workspace.
    in property <string> workspace-connection-name;
    in property <string> workspace-location-label;
    in property <[TableItem]> workspace-tables;
    in property <string> workspace-selected-table;
    in property <bool> workspace-loading-tables;
    in property <[TabInfo]> workspace-tabs;
    in property <int> workspace-active-tab: -1;
    in property <bool> workspace-active-is-query;
    in-out property <string> workspace-editor-text;
    in property <[HighlightLine]> workspace-editor-lines;
    in property <bool> workspace-running;
    in property <string> workspace-result-title;
    in property <string> workspace-result-summary;
    in property <string> workspace-result-message;
    in property <bool> workspace-has-result;
    in property <[CompletionItem]> workspace-completions;
    in property <int> workspace-completion-selected;
    in-out property <int> workspace-editor-pending-cursor: -1;
    in property <string> workspace-tables-error;
    in property <string> workspace-rows-error;
    in-out property <string> workspace-filter;
    in property <[GridColumn]> workspace-columns;
    in property <[GridRow]> workspace-rows;
    in property <length> workspace-grid-width;
    in property <int> workspace-row-count;
    in property <int> workspace-visible-row-count;
    callback workspace-back;
    callback workspace-refresh-tables;
    callback workspace-select-table(string);
    callback workspace-filter-changed(string);
    callback workspace-header-clicked(int);
    callback workspace-tab-selected(int);
    callback workspace-tab-closed(int);
    callback workspace-new-query;
    callback workspace-editor-edited(string);
    callback workspace-run-query;
    callback workspace-retry;
    callback workspace-cursor-moved(int);
    callback workspace-completion-move(int);
    callback workspace-completion-accept;
    callback workspace-completion-dismiss;
    callback workspace-completion-picked(int);

    // Puts text on the system clipboard (Slint has no call for it in Rust).
    public function copy-to-clipboard(text: string) {
        clipboard-sink.copy-text(text);
    }

    // Shell.
    in property <[ToastItem]> toasts;
    callback dismiss-toast(int);
    callback new-connection;
    callback open-settings;
    callback open-palette;
    callback toggle-theme;
    callback about;
    in property <string> app-version;

    // Commands. Every menu item, the palette and the key handler name a
    // command by its text id (dbhive-ui-model palette_session) and Rust runs it.
    callback run-command(string);
    // A key press nothing else handled: text, ctrl, alt, shift, meta. Returns
    // whether it was a shortcut and was run.
    callback key-chord(string, bool, bool, bool, bool) -> bool;

    // Command palette.
    in property <bool> show-palette: false;
    in-out property <string> palette-query;
    in property <[PaletteItem]> palette-rows;
    in-out property <length> palette-scroll;
    in property <length> palette-list-height;
    // Row heights come from Rust so the scroll maths and the drawing agree.
    in property <length> palette-row-height;
    in property <length> palette-header-height;
    callback palette-edited(string);
    callback palette-move(int);
    callback palette-run;
    callback palette-chosen(string);
    callback palette-hovered(int);
    callback palette-close;

    // Keyboard shortcuts help.
    in property <bool> show-shortcuts: false;
    in-out property <string> shortcuts-query;
    in property <[ShortcutItem]> shortcuts-rows;
    in property <string> shortcuts-platform;
    callback shortcuts-edited(string);
    callback shortcuts-close;

    // About dialog.
    in-out property <bool> show-about: false;

    // Settings dialog. `open-settings` (title-bar gear, File > Settings)
    // is handled in Rust, which fills `settings` and then shows it.
    in-out property <bool> show-settings: false;
    in property <SettingsData> settings;
    callback settings-section-selected(int);
    callback settings-language-selected(int);
    callback settings-startup-selected(int);
    callback settings-toggle-auto-save-connections;
    callback settings-toggle-auto-check-updates;
    callback settings-update-interval-changed(string);
    callback settings-toggle-auto-download;
    callback settings-toggle-auto-install;
    callback settings-theme-selected(int);
    callback settings-accent-preset-picked(int);
    callback settings-accent-text-changed(string);
    callback settings-font-size-changed(string);
    callback settings-font-family-changed(string);
    callback settings-toggle-line-numbers;
    callback settings-toggle-minimap;
    callback settings-toggle-word-wrap;
    callback settings-timeout-changed(string);
    callback settings-max-rows-changed(string);
    callback settings-toggle-confirm-destructive;
    callback settings-toggle-auto-save-history;
    callback settings-max-history-changed(string);
    callback settings-shortcut-record(int);
    callback settings-shortcut-clear(int);
    callback settings-shortcut-key(string, bool, bool, bool, bool);
    callback settings-dismiss-banner;
    callback settings-retry;
    callback settings-save;
    callback settings-discard;
    callback settings-reset;
    callback settings-close;

    // Confirmation dialog (currently only used for delete).
    in-out property <bool> show-confirm: false;
    in property <string> confirm-title;
    in property <string> confirm-message;
    in property <string> confirm-label: "Delete";
    callback confirm-accepted;
    callback confirm-cancelled;

    // Connection editor dialog.
    in-out property <bool> show-connection-editor: false;
    in property <bool> editor-is-new;
    in property <ConnectionFormData> editor;
    in property <[string]> editor-errors;
    in property <bool> editor-testing;
    in property <string> editor-test-message;
    in property <bool> editor-test-ok;
    in property <bool> editor-saving;
    callback editor-name-changed(string);
    callback editor-driver-selected(int);
    callback editor-host-changed(string);
    callback editor-port-changed(string);
    callback editor-username-changed(string);
    callback editor-password-changed(string);
    callback editor-toggle-password-visibility;
    callback editor-database-changed(string);
    callback editor-ssl-selected(int);
    callback editor-environment-selected(int);
    callback editor-description-changed(string);
    callback editor-toggle-favorite;
    callback editor-connection-string-changed(string);
    callback editor-apply-connection-string;
    callback editor-toggle-ssh;
    callback editor-ssh-host-changed(string);
    callback editor-ssh-port-changed(string);
    callback editor-ssh-username-changed(string);
    callback editor-ssh-auth-selected(int);
    callback editor-ssh-key-path-changed(string);
    callback editor-ssh-password-changed(string);
    callback editor-toggle-ssh-password-visibility;
    callback editor-color-picked(int);
    callback editor-test-connection;
    callback editor-save;
    callback editor-cancel;

    MenuBar {
        Menu {
            title: "File";
            MenuItem {
                title: "New Connection…";
                shortcut: @keys(Control + N);
                activated => { root.new-connection(); }
            }
            // No "New Window" item: the controller owns one window's state
            // and a second window would share it. The command stays in the
            // palette, greyed, with that reason.
            MenuSeparator { }
            MenuItem {
                title: "Settings…";
                shortcut: @keys(Control + Comma);
                activated => { root.open-settings(); }
            }
        }
        Menu {
            title: "View";
            MenuItem {
                title: "Connections";
                activated => { root.run-command("go-connections"); }
            }
            MenuItem {
                title: "Command Palette";
                shortcut: @keys(Control + K);
                activated => { root.open-palette(); }
            }
            MenuItem {
                title: "History and Snippets";
                shortcut: @keys(Control + Shift + H);
                activated => { HistoryState.open-requested(); }
            }
            MenuItem {
                title: "AI Assistant";
                enabled: root.screen == Screen.workspace;
                activated => { root.run-command("go-ai-assistant"); }
            }
            MenuItem {
                title: "Import and Export…";
                activated => { ImportExportState.open-requested(); }
            }
            MenuItem {
                title: "Backup and Restore…";
                activated => { BackupState.open-requested(); }
            }
            MenuItem {
                title: "Activity Monitor";
                activated => { root.run-command("go-activity-monitor"); }
            }
            MenuItem {
                title: "Schema Migrations…";
                activated => { root.run-command("go-migrations"); }
            }
            MenuItem {
                title: "Plugins…";
                activated => { root.run-command("go-plugins"); }
            }
            MenuItem {
                title: "Visual Query Builder";
                activated => { root.run-command("go-visual-query-builder"); }
            }
            MenuItem {
                title: "New Table…";
                activated => { root.run-command("new-table"); }
            }
            MenuItem {
                title: "ER Diagram";
                enabled: root.screen == Screen.workspace;
                activated => { root.run-command("go-er-diagram"); }
            }
            MenuItem {
                title: "Schema Designer";
                enabled: root.screen == Screen.workspace;
                activated => { root.run-command("go-schema-designer"); }
            }
            MenuSeparator { }
            MenuItem {
                title: Theme.dark ? "Light Theme" : "Dark Theme";
                activated => { root.toggle-theme(); }
            }
        }
        Menu {
            title: "Help";
            MenuItem {
                title: "Keyboard Shortcuts";
                activated => { root.run-command("show-shortcuts"); }
            }
            MenuSeparator { }
            MenuItem {
                title: "About DB Hive";
                activated => { root.run-command("go-about"); }
            }
        }
    }

    VerticalLayout {
        spacing: 0;

    // Global shortcuts. A key press goes to the focused element first (a text
    // field takes its own characters, so "?" typed into one never reaches
    // here) and bubbles up to this scope when nothing used it. Rust decides
    // whether it is a shortcut. The body below is deliberately not
    // re-indented so the diff stays small.
    // A Rectangle between the layout and the scope: a scope sized from the
    // layout inside it makes the window's size depend on itself.
    Rectangle {
    vertical-stretch: 1;
    fs := FocusScope {
    width: parent.width;
    height: parent.height;
    key-pressed(event) => {
        if (root.key-chord(event.text, event.modifiers.control, event.modifiers.alt, event.modifiers.shift, event.modifiers.meta)) {
            return accept;
        }
        return reject;
    }

    VerticalLayout {
        width: parent.width;
        height: parent.height;
        spacing: 0;

        // Top bar.
        Rectangle {
            height: 44px;
            background: Theme.sidebar;
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "DB Hive";
                        color: Theme.foreground;
                        font-size: Theme.size-body;
                        font-weight: 700;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    // Reads as a search field, because that is what it
                    // becomes once opened.
                    TouchArea {
                        width: 300px;
                        height: 28px;
                        mouse-cursor: pointer;
                        clicked => { root.open-palette(); }
                        Rectangle {
                            background: Theme.card;
                            border-radius: Theme.radius-control;
                            border-width: 1px;
                            border-color: parent.has-hover ? Theme.border-strong : Theme.border;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 8px;
                                VerticalLayout {
                                    alignment: center;
                                    Icon { source: Icons.search; tint: Theme.dim-foreground; width: 13px; height: 13px; }
                                }
                                Text {
                                    text: "Search or run commands…";
                                    color: Theme.dim-foreground;
                                    font-size: Theme.size-label;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "⌘K";
                                    color: Theme.dim-foreground;
                                    font-size: Theme.size-small;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout {
                    alignment: center;
                    Button {
                        has-icon: true;
                        icon: Theme.dark ? Icons.sun : Icons.moon;
                        variant: ButtonVariant.ghost;
                        clicked => { root.toggle-theme(); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Button {
                        has-icon: true;
                        icon: Icons.settings;
                        variant: ButtonVariant.ghost;
                        clicked => { root.open-settings(); }
                    }
                }
            }
            Divider { y: parent.height - 1px; }
        }

        if root.screen == Screen.connections: ConnectionsScreen {
            vertical-stretch: 1;
            items: root.connections;
            total: root.connection-total;
            error: root.connection-error;
            version: root.app-version;
            search <=> root.connection-search;
            search-changed(t) => { root.connection-search-changed(t); }
            new-connection => { root.new-connection(); }
            connect(id) => { root.connect(id); }
            disconnect(id) => { root.disconnect(id); }
            edit(id) => { root.edit-connection(id); }
            duplicate(id) => { root.duplicate-connection(id); }
            toggle-favorite(id) => { root.toggle-favorite(id); }
            delete(id) => { root.delete-connection(id); }
            dismiss-error => { root.dismiss-connection-error(); }
        }

        if root.screen == Screen.workspace: WorkspaceScreen {
            vertical-stretch: 1;
            connection-name: root.workspace-connection-name;
            location-label: root.workspace-location-label;
            tables: root.workspace-tables;
            selected-table: root.workspace-selected-table;
            loading-tables: root.workspace-loading-tables;
            tabs: root.workspace-tabs;
            active-tab: root.workspace-active-tab;
            active-is-query: root.workspace-active-is-query;
            editor-text <=> root.workspace-editor-text;
            editor-lines: root.workspace-editor-lines;
            running: root.workspace-running;
            result-title: root.workspace-result-title;
            result-summary: root.workspace-result-summary;
            result-message: root.workspace-result-message;
            has-result: root.workspace-has-result;
            completions: root.workspace-completions;
            completion-selected: root.workspace-completion-selected;
            editor-pending-cursor <=> root.workspace-editor-pending-cursor;
            tables-error: root.workspace-tables-error;
            rows-error: root.workspace-rows-error;
            filter <=> root.workspace-filter;
            columns: root.workspace-columns;
            rows: root.workspace-rows;
            grid-width: root.workspace-grid-width;
            row-count: root.workspace-row-count;
            visible-row-count: root.workspace-visible-row-count;
            back => { root.workspace-back(); }
            refresh-tables => { root.workspace-refresh-tables(); }
            select-table(name) => { root.workspace-select-table(name); }
            filter-changed(t) => { root.workspace-filter-changed(t); }
            header-clicked(i) => { root.workspace-header-clicked(i); }
            tab-selected(i) => { root.workspace-tab-selected(i); }
            tab-closed(i) => { root.workspace-tab-closed(i); }
            new-query => { root.workspace-new-query(); }
            editor-edited(t) => { root.workspace-editor-edited(t); }
            run-query => { root.workspace-run-query(); }
            retry => { root.workspace-retry(); }
            cursor-moved(o) => { root.workspace-cursor-moved(o); }
            completion-move(d) => { root.workspace-completion-move(d); }
            completion-accept => { root.workspace-completion-accept(); }
            completion-dismiss => { root.workspace-completion-dismiss(); }
            completion-picked(i) => { root.workspace-completion-picked(i); }
            open-history => { HistoryState.open-requested(); }
            open-activity => { root.run-command("go-activity-monitor"); }
            open-migrations => { root.run-command("go-migrations"); }
            open-diagram => { ErdState.open-requested(); }
        }
    }
    }
    }
    }

    // Keep the shortcut scope focused: at start, and whenever a dialog that
    // held focus goes away (its focused element is destroyed with it).
    property <bool> any-palette-overlay: root.show-palette || root.show-shortcuts;
    property <bool> any-overlay: root.show-about || root.show-confirm || root.show-connection-editor
        || root.any-palette-overlay || ActivityState.visible || MigrationsState.visible
        || BuilderState.visible || TableDialogState.visible || ErdState.visible
        || DesignerState.visible || PluginsState.visible
        || TreeState.menu-visible || TreeState.drop-visible
        || TreeState.create-db-visible || TreeState.routines-visible;
    init => { fs.focus(); }
    changed any-overlay => {
        if (!root.any-overlay) {
            fs.focus();
        }
    }

    // Never drawn; `copy-to-clipboard` fills it and copies.
    clipboard-sink := ClipboardSink { }

    // Toasts, bottom right, above everything.
    VerticalLayout {
        x: root.width - 380px;
        y: root.height - self.preferred-height - 16px;
        width: 360px;
        spacing: 8px;
        alignment: end;
        for t in root.toasts: Toast {
            item: t;
            dismiss => { root.dismiss-toast(t.id); }
        }
    }

    // History, snippets and templates. Below the dialogs, so a confirmation
    // raised from the panel (clear history, delete a snippet) shows above it.
    if HistoryState.visible: HistoryOverlay { }
    // Import / export and backup panels, same layer as history.
    if ImportExportState.visible: ImportExportOverlay { }
    if BackupState.visible: BackupOverlay { }
    if ActivityState.visible: ActivityOverlay { }
    if MigrationsState.visible: MigrationsOverlay { }
    if PluginsState.visible: PluginsOverlay { }

    // The schema browser's right-click menu and drop-table confirmation.
    if TreeState.menu-visible: TreeContextOverlay { }
    if TreeState.drop-visible: TreeDropOverlay { }
    if TreeState.create-db-visible: TreeCreateDbOverlay { }
    if TreeState.routines-visible: TreeRoutinesOverlay { }

    // The query builder and the table dialogs, on the same layer.
    if BuilderState.visible: BuilderOverlay { }
    if TableDialogState.visible: TableDialogOverlay { }

    // The diagram and the designer fill the window, like the history panel
    // they sit beside, and stay below the dialogs.
    if ErdState.visible: ErdOverlay { }
    if DesignerState.visible: DesignerOverlay { }

    if root.show-about || root.show-confirm || root.show-connection-editor || root.show-settings || root.any-palette-overlay: Rectangle {
        width: 100%;
        height: 100%;
        background: #000000a0;

        TouchArea {
            // Clicking the backdrop dismisses whichever dialog is open,
            // except the connection editor: it can hold typed work, so it
            // only closes through its own Cancel button.
            clicked => {
                root.show-about = false;
                root.show-confirm = false;
                if (root.show-palette) {
                    root.palette-close();
                }
                if (root.show-shortcuts) {
                    root.shortcuts-close();
                }
            }
        }

        if root.show-about: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                AboutDialog {
                    version: root.app-version;
                    close => { root.show-about = false; }
                }
            }
        }

        if root.show-settings: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                SettingsDialog {
                    available-height: root.height - 48px;
                    data: root.settings;
                    section-selected(i) => { root.settings-section-selected(i); }
                    language-selected(i) => { root.settings-language-selected(i); }
                    startup-selected(i) => { root.settings-startup-selected(i); }
                    toggle-auto-save-connections => { root.settings-toggle-auto-save-connections(); }
                    toggle-auto-check-updates => { root.settings-toggle-auto-check-updates(); }
                    update-interval-changed(t) => { root.settings-update-interval-changed(t); }
                    toggle-auto-download => { root.settings-toggle-auto-download(); }
                    toggle-auto-install => { root.settings-toggle-auto-install(); }
                    theme-selected(i) => { root.settings-theme-selected(i); }
                    accent-preset-picked(i) => { root.settings-accent-preset-picked(i); }
                    accent-text-changed(t) => { root.settings-accent-text-changed(t); }
                    font-size-changed(t) => { root.settings-font-size-changed(t); }
                    font-family-changed(t) => { root.settings-font-family-changed(t); }
                    toggle-line-numbers => { root.settings-toggle-line-numbers(); }
                    toggle-minimap => { root.settings-toggle-minimap(); }
                    toggle-word-wrap => { root.settings-toggle-word-wrap(); }
                    timeout-changed(t) => { root.settings-timeout-changed(t); }
                    max-rows-changed(t) => { root.settings-max-rows-changed(t); }
                    toggle-confirm-destructive => { root.settings-toggle-confirm-destructive(); }
                    toggle-auto-save-history => { root.settings-toggle-auto-save-history(); }
                    max-history-changed(t) => { root.settings-max-history-changed(t); }
                    shortcut-record(i) => { root.settings-shortcut-record(i); }
                    shortcut-clear(i) => { root.settings-shortcut-clear(i); }
                    shortcut-key(text, control, alt, shift, meta) => { root.settings-shortcut-key(text, control, alt, shift, meta); }
                    dismiss-banner => { root.settings-dismiss-banner(); }
                    retry => { root.settings-retry(); }
                    save => { root.settings-save(); }
                    discard => { root.settings-discard(); }
                    reset => { root.settings-reset(); }
                    // Rust decides: closing with unsaved edits asks first.
                    close => { root.settings-close(); }
                }
            }
        }

        // A confirmation raised from inside Settings (reset, discard) dims
        // the Settings dialog too, and keeps clicks off it.
        if root.show-confirm && root.show-settings: Rectangle {
            background: Theme.scrim;
            TouchArea { }
        }

        if root.show-confirm: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                ConfirmDialog {
                    title: root.confirm-title;
                    message: root.confirm-message;
                    confirm-label: root.confirm-label;
                    confirm => {
                        root.show-confirm = false;
                        root.confirm-accepted();
                    }
                    cancel => {
                        root.show-confirm = false;
                        root.confirm-cancelled();
                    }
                }
            }
        }

        if root.show-connection-editor: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                ConnectionEditorDialog {
                    available-height: root.height - 48px;
                    is-new: root.editor-is-new;
                    form: root.editor;
                    errors: root.editor-errors;
                    testing: root.editor-testing;
                    test-message: root.editor-test-message;
                    test-ok: root.editor-test-ok;
                    saving: root.editor-saving;
                    name-changed(t) => { root.editor-name-changed(t); }
                    driver-selected(i) => { root.editor-driver-selected(i); }
                    host-changed(t) => { root.editor-host-changed(t); }
                    port-changed(t) => { root.editor-port-changed(t); }
                    username-changed(t) => { root.editor-username-changed(t); }
                    password-changed(t) => { root.editor-password-changed(t); }
                    toggle-password-visibility => { root.editor-toggle-password-visibility(); }
                    database-changed(t) => { root.editor-database-changed(t); }
                    ssl-selected(i) => { root.editor-ssl-selected(i); }
                    environment-selected(i) => { root.editor-environment-selected(i); }
                    description-changed(t) => { root.editor-description-changed(t); }
                    toggle-favorite => { root.editor-toggle-favorite(); }
                    connection-string-changed(t) => { root.editor-connection-string-changed(t); }
                    apply-connection-string => { root.editor-apply-connection-string(); }
                    toggle-ssh => { root.editor-toggle-ssh(); }
                    ssh-host-changed(t) => { root.editor-ssh-host-changed(t); }
                    ssh-port-changed(t) => { root.editor-ssh-port-changed(t); }
                    ssh-username-changed(t) => { root.editor-ssh-username-changed(t); }
                    ssh-auth-selected(i) => { root.editor-ssh-auth-selected(i); }
                    ssh-key-path-changed(t) => { root.editor-ssh-key-path-changed(t); }
                    ssh-password-changed(t) => { root.editor-ssh-password-changed(t); }
                    toggle-ssh-password-visibility => { root.editor-toggle-ssh-password-visibility(); }
                    color-picked(i) => { root.editor-color-picked(i); }
                    test-connection => { root.editor-test-connection(); }
                    save => { root.editor-save(); }
                    cancel => {
                        root.show-connection-editor = false;
                        root.editor-cancel();
                    }
                }
            }
        }

        // Command palette, near the top like a launcher.
        if root.show-palette: VerticalLayout {
            padding-top: max(48px, root.height * 0.12);
            alignment: start;
            HorizontalLayout {
                alignment: center;
                PaletteDialog {
                    query <=> root.palette-query;
                    rows: root.palette-rows;
                    scroll <=> root.palette-scroll;
                    list-height: root.palette-list-height;
                    row-height: root.palette-row-height;
                    header-height: root.palette-header-height;
                    edited(t) => { root.palette-edited(t); }
                    move(delta) => { root.palette-move(delta); }
                    run => { root.palette-run(); }
                    chosen(id) => { root.palette-chosen(id); }
                    hovered(i) => { root.palette-hovered(i); }
                    close => { root.palette-close(); }
                }
            }
        }

        if root.show-shortcuts: VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                ShortcutsDialog {
                    query <=> root.shortcuts-query;
                    rows: root.shortcuts-rows;
                    platform: root.shortcuts-platform;
                    available-height: root.height - 64px;
                    edited(t) => { root.shortcuts-edited(t); }
                    close => { root.shortcuts-close(); }
                }
            }
        }
    }
}
